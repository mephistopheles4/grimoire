{
  "id": "csv-import",
  "title": "CSV import to address book",
  "blurb": "importContacts loads a CSV file from S3, parses it, loops over rows to save each contact, handles duplicate contacts by skipping them, and reports saved and skipped counts.",
  "env": {},
