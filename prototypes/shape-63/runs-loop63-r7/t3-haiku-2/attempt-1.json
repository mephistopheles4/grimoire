      "entry": "importContacts",
      "nodes": {
        "fetchUpload": {
          "R": [
            "the S3 client → a fixture directory · contacts.test.ts:9"
          ]
        },
        "saveContact": {
          "R": [
            "the contacts table → an in-memory list · contacts.test.ts:22"
          ]
        }
      }
    }
  },
  "sheet": {
    "scopeRule": "one entry point",
    "graphsNotDrawn": []
  },
  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:1",
      "params": [
        "uploadId"
      ],
      "channels": {
        "A": "an import result with saved and skipped counts",
        "E": [
          "NoUpload",
          "BadCsv"
        ],
        "R": [
          "the S3 client",
          "the contacts table"
        ]
      },
      "touches": [
        "src/import/contacts.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "import contacts from a CSV in S3"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {
            "id": "uploadId"
          },
          "bind": "bytes",
          "aside": "fetch the raw CSV data"
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {
            "bytes": "bytes"
          },
          "bind": "rows",
          "aside": "parse the CSV"
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "let",
          "label": "loop",
          "name": "row",
          "expr": "rows.shift()"
        },
        {
          "op": "if",
          "cond": "no row remains",
          "then": "done",
          "else": "save"
        },
        {
          "op": "call",
          "label": "save",
          "target": "saveContact",
          "args": {
            "row": "row"
          },
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "effect",
          "label": "done",
          "kind": "metrics.write",
          "desc": "log import metrics",
          "args": {
            "saved": "saved",
            "skipped": "skipped"
          }
        },
        {
          "op": "return",
          "expr": "{ saved, skipped }"
        }
      ]
    },
    "fetchUpload": {
      "name": "fetchUpload",
      "role": "io",
      "loc": "src/import/fetch.ts:1",
      "params": [
        "id"
      ],
      "channels": {
        "A": "raw bytes of the upload",
        "E": [
          "NoUpload"
        ],
        "R": [
          "the S3 client"
        ]
      },
      "touches": [
        "src/import/fetch.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.get",
          "desc": "fetch the upload from S3",
          "args": {
            "id": "id"
          },
          "bind": "data"
        },
        {
          "op": "if",
          "cond": "data is missing",
          "then": "notfound",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "data"
        },
        {
          "op": "throw",
          "label": "notfound",
          "tag": "NoUpload",
          "message": "upload not found in S3",
          "channel": "escape"
        }
      ]
    },
    "parseRows": {
      "name": "parseRows",
      "role": "pure",
      "loc": "src/import/parse.ts:1",
      "params": [
        "bytes"
      ],
      "channels": {
        "A": "array of row objects",
        "E": [
          "BadCsv"
        ],
        "R": []
      },
      "touches": [
        "src/import/parse.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "parse CSV bytes into rows"
        },
        {
          "op": "let",
          "name": "lines",
          "expr": "bytes.split('\\n')"
        },
        {
          "op": "if",
          "cond": "first line is not 'name,email,phone'",
          "then": "badheader",
          "else": "parsedata"
        },
        {
          "op": "return",
          "label": "parsedata",
          "expr": "lines.slice(1).map(line => ({ name, email, phone }))"
        },
        {
          "op": "throw",
          "label": "badheader",
          "tag": "BadCsv",
          "message": "invalid CSV header",
          "channel": "die"
        }
      ]
    },
    "saveContact": {
      "name": "saveContact",
      "role": "io",
      "loc": "src/contacts/save.ts:1",
      "params": [
        "row"
      ],
      "channels": {
        "A": "void",
        "E": [
          "Duplicate"
        ],
        "R": [
          "the contacts table"
        ]
      },
      "touches": [
        "src/contacts/save.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "normalise",
          "args": {
            "row": "row"
          },
          "bind": "cleaned",
          "aside": "normalise the row"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "insert the contact",
          "args": {
            "contact": "cleaned"
          }
        },
        {
          "op": "return",
          "expr": "undefined"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
      "role": "pure",
      "loc": "src/contacts/normalise.ts:1",
      "params": [
        "row"
      ],
      "channels": {
        "A": "cleaned contact object",
        "E": [],
        "R": []
      },
      "touches": [
        "src/contacts/normalise.ts"
      ],
      "enteredBy": [
        "src/contacts/normalise.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "clean and normalise contact data"
        },
        {
          "op": "return",
          "expr": "{ name: row.name.trim(), email: row.email.toLowerCase(), phone: row.phone }"
        }
      ]
    }
  },
