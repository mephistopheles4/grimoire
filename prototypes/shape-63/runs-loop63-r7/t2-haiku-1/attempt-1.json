          },
          "bind": "row"
        },
        {
          "op": "if",
          "cond": "row is missing",
          "then": "notfound",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "row"
        },
        {
          "op": "throw",
          "label": "notfound",
          "tag": "NoCart",
          "message": "cart not found",
          "channel": "escape"
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:5",
      "params": [
        "cart"
      ],
      "channels": {
        "A": "the total in pence",
        "E": [],
        "R": []
      },
      "touches": [
        "src/pricing.ts"
      ],
      "enteredBy": [
        "src/pricing.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "let",
          "label": "loop",
          "name": "item",
          "expr": "next item from cart.items"
        },
        {
          "op": "if",
          "cond": "item is null",
          "then": "done",
          "else": "add"
        },
        {
          "op": "let",
          "label": "add",
          "name": "total",
          "expr": "total + item.price"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "return",
          "label": "done",
          "expr": "total"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:12",
      "params": [
        "total"
      ],
      "channels": {
        "A": "the order id",
        "E": [
          "CardDeclined"
        ],
        "R": [
          "the Stripe client"
        ]
      },
      "touches": [
        "src/payments.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the card",
          "args": {
            "amount": "total"
          },
          "bind": "result"
        },
        {
          "op": "return",
          "expr": "result.orderId"
        }
      ]
    },
    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:8",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "a result message or order id",
        "E": [
          "NoCart"
        ],
        "R": [
          "the cart table",
          "the Stripe client"
        ]
      },
      "touches": [
        "src/checkout.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "call",
          "target": "loadCart",
          "args": {
            "cartId": "cartId"
          },
          "bind": "cart",
          "onError": [
            {
              "tag": "NoCart",
              "goto": "noload"
            }
          ]
        },
        {
          "op": "call",
          "target": "priceCart",
          "args": {
            "cart": "cart"
          },
          "bind": "total"
        },
        {
          "op": "if",
          "cond": "total == 0",
          "then": "empty",
          "else": "trycharge"
        },
        {
          "op": "call",
          "label": "trycharge",
          "target": "charge",
          "args": {
            "total": "total"
          },
          "bind": "orderId",
          "onError": [
            {
              "tag": "CardDeclined",
              "goto": "declined"
            }
          ]
        },
        {
          "op": "return",
          "expr": "orderId"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "notify customer of declined payment",
          "args": {
            "cartId": "cartId"
          }
        },
        {
          "op": "return",
          "expr": "\"payment declined\""
        },
        {
          "op": "return",
          "label": "noload",
          "expr": "\"cart not found\""
        }
      ]
    }
  },
