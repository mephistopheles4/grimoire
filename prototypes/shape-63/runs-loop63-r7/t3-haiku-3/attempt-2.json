{
  "id": "csv-import",
  "title": "CSV import of contacts",
  "blurb": "The import loads a CSV file into the address book. It fetches the file, parses the header, loops over the rows, and saves each one, handling duplicate key errors by skipping.",
  "env": {},
  "files": [
    {
      "path": "src/import/contacts.ts",
      "change": "edit",
      "why": "the entry point and the loop",
      "adds": 88,
      "dels": 12
    },
    {
      "path": "src/import/parse.ts",
      "change": "new",
      "why": "parses the CSV header and rows",
      "adds": 41,
      "dels": 0
    },
    {
      "path": "src/import/fetch.ts",
      "change": "new",
      "why": "fetches the upload from S3",
      "adds": 19,
      "dels": 0
    },
    {
      "path": "src/contacts/save.ts",
      "change": "edit",
      "why": "saves each contact to the database",
      "adds": 33,
      "dels": 7
    },
    {
      "path": "src/contacts/normalise.ts",
      "change": "edit",
      "why": "cleans the row data before saving",
      "adds": 14,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "entry": "importContacts",
      "nodes": {
        "fetchUpload": {
          "R": ["a fixture directory · contacts.test.ts:9"]
        },
        "saveContact": {
          "R": ["an in-memory list · contacts.test.ts:22"]
        }
      }
    }
  },
  "sheet": {
    "scopeRule": "one graph, one entry point",
    "graphsNotDrawn": []
  },
  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:1",
      "params": ["uploadId"],
      "channels": {
        "A": "a count of saved and skipped rows",
        "E": ["NoUpload", "BadCsv"],
        "R": []
      },
      "touches": ["src/import/contacts.ts"],
      "enteredBy": ["src/import/contacts.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "import a CSV file of contacts into the address book"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {"id": "uploadId"},
          "bind": "bytes"
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {"bytes": "bytes"},
          "bind": "rows"
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "let",
          "label": "loop",
          "name": "remaining",
          "expr": "rows"
        },
        {
          "op": "if",
          "cond": "remaining is empty",
          "then": "done-loop",
          "else": "process-row"
        },
        {
          "op": "let",
          "label": "process-row",
          "name": "row",
          "expr": "remaining[0]"
        },
        {
          "op": "call",
          "target": "saveContact",
          "args": {"row": "row"},
          "bind": "result",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "advance"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "let",
          "label": "advance",
          "name": "remaining",
          "expr": "remaining.slice(1)"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "effect",
          "label": "done-loop",
          "kind": "metrics.write",
          "desc": "record the import result"
        },
        {
          "op": "return",
          "expr": "{saved, skipped}"
        }
      ]
    },
    "fetchUpload": {
      "name": "fetchUpload",
      "role": "io",
      "loc": "src/import/fetch.ts:1",
      "params": ["id"],
      "channels": {
        "A": "the raw bytes of the upload",
        "E": ["NoUpload"],
        "R": ["the S3 client"]
      },
      "touches": ["src/import/fetch.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.get",
          "desc": "fetch the upload from S3",
          "args": {"id": "id"},
          "bind": "bytes"
        },
        {
          "op": "if",
          "cond": "bytes is missing",
          "then": "missing",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "bytes"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoUpload",
          "message": "upload not found in S3",
          "channel": "escape"
        }
      ]
    },
    "parseRows": {
      "name": "parseRows",
      "role": "pure",
      "loc": "src/import/parse.ts:1",
      "params": ["bytes"],
      "channels": {
        "A": "a list of parsed row objects",
        "E": ["BadCsv"],
        "R": []
      },
      "touches": ["src/import/parse.ts"],
      "enteredBy": ["src/import/contacts.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "lines",
          "expr": "bytes.split('\\n')"
        },
        {
          "op": "let",
          "name": "header",
          "expr": "lines[0]"
        },
        {
          "op": "if",
          "cond": "header is malformed",
          "then": "bad-header",
          "else": "parse-rows"
        },
        {
          "op": "let",
          "label": "parse-rows",
          "name": "rows",
          "expr": "lines.slice(1).map(parseRow)"
        },
        {
          "op": "return",
          "expr": "rows"
        },
        {
          "op": "throw",
          "label": "bad-header",
          "tag": "BadCsv",
          "message": "invalid or missing header",
          "channel": "die"
        }
      ]
    },
    "saveContact": {
      "name": "saveContact",
      "role": "io",
      "loc": "src/contacts/save.ts:1",
      "params": ["row"],
      "channels": {
        "A": "the saved contact",
        "E": ["Duplicate"],
        "R": ["the contacts table"]
      },
      "touches": ["src/contacts/save.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "normalise",
          "args": {"row": "row"},
          "bind": "cleaned"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "insert the contact",
          "args": {"contact": "cleaned"},
          "bind": "contact"
        },
        {
          "op": "return",
          "expr": "contact"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
      "role": "pure",
      "loc": "src/contacts/normalise.ts:1",
      "params": ["row"],
      "channels": {
        "A": "the cleaned row",
        "E": [],
        "R": []
      },
      "touches": ["src/contacts/normalise.ts"],
      "enteredBy": ["src/contacts/normalise.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "cleaned",
          "expr": "clean(row)"
        },
        {
          "op": "return",
          "expr": "cleaned"
        }
      ]
    }
  },
