{
  "id": "publish-post",
  "title": "Publish a blog post from a draft",
  "blurb": "Read a draft from storage, render markdown to HTML, and upload to S3. Handle markdown parsing errors with a plain-text fallback.",
  "env": {
    "region": "us-east-1"
  },
  "files": [
    {
      "path": "src/publish.ts",
      "change": "edit",
      "why": "publishes a draft with error handling and fallback",
      "adds": 40,
      "dels": 6
    },
    {
      "path": "src/render.ts",
      "change": "new",
      "why": "pure markdown to HTML renderer",
      "adds": 55,
      "dels": 0
    },
    {
      "path": "src/upload.ts",
      "change": "edit",
      "why": "uploads rendered HTML to S3",
      "adds": 18,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "nodes": {
        "uploadHtml": {
          "R": [
            "a fake bucket · publish.test.ts:31"
          ]
        }
      }
    }
  },
  "sheet": {
    "scopeRule": "one entry point: publishPost",
    "graphsNotDrawn": []
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:8",
      "params": [
        "draftId"
      ],
      "channels": {
        "A": "the published post URL",
        "E": [
          "EmptyDraft",
          "BadMarkdown"
        ],
        "R": [
          "the draft store"
        ]
      },
      "touches": [
        "src/publish.ts"
      ],
      "enteredBy": [
        "src/publish.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "Publish a blog post by rendering markdown and uploading to S3"
        },
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft from storage",
          "args": {
            "id": "draftId"
          },
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "draft is not empty",
          "then": "render",
          "else": "empty"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "EmptyDraft",
          "message": "cannot publish an empty draft",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "render",
          "target": "renderHtml",
          "args": {
            "markdown": "draft.body"
          },
          "bind": "html",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback"
            }
          ]
        },
        {
          "op": "goto",
          "to": "upload"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "<p>" + draft.title + ": " + draft.body + "</p>"
        },
        {
          "op": "call",
          "label": "upload",
          "target": "uploadHtml",
          "args": {
            "html": "html"
          },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:5",
      "params": [
        "markdown"
      ],
      "channels": {
        "A": "HTML string",
        "E": [
          "BadMarkdown"
        ],
        "R": []
      },
      "touches": [
        "src/render.ts"
      ],
      "enteredBy": [
        "src/publish.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "Render markdown content to HTML"
        },
        {
          "op": "if",
          "cond": "markdown is not empty",
          "then": "parse",
          "else": "empty"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": ""
        },
        {
          "op": "effect",
          "label": "parse",
          "kind": "parse.md",
          "desc": "parse markdown to HTML",
          "args": {
            "source": "markdown"
          },
          "bind": "html"
        },
        {
          "op": "return",
          "expr": "html"
        }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:12",
      "params": [
        "html"
      ],
      "channels": {
        "A": "the published post URL",
        "E": [],
        "R": [
          "the S3 client"
        ]
      },
      "touches": [
        "src/upload.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "note",
          "note": "Upload rendered HTML to S3"
        },
        {
          "op": "effect",
          "kind": "s3.put",
          "desc": "upload HTML to S3",
          "args": {
            "body": "html"
          },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    }
  },
  "graphs": [
