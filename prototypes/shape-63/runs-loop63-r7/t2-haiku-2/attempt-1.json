    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:1",
      "params": ["cartId"],
      "channels": {
        "A": "order id, payment declined notice, or nothing to buy",
        "E": ["NoCart", "CardDeclined"],
        "R": []
      },
      "touches": ["src/checkout.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        {
          "op": "call",
          "target": "loadCart",
          "args": {
            "cartId": "cartId"
          },
          "bind": "cart",
          "aside": "load the cart"
        },
        {
          "op": "call",
          "target": "priceCart",
          "args": {
            "cart": "cart"
          },
          "bind": "total",
          "aside": "price the items"
        },
        {
          "op": "if",
          "cond": "total is zero",
          "then": "empty",
          "else": "pay"
        },
        {
          "op": "call",
          "label": "pay",
          "target": "charge",
          "args": {
            "total": "total"
          },
          "bind": "orderId",
          "onError": [
            {
              "tag": "CardDeclined",
              "goto": "declined"
            }
          ]
        },
        {
          "op": "return",
          "expr": "orderId"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "notify the customer of the decline"
        },
        {
          "op": "return",
          "expr": "\"payment declined\""
        }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:3",
      "params": ["cartId"],
      "channels": {
        "A": "cart object",
        "E": ["NoCart"],
        "R": ["the cart table"]
      },
      "touches": ["src/cart-store.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the cart row",
          "args": {
            "cartId": "cartId"
          },
          "bind": "row"
        },
        {
          "op": "if",
          "cond": "row is missing",
          "then": "missing",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "row"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoCart",
          "message": "no row for that cartId",
          "channel": "escape"
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:1",
      "params": ["cart"],
      "channels": {
        "A": "total in pence",
        "E": [],
        "R": []
      },
      "touches": ["src/pricing.ts"],
      "enteredBy": ["src/pricing.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "i",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "more",
          "cond": "i < cart.items.length",
          "then": "add",
          "else": "done"
        },
        {
          "op": "let",
          "label": "add",
          "name": "total",
          "expr": "total + cart.items[i].price"
        },
        {
          "op": "let",
          "name": "i",
          "expr": "i + 1"
        },
        {
          "op": "goto",
          "to": "more"
        },
        {
          "op": "return",
          "label": "done",
          "expr": "total"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:5",
      "params": ["total"],
      "channels": {
        "A": "order id",
        "E": ["CardDeclined"],
        "R": ["the Stripe client"]
      },
      "touches": ["src/payments.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the card",
          "args": {
            "total": "total"
          },
          "bind": "result"
        },
        {
          "op": "return",
          "expr": "result.orderId"
        }
      ]
    }
  },
