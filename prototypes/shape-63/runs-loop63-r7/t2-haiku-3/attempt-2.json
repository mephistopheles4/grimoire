      "loc": "src/checkout.ts:10",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "order id or a message",
        "E": [
          "CardDeclined"
        ],
        "R": [
          "the Stripe client"
        ]
      },
      "touches": [
        "src/checkout.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "turn a cart into an order by loading it, pricing it, and charging the card"
        },
        {
          "op": "call",
          "target": "loadCart",
          "args": {
            "cartId": "cartId"
          },
          "bind": "cart"
        },
        {
          "op": "call",
          "target": "priceCart",
          "args": {
            "cart": "cart"
          },
          "bind": "total"
        },
        {
          "op": "if",
          "cond": "total is 0",
          "then": "empty",
          "else": "charge-card"
        },
        {
          "op": "let",
          "label": "empty",
          "name": "result",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "goto",
          "to": "return-result"
        },
        {
          "op": "call",
          "label": "charge-card",
          "target": "charge",
          "args": {
            "total": "total"
          },
          "bind": "orderId",
          "onError": [
            {
              "tag": "CardDeclined",
              "goto": "declined"
            }
          ]
        },
        {
          "op": "let",
          "name": "result",
          "expr": "orderId"
        },
        {
          "op": "goto",
          "to": "return-result"
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "notify the customer their card was declined",
          "args": {
            "cartId": "cartId"
          }
        },
        {
          "op": "let",
          "name": "result",
          "expr": "\"payment declined\""
        },
        {
          "op": "return",
          "label": "return-result",
          "expr": "result"
        }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:3",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "a cart object",
        "E": [
          "NoCart"
        ],
        "R": [
          "the cart table"
        ]
      },
      "touches": [
        "src/cart-store.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the cart row",
          "args": {
            "id": "cartId"
          },
          "bind": "row"
        },
        {
          "op": "if",
          "cond": "row is missing",
          "then": "missing",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "row"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoCart",
          "message": "no cart for that id",
          "channel": "escape"
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:5",
      "params": [
        "cart"
      ],
      "channels": {
        "A": "total in pence",
        "E": [],
        "R": []
      },
      "touches": [
        "src/pricing.ts"
      ],
      "enteredBy": [
        "src/pricing.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "index",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loop-check",
          "cond": "index < cart.items.length",
          "then": "loop-body",
          "else": "loop-end"
        },
        {
          "op": "let",
          "label": "loop-body",
          "name": "item",
          "expr": "cart.items[index]"
        },
        {
          "op": "let",
          "name": "total",
          "expr": "total + (item.price * item.quantity)"
        },
        {
          "op": "let",
          "name": "index",
          "expr": "index + 1"
        },
        {
          "op": "goto",
          "to": "loop-check"
        },
        {
          "op": "return",
          "label": "loop-end",
          "expr": "total"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:8",
      "params": [
        "total"
      ],
      "channels": {
        "A": "order id",
        "E": [
          "CardDeclined"
        ],
        "R": [
          "the Stripe client"
        ]
      },
      "touches": [
        "src/payments.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the card",
          "args": {
            "amount": "total"
          },
          "bind": "response"
        },
        {
          "op": "return",
          "expr": "response.orderId"
        }
      ]
    }
  },
