  "nodes": {
    "renderCatalog": {
      "name": "renderCatalog",
      "role": "handler",
      "loc": "src/catalog/render.ts:1",
      "params": [
        "pageId"
      ],
      "channels": {
        "A": "HTML for the catalogue grid",
        "E": [
          "NoPage"
        ],
        "R": [
          "the products table"
        ]
      },
      "touches": [
        "src/catalog/render.ts"
      ],
      "enteredBy": [
        "src/catalog/render.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "render the catalogue page by loading products and formatting their prices"
        },
        {
          "op": "effect",
          "kind": "db.query",
          "desc": "load the page's products",
          "args": {
            "pageId": "pageId"
          },
          "bind": "products"
        },
        {
          "op": "let",
          "label": "loop",
          "name": "rows",
          "expr": "[]"
        },
        {
          "op": "if",
          "cond": "products is empty",
          "then": "done",
          "else": "next-product"
        },
        {
          "op": "let",
          "label": "next-product",
          "name": "product",
          "expr": "products.shift()"
        },
        {
          "op": "call",
          "target": "formatPrice",
          "args": {
            "pence": "product.price"
          },
          "bind": "priceStr"
        },
        {
          "op": "let",
          "name": "row",
          "expr": "{ name: product.name, price: priceStr }"
        },
        {
          "op": "let",
          "name": "rows",
          "expr": "rows.concat(row)"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "call",
          "label": "done",
          "target": "renderGrid",
          "args": {
            "rows": "rows"
          },
          "bind": "html"
        },
        {
          "op": "return",
          "expr": "html"
        }
      ]
    },
    "applyFilters": {
      "name": "applyFilters",
      "role": "handler",
      "loc": "src/filters/apply.ts:1",
      "params": [
        "query"
      ],
      "channels": {
        "A": "the number of rows written to the page",
        "E": [
          "BadQuery",
          "Timeout"
        ],
        "R": [
          "the search API"
        ]
      },
      "touches": [
        "src/filters/apply.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "note",
          "note": "re-apply filters without a reload by parsing the query and fetching matching products"
        },
        {
          "op": "call",
          "target": "parseQuery",
          "args": {
            "query": "query"
          },
          "bind": "filters"
        },
        {
          "op": "effect",
          "kind": "api.get",
          "desc": "fetch the matching products",
          "args": {
            "filters": "filters"
          },
          "bind": "matches",
          "onError": [
            {
              "tag": "Timeout",
              "goto": "stale"
            }
          ]
        },
        {
          "op": "let",
          "label": "loop",
          "name": "rows",
          "expr": "[]"
        },
        {
          "op": "if",
          "cond": "matches is empty",
          "then": "patch",
          "else": "next-match"
        },
        {
          "op": "let",
          "label": "next-match",
          "name": "product",
          "expr": "matches.shift()"
        },
        {
          "op": "call",
          "target": "formatPrice",
          "args": {
            "pence": "product.price"
          },
          "bind": "priceStr"
        },
        {
          "op": "let",
          "name": "row",
          "expr": "{ name: product.name, price: priceStr }"
        },
        {
          "op": "let",
          "name": "rows",
          "expr": "rows.concat(row)"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "effect",
          "label": "patch",
          "kind": "dom.patch",
          "desc": "write the rows into the page",
          "args": {
            "rows": "rows"
          }
        },
        {
          "op": "return",
          "expr": "rows.length"
        },
        {
          "op": "return",
          "label": "stale",
          "expr": "\"kept the stale rows\""
        }
      ]
    },
    "formatPrice": {
      "name": "formatPrice",
      "role": "pure",
      "loc": "src/money/format.ts:1",
      "params": [
        "pence"
      ],
      "channels": {
        "A": "formatted price string like £12.50",
        "E": [],
        "R": []
      },
      "touches": [
        "src/money/format.ts"
      ],
      "enteredBy": [
        "src/money/format.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "pounds",
          "expr": "Math.floor(pence / 100)"
        },
        {
          "op": "let",
          "name": "pennies",
          "expr": "pence % 100"
        },
        {
          "op": "let",
          "name": "formatted",
          "expr": "currencySymbol + pounds + '.' + (pennies < 10 ? '0' : '') + pennies"
        },
        {
          "op": "return",
          "expr": "formatted"
        }
      ]
    },
    "renderGrid": {
      "name": "renderGrid",
      "role": "pure",
      "loc": "src/catalog/grid.ts:1",
      "params": [
        "rows"
      ],
      "channels": {
        "A": "HTML markup for the grid",
        "E": [],
        "R": []
      },
      "touches": [
        "src/catalog/grid.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "return",
          "expr": "rows.map(r => `<div class='product'><span>${r.name}</span><span>${r.price}</span></div>`).join('')"
        }
      ]
    },
    "parseQuery": {
      "name": "parseQuery",
      "role": "pure",
      "loc": "src/filters/parse.ts:1",
      "params": [
        "query"
      ],
      "channels": {
        "A": "the filter object",
        "E": [
          "BadQuery"
        ],
        "R": []
      },
      "touches": [
        "src/filters/parse.ts"
      ],
      "enteredBy": [
        "src/filters/parse.test.ts"
      ],
      "steps": [
        {
          "op": "if",
          "cond": "query parses correctly",
          "then": "success",
          "else": "fail"
        },
        {
          "op": "let",
          "label": "success",
          "name": "filters",
          "expr": "queryToFilters(query)"
        },
        {
          "op": "return",
          "expr": "filters"
        },
        {
          "op": "throw",
          "label": "fail",
          "tag": "BadQuery",
          "message": "query could not be parsed",
          "channel": "die"
        }
      ]
    }
