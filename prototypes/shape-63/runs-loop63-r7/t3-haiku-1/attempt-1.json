              {"k": "let", "at": 5, "next": 6},
              {"k": "if", "at": 6, "next": 13},
              {"k": "effect", "at": 13, "kind": "metrics.write", "desc": "record import statistics", "next": 14},
              {"k": "return", "at": 14, "value": {"saved": 1, "skipped": 1}},
              {"k": "done", "result": {"saved": 1, "skipped": 1}}
            ]
          }
        },
        {
          "name": "a bad header",
          "blurb": "CSV has wrong header format, parseRows throws BadCsv on die channel, nothing catches it.",
          "input": {"uploadId": "upload-bad"},
          "walk": {
            "provenance": "authored",
            "steps": [
              {"k": "note", "at": 0, "next": 1},
              {"k": "call", "at": 1, "to": "fetchUpload", "next": 2},
              {"k": "effect", "at": 0, "kind": "s3.get", "desc": "fetch the upload object", "next": 1, "result": "name,email\nAlice,alice@example.com"},
              {"k": "if", "at": 1, "next": 2},
              {"k": "call", "at": 2, "to": "parseRows", "next": 3},
              {"k": "let", "at": 0, "next": 1},
              {"k": "let", "at": 1, "next": 2},
              {"k": "if", "at": 2, "next": 3},
