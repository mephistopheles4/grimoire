              {"k": "effect", "at": 1, "kind": "db.insert", "desc": "insert the contact", "next": 2},
              {"k": "return", "at": 2, "value": {"id": "c-1", "contact": {"name": "Alice", "email": "alice@example.com", "phone": "5551234"}}},
              {"k": "let", "at": 8, "next": 9},
