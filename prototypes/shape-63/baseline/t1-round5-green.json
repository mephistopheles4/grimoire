{
  "id": "publish-post-retry",
  "title": "The retry pattern in a blog publish flow",
  "blurb": "A draft is read and rendered to HTML, then uploaded to S3 with a retry on failure. When markdown rendering fails, a fallback plain-text version is used instead.",
  "entry": "publishPost",
  "env": {},
  "files": [
    {
      "path": "src/publish.ts",
      "change": "edit",
      "why": "holds publishPost and its orchestration logic",
      "adds": 40,
      "dels": 6
    },
    {
      "path": "src/render.ts",
      "change": "new",
      "why": "holds renderHtml which converts markdown to HTML",
      "adds": 55,
      "dels": 0
    },
    {
      "path": "src/upload.ts",
      "change": "edit",
      "why": "holds uploadHtml which puts the HTML to S3",
      "adds": 18,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "entry": "publishPost",
      "nodes": {
        "uploadHtml": {
          "R": [
            "the S3 client → a fake bucket · publish.test.ts:31"
          ]
        }
      }
    }
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:8",
      "params": [
        "draftId"
      ],
      "channels": {
        "A": "the published URL",
        "E": [
          "EmptyDraft"
        ],
        "R": [
          "the draft store"
        ]
      },
      "touches": [
        "src/publish.ts"
      ],
      "enteredBy": [
        "src/publish.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "publish a blog post by reading, rendering, and uploading its HTML"
        },
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft from the store",
          "args": {
            "id": "draftId"
          },
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "draft is empty",
          "then": "empty",
          "else": "render"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "EmptyDraft",
          "message": "the draft is empty",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "render",
          "target": "renderHtml",
          "args": {
            "draft": "draft"
          },
          "bind": "html",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback"
            }
          ]
        },
        {
          "op": "call",
          "label": "send",
          "target": "uploadHtml",
          "args": {
            "html": "html"
          },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "\"<p>\" + draft.body + \"</p>\""
        },
        {
          "op": "goto",
          "to": "send"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:3",
      "params": [
        "draft"
      ],
      "channels": {
        "A": "the HTML string",
        "E": [
          "BadMarkdown"
        ],
        "R": []
      },
      "touches": [
        "src/render.ts"
      ],
      "enteredBy": [
        "src/publish.test.ts"
      ],
      "steps": [
        {
          "op": "if",
          "cond": "draft.body is empty",
          "then": "empty",
          "else": "parse"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "\"\""
        },
        {
          "op": "if",
          "label": "parse",
          "cond": "draft.body is valid markdown",
          "then": "valid",
          "else": "bad"
        },
        {
          "op": "return",
          "label": "valid",
          "expr": "render markdown to HTML"
        },
        {
          "op": "throw",
          "label": "bad",
          "tag": "BadMarkdown",
          "message": "the markdown is invalid",
          "channel": "die"
        }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:3",
      "params": [
        "html"
      ],
      "channels": {
        "A": "the uploaded URL",
        "E": [],
        "R": [
          "the S3 client"
        ]
      },
      "touches": [
        "src/upload.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.put",
          "desc": "upload the HTML to S3",
          "args": {
            "body": "html"
          },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    }
  },
