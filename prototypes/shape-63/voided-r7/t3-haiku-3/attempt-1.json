  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:1",
      "params": [
        "uploadId"
      ],
      "channels": {
        "A": "import result with saved and skipped counts",
        "E": [],
        "R": []
      },
      "touches": [
        "src/import/contacts.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "import CSV contacts: fetch, parse, loop saving each row"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {
            "id": "uploadId"
          },
          "bind": "bytes"
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {
            "data": "bytes"
          },
          "bind": "rows"
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loop-top",
          "cond": "rows.length > 0",
          "then": "process-row",
          "else": "write-metrics"
        },
        {
          "op": "call",
          "label": "process-row",
          "target": "saveContact",
          "args": {
            "row": "rows[0]"
          },
          "bind": "result",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip-row"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "advance"
        },
        {
          "op": "let",
          "label": "skip-row",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "let",
          "label": "advance",
          "name": "rows",
          "expr": "rows.slice(1)"
        },
        {
          "op": "goto",
          "to": "loop-top"
        },
        {
          "op": "effect",
          "label": "write-metrics",
          "kind": "metrics.write",
          "desc": "write import metrics",
          "args": {
            "saved": "saved",
            "skipped": "skipped"
          }
        },
        {
          "op": "return",
          "expr": "{ saved, skipped }"
        }
      ]
    },
    "fetchUpload": {
      "name": "fetchUpload",
      "role": "io",
      "loc": "src/import/fetch.ts:1",
      "params": [
        "id"
      ],
      "channels": {
        "A": "raw bytes",
        "E": [
          "NoUpload"
        ],
        "R": [
          "the S3 client"
        ]
      },
      "touches": [
        "src/import/fetch.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.get",
          "desc": "fetch the upload from S3",
          "args": {
            "id": "id"
          },
          "bind": "bytes"
        },
        {
          "op": "return",
          "expr": "bytes"
        }
      ]
    },
    "parseRows": {
      "name": "parseRows",
      "role": "pure",
      "loc": "src/import/parse.ts:1",
      "params": [
        "bytes"
      ],
      "channels": {
        "A": "array of rows",
        "E": [
          "BadCsv"
        ],
        "R": []
      },
      "touches": [
        "src/import/parse.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "lines",
          "expr": "bytes.split('\\n')"
        },
        {
          "op": "if",
          "cond": "header matches expected format",
          "then": "parse-ok",
          "else": "bad-header"
        },
        {
          "op": "let",
          "label": "parse-ok",
          "name": "rows",
          "expr": "lines.slice(1).map(line => parseLine(line))"
        },
        {
          "op": "return",
          "expr": "rows"
        },
        {
          "op": "throw",
          "label": "bad-header",
          "tag": "BadCsv",
          "message": "header line is wrong",
          "channel": "die"
        }
      ]
    },
    "saveContact": {
      "name": "saveContact",
      "role": "io",
      "loc": "src/contacts/save.ts:1",
      "params": [
        "row"
      ],
      "channels": {
        "A": "",
        "E": [
          "Duplicate"
        ],
        "R": [
          "the contacts table"
        ]
      },
      "touches": [
        "src/contacts/save.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "normalise",
          "args": {
            "row": "row"
          },
          "bind": "cleaned"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "save the contact",
          "args": {
            "data": "cleaned"
          }
        },
        {
          "op": "return",
          "expr": "true"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
      "role": "pure",
      "loc": "src/contacts/normalise.ts:1",
      "params": [
        "row"
      ],
      "channels": {
        "A": "cleaned row",
        "E": [],
        "R": []
      },
      "touches": [
        "src/contacts/normalise.ts"
      ],
      "enteredBy": [
        "src/contacts/normalise.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "cleaned",
          "expr": "{ name: row.name.trim(), email: row.email.toLowerCase() }"
        },
        {
          "op": "return",
          "expr": "cleaned"
        }
      ]
    }
  },
