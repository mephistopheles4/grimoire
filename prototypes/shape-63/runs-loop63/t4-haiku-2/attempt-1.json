  "nodes": {
    "renderCatalog": {
      "name": "renderCatalog",
      "role": "handler",
      "loc": "src/catalog/render.ts:5",
      "params": [
        "pageId"
      ],
      "channels": {
        "A": "the rendered grid HTML",
        "E": [
          "NoPage"
        ],
        "R": [
          "the products table"
        ]
      },
      "touches": [
        "src/catalog/render.ts"
      ],
      "enteredBy": [
        "src/catalog/render.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "load and format products for the catalogue page"
        },
        {
          "op": "effect",
          "kind": "db.query",
          "desc": "load the page's products",
          "args": {
            "pageId": "pageId"
          },
          "bind": "products",
          "onError": [
            {
              "tag": "NoPage",
              "goto": "missing"
            }
          ]
        },
        {
          "op": "let",
          "label": "loop",
          "name": "rows",
          "expr": "[]"
        },
        {
          "op": "if",
          "cond": "products is empty",
          "then": "render",
          "else": "format"
        },
        {
          "op": "call",
          "label": "format",
          "target": "formatPrice",
          "args": {
            "pence": "products[0].price"
          },
          "bind": "formatted"
        },
        {
          "op": "let",
          "name": "row",
          "expr": "{ name: products[0].name, price: formatted }"
        },
        {
          "op": "let",
          "name": "rows",
          "expr": "rows.concat([row])"
        },
        {
          "op": "let",
          "name": "products",
          "expr": "products.slice(1)"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "call",
          "label": "render",
          "target": "renderGrid",
          "args": {
            "rows": "rows"
          },
          "bind": "html"
        },
        {
          "op": "return",
          "expr": "html"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoPage",
          "message": "page not found",
          "channel": "escape"
        }
      ]
    },
    "applyFilters": {
      "name": "applyFilters",
      "role": "handler",
      "loc": "src/filters/apply.ts:8",
      "params": [
        "query"
      ],
      "channels": {
        "A": "number of rows written",
        "E": [
          "BadQuery",
          "Timeout"
        ],
        "R": [
          "the search API"
        ]
      },
      "touches": [
        "src/filters/apply.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "note",
          "note": "apply filters and update the page, handling stale API responses"
        },
        {
          "op": "call",
