    {
      "path": "src/catalog/render.ts",
      "change": "edit",
      "why": "the renderCatalog entry point that loads products and formats prices",
      "adds": 47,
      "dels": 8
    },
    {
      "path": "src/catalog/grid.ts",
      "change": "new",
      "why": "the renderGrid node that builds the product grid HTML",
      "adds": 31,
      "dels": 0
    },
    {
      "path": "src/filters/apply.ts",
      "change": "edit",
      "why": "the applyFilters entry point that re-applies filters and formats prices",
      "adds": 52,
      "dels": 15
    },
    {
      "path": "src/filters/parse.ts",
      "change": "new",
      "why": "the parseQuery node that parses the filter query string",
      "adds": 24,
      "dels": 0
    },
    {
      "path": "src/money/format.ts",
      "change": "new",
      "why": "the formatPrice node shared by both entry points",
      "adds": 18,
      "dels": 0
    }
  ],
