      "steps": [
        {
          "op": "let",
          "name": "pounds",
          "expr": "pence / 100"
        },
        {
          "op": "return",
          "expr": "\"£\" + pounds.toFixed(2)"
        }
      ]
    },
    "renderGrid": {
      "name": "renderGrid",
      "role": "pure",
      "loc": "src/catalog/grid.ts:1",
      "params": [
