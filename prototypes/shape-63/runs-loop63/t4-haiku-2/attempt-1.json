      "steps": [
        {
          "op": "let",
          "name": "html",
          "expr": "buildGrid(rows)"
        },
        {
          "op": "return",
          "expr": "html"
        }
      ]
    },
    "parseQuery": {
      "name": "parseQuery",
      "role": "pure",
      "loc": "src/filters/parse.ts:3",
      "params": [
        "query"
      ],
      "channels": {
        "A": "the filter object",
        "E": [
          "BadQuery"
        ],
        "R": []
      },
      "touches": [
        "src/filters/parse.ts"
      ],
      "enteredBy": [
        "src/filters/parse.test.ts"
      ],
      "steps": [
        {
          "op": "if",
          "cond": "query parses",
          "then": "parsed",
          "else": "bad"
        },
        {
          "op": "let",
          "label": "parsed",
          "name": "filters",
          "expr": "parseQueryString(query)"
        },
        {
          "op": "return",
          "expr": "filters"
        },
        {
          "op": "throw",
          "label": "bad",
          "tag": "BadQuery",
          "message": "query string is invalid",
          "channel": "die"
        }
      ]
    }
