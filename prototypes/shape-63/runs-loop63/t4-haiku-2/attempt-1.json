          },
          "bind": "matches",
          "onError": [
            {
              "tag": "Timeout",
              "goto": "stale"
            }
          ]
        },
        {
          "op": "let",
          "label": "loop",
          "name": "rows",
          "expr": "[]"
        },
        {
          "op": "if",
          "cond": "matches is empty",
          "then": "patch",
          "else": "format"
        },
        {
          "op": "call",
          "label": "format",
          "target": "formatPrice",
          "args": {
            "pence": "matches[0].price"
          },
          "bind": "formatted"
        },
        {
          "op": "let",
          "name": "row",
          "expr": "{ name: matches[0].name, price: formatted }"
        },
        {
          "op": "let",
          "name": "rows",
          "expr": "rows.concat([row])"
        },
        {
          "op": "let",
          "name": "matches",
          "expr": "matches.slice(1)"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "effect",
          "label": "patch",
          "kind": "dom.patch",
          "desc": "write rows into the page",
          "args": {
            "rows": "rows"
          }
        },
        {
          "op": "return",
          "expr": "rows.length"
        },
        {
          "op": "return",
          "label": "stale",
          "expr": "\"kept the stale rows\""
        }
      ]
    },
    "formatPrice": {
      "name": "formatPrice",
      "role": "pure",
      "loc": "src/money/format.ts:2",
      "params": [
        "pence"
      ],
      "channels": {
        "A": "price as a display string",
        "E": [],
        "R": []
      },
      "touches": [
        "src/money/format.ts"
      ],
      "enteredBy": [
        "src/money/format.test.ts"
