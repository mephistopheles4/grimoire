{
  "id": "import-contacts",
  "title": "CSV contact import",
  "blurb": "Load a CSV file of contacts into the address book. Fetches from S3, parses, normalises each row, and saves to the database. Handles duplicate entries in the loop.",
  "entry": "importContacts",
  "env": {
    "uploadId": "upload-123"
  },
  "files": [
    {
      "path": "src/import/contacts.ts",
      "change": "edit",
      "why": "holds importContacts, the entry point",
      "adds": 88,
      "dels": 12
    },
    {
      "path": "src/import/parse.ts",
      "change": "new",
      "why": "holds parseRows, which parses CSV",
      "adds": 41,
      "dels": 0
    },
    {
      "path": "src/import/fetch.ts",
      "change": "new",
      "why": "holds fetchUpload, which retrieves from S3",
      "adds": 19,
      "dels": 0
    },
    {
      "path": "src/contacts/save.ts",
      "change": "edit",
      "why": "holds saveContact, which inserts rows",
      "adds": 33,
      "dels": 7
    },
    {
      "path": "src/contacts/normalise.ts",
      "change": "edit",
      "why": "holds normalise, which cleans row data",
      "adds": 14,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "entry": "importContacts",
      "nodes": {
        "fetchUpload": {
          "R": [
            "the S3 client → a fixture directory · contacts.test.ts:9"
          ]
        },
        "saveContact": {
          "R": [
            "the contacts table → an in-memory list · contacts.test.ts:22"
          ]
        }
      }
    }
  },
  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:5",
      "params": [
        "uploadId"
      ],
      "channels": {
        "A": "a count of saved and skipped rows",
        "E": [
          "NoUpload",
          "BadCsv"
        ],
        "R": [
          "the S3 client",
          "the contacts table"
        ]
      },
      "touches": [
        "src/import/contacts.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "load a CSV of contacts into the address book"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {
            "id": "uploadId"
          },
          "bind": "bytes",
          "aside": "fetch the CSV file from S3",
          "onError": [
            {
              "tag": "NoUpload",
              "goto": "no-upload"
            }
          ]
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {
            "data": "bytes"
          },
          "bind": "rows",
          "aside": "parse the CSV into rows"
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loop",
          "cond": "rows has items",
          "then": "body",
          "else": "done-loop"
        },
        {
          "op": "let",
          "label": "body",
          "name": "row",
          "expr": "rows.shift()",
          "aside": "take the next row"
        },
        {
          "op": "call",
          "target": "saveContact",
          "args": {
            "contact": "row"
          },
          "bind": "result",
          "aside": "save the contact",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip",
              "bind": "dupError"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1",
          "aside": "count the duplicate"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "effect",
          "label": "done-loop",
          "kind": "metrics.write",
          "desc": "record import metrics",
          "args": {
            "saved": "saved",
            "skipped": "skipped"
          }
        },
        {
          "op": "return",
          "expr": "{saved, skipped}"
        },
        {
          "op": "note",
          "label": "no-upload",
          "note": "no upload found"
        },
        {
          "op": "throw",
          "tag": "NoUpload",
          "message": "upload not found",
          "channel": "escape"
        }
      ]
    },
    "fetchUpload": {
      "name": "fetchUpload",
      "role": "io",
      "loc": "src/import/fetch.ts:3",
      "params": [
        "id"
      ],
      "channels": {
        "A": "raw bytes of the upload",
        "E": [
          "NoUpload"
        ],
        "R": [
          "the S3 client"
        ]
      },
      "touches": [
        "src/import/fetch.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.get",
          "desc": "fetch the CSV file",
          "args": {
            "key": "id"
          },
          "bind": "bytes"
        },
        {
          "op": "if",
          "cond": "bytes is present",
          "then": "found",
          "else": "missing"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "bytes"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoUpload",
          "message": "object not found in S3",
          "channel": "escape"
        }
      ]
    },
    "parseRows": {
      "name": "parseRows",
      "role": "pure",
      "loc": "src/import/parse.ts:2",
      "params": [
        "data"
      ],
      "channels": {
        "A": "array of parsed rows",
        "E": [
          "BadCsv"
        ],
        "R": []
      },
      "touches": [
        "src/import/parse.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "lines",
          "expr": "data.split('\\n')"
        },
        {
          "op": "if",
          "cond": "header is valid",
          "then": "parse",
          "else": "bad-header"
        },
        {
          "op": "let",
          "label": "parse",
          "name": "rows",
          "expr": "lines.slice(1).map(line => line.split(','))",
          "aside": "parse each line into columns"
        },
        {
          "op": "return",
          "expr": "rows"
        },
        {
          "op": "throw",
          "label": "bad-header",
          "tag": "BadCsv",
          "message": "header line is invalid",
          "channel": "die"
        }
      ]
    },
    "saveContact": {
      "name": "saveContact",
      "role": "io",
      "loc": "src/contacts/save.ts:8",
      "params": [
        "contact"
      ],
      "channels": {
        "A": "the saved contact object",
        "E": [
          "Duplicate"
        ],
        "R": [
          "the contacts table"
        ]
      },
      "touches": [
        "src/contacts/save.ts",
        "src/contacts/normalise.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "normalise",
          "args": {
            "row": "contact"
          },
          "bind": "cleaned",
          "aside": "normalise the row before insert"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "insert into contacts table",
          "args": {
            "data": "cleaned"
          },
          "bind": "inserted"
        },
        {
          "op": "if",
          "cond": "inserted without error",
          "then": "success",
          "else": "dup-check"
        },
        {
          "op": "return",
          "label": "success",
          "expr": "inserted"
        },
        {
          "op": "throw",
          "label": "dup-check",
          "tag": "Duplicate",
          "message": "contact already exists",
          "channel": "retry"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
      "role": "pure",
      "loc": "src/contacts/normalise.ts:1",
      "params": [
        "row"
      ],
      "channels": {
        "A": "the cleaned row",
        "E": [],
        "R": []
      },
      "touches": [
        "src/contacts/normalise.ts"
      ],
      "enteredBy": [
        "src/contacts/normalise.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "cleaned",
          "expr": "{email: row[0].trim(), name: row[1].trim()}"
        },
        {
          "op": "return",
          "expr": "cleaned"
        }
      ]
    }
  },
