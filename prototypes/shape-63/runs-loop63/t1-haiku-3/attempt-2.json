        },
        {
          "op": "if",
          "cond": "draft body is empty or markdown is invalid",
          "then": "error",
          "else": "ok"
        },
        {
          "op": "throw",
          "label": "error",
          "tag": "BadMarkdown",
          "message": "cannot render the markdown",
          "channel": "die"
        },
        {
          "op": "return",
          "label": "ok",
          "expr": "render(draft.body) to HTML"
        }
      ]
