      "steps": [
        {
          "op": "note",
          "note": "publish a draft blog post to the web"
        },
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft from the store",
          "args": {
            "id": "draftId"
          },
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "the draft is empty",
          "then": "empty",
          "else": "render"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "EmptyDraft",
          "message": "cannot publish an empty draft",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "render",
          "target": "renderHtml",
          "args": {
            "draft": "draft"
          },
          "bind": "html",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback"
            }
          ]
        },
        {
          "op": "call",
          "label": "upload",
          "target": "uploadHtml",
          "args": {
            "html": "html"
          },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "plain text version of draft.body"
        },
        {
          "op": "goto",
          "to": "upload"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:20",
      "params": ["draft"],
      "channels": {
        "A": "the HTML string",
        "E": ["BadMarkdown"],
        "R": []
