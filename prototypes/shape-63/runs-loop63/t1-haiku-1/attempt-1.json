      "steps": [
        {
          "op": "note",
          "note": "parse markdown to HTML, or fail on bad syntax"
        },
        {
          "op": "if",
          "cond": "the body is empty",
          "then": "empty",
          "else": "parse"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": ""
        },
        {
          "op": "let",
          "label": "parse",
