      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "note",
          "note": "render the grid HTML from formatted rows"
        },
        {
          "op": "return",
          "expr": "gridHTML(rows)"
        }
      ]
    },
    "parseQuery": {
      "name": "parseQuery",
      "role": "pure",
      "loc": "src/filters/parse.ts",
      "params": [
        "query"
      ],
      "channels": {
        "A": "the filter object",
        "E": [
          "BadQuery"
        ],
        "R": []
      },
      "touches": [
        "src/filters/parse.ts"
      ],
      "enteredBy": [
        "src/filters/parse.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "parse the query string into a filter object"
        },
        {
          "op": "if",
          "cond": "query is valid",
          "then": "valid",
          "else": "invalid"
        },
        {
          "op": "return",
          "label": "valid",
          "expr": "parseFilters(query)"
        },
        {
          "op": "throw",
          "label": "invalid",
          "tag": "BadQuery",
          "message": "query could not be parsed",
          "channel": "die"
        }
      ]
    }
