      "steps": [
        {
          "op": "note",
          "note": "format pence as a display string like £12.50"
        },
        {
          "op": "let",
          "name": "pounds",
          "expr": "pence / 100"
        },
        {
          "op": "return",
          "expr": "\"£\" + pounds.toFixed(2)"
        }
      ]
    },
    "renderGrid": {
      "name": "renderGrid",
