    "renderCatalog": {
      "name": "renderCatalog",
      "role": "handler",
      "loc": "src/catalog/render.ts",
      "params": [
        "pageId"
      ],
      "channels": {
        "A": "the rendered HTML",
        "E": [
          "NoPage"
        ],
        "R": [
          "the products table"
        ]
      },
      "touches": [
        "src/catalog/render.ts"
      ],
      "enteredBy": [
        "src/catalog/render.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "render the catalogue page by formatting each product price and building the grid"
        },
        {
          "op": "effect",
          "kind": "db.query",
          "desc": "load the page's products",
          "args": {
            "pageId": "pageId"
          },
          "bind": "rows"
        },
        {
          "op": "let",
          "name": "formattedRows",
          "expr": "[]"
        },
        {
          "op": "if",
          "label": "loop",
          "cond": "rows is not empty",
          "then": "format",
          "else": "done"
        },
        {
          "op": "call",
          "label": "format",
          "target": "formatPrice",
          "args": {
            "pence": "rows[0].pence"
          },
          "bind": "formatted"
        },
        {
          "op": "let",
          "name": "row",
          "expr": "{product: rows[0], price: formatted}"
        },
        {
          "op": "let",
          "name": "formattedRows",
          "expr": "formattedRows.concat(row)"
        },
        {
          "op": "let",
          "name": "rows",
          "expr": "rows.slice(1)"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "call",
          "label": "done",
          "target": "renderGrid",
          "args": {
            "rows": "formattedRows"
          },
          "bind": "html"
        },
        {
          "op": "return",
          "expr": "html"
        }
      ]
    },
    "applyFilters": {
      "name": "applyFilters",
      "role": "handler",
      "loc": "src/filters/apply.ts",
      "params": [
        "query"
      ],
      "channels": {
        "A": "the number of rows written",
        "E": [
          "BadQuery"
        ],
        "R": [
          "the search API"
        ]
      },
      "touches": [
        "src/filters/apply.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "note",
          "note": "apply filters by parsing the query, fetching matches, formatting prices, and patching the DOM"
        },
        {
          "op": "call",
          "target": "parseQuery",
          "args": {
            "query": "query"
          },
          "bind": "filters"
        },
        {
          "op": "effect",
          "kind": "api.get",
          "desc": "fetch the matching products",
          "args": {
            "filters": "filters"
          },
          "bind": "matches",
          "onError": [
            {
              "tag": "Timeout",
              "goto": "stale"
            }
          ]
        },
        {
          "op": "let",
          "name": "formattedRows",
          "expr": "[]"
        },
        {
          "op": "if",
          "label": "loop",
          "cond": "matches is not empty",
          "then": "format",
          "else": "patch"
        },
        {
          "op": "call",
          "label": "format",
          "target": "formatPrice",
          "args": {
            "pence": "matches[0].pence"
          },
          "bind": "formatted"
        },
        {
          "op": "let",
          "name": "row",
          "expr": "{product: matches[0], price: formatted}"
        },
        {
          "op": "let",
          "name": "formattedRows",
          "expr": "formattedRows.concat(row)"
        },
        {
          "op": "let",
          "name": "matches",
          "expr": "matches.slice(1)"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "effect",
          "label": "patch",
          "kind": "dom.patch",
          "desc": "write the rows into the page",
          "args": {
            "rows": "formattedRows"
          }
        },
        {
          "op": "return",
          "expr": "formattedRows.length"
        },
        {
          "op": "return",
          "label": "stale",
          "expr": "\"kept the stale rows\""
        }
      ]
    },
    "formatPrice": {
      "name": "formatPrice",
      "role": "pure",
      "loc": "src/money/format.ts",
      "params": [
        "pence"
      ],
      "channels": {
        "A": "the price as a display string",
        "E": [],
        "R": []
      },
      "touches": [
