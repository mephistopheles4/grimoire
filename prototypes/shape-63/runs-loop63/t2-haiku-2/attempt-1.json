    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:8",
      "params": ["cartId"],
      "channels": {
        "A": "order id or a payment status message",
        "E": ["NoCart", "CardDeclined"],
        "R": ["the cart table", "the Stripe client"]
      },
      "touches": ["src/checkout.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "load a cart, calculate its total, charge the customer, and return an order id or a decline message"
        },
        {
          "op": "call",
          "target": "loadCart",
          "args": {"id": "cartId"},
          "bind": "cart",
          "aside": "fetch the cart from the database",
          "onError": []
        },
        {
          "op": "call",
          "target": "priceCart",
          "args": {"cart": "cart"},
          "bind": "total",
          "aside": "calculate the total by looping through items"
        },
        {
          "op": "if",
          "cond": "total is zero",
          "then": "empty",
          "else": "charge-step"
        },
        {
          "op": "let",
          "label": "empty",
          "name": "result",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "return",
          "expr": "result"
        },
        {
          "op": "call",
          "label": "charge-step",
          "target": "charge",
          "args": {"amount": "total"},
          "bind": "orderId",
          "aside": "attempt to charge the card",
          "onError": [
            {
              "tag": "CardDeclined",
              "goto": "declined"
            }
          ]
        },
        {
          "op": "return",
          "expr": "orderId"
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "send a payment decline notice"
        },
        {
          "op": "return",
          "expr": "\"payment declined\""
        }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:12",
      "params": ["id"],
      "channels": {
        "A": "a cart object",
        "E": ["NoCart"],
        "R": ["the cart table"]
      },
      "touches": ["src/cart-store.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "fetch the cart row",
          "args": {"id": "id"},
          "bind": "row"
        },
        {
          "op": "if",
          "cond": "row is missing",
          "then": "missing",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "row"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoCart",
          "message": "no cart with that id",
          "channel": "escape"
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:3",
      "params": ["cart"],
      "channels": {
        "A": "total in pence",
        "E": [],
        "R": []
      },
      "touches": ["src/pricing.ts"],
      "enteredBy": ["src/pricing.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "index",
          "expr": "0",
          "label": "loop"
        },
        {
          "op": "if",
          "cond": "index < cart.length",
          "then": "add-item",
          "else": "done-loop"
        },
        {
          "op": "let",
          "label": "add-item",
          "name": "item-price",
          "expr": "cart[index].price"
        },
        {
          "op": "let",
          "name": "total",
          "expr": "total + item-price"
        },
        {
          "op": "let",
          "name": "index",
          "expr": "index + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "return",
          "label": "done-loop",
          "expr": "total"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:15",
      "params": ["amount"],
      "channels": {
        "A": "order id",
        "E": ["CardDeclined"],
        "R": ["the Stripe client"]
      },
      "touches": ["src/payments.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the card",
          "args": {"amount": "amount"},
          "bind": "result"
        },
        {
          "op": "if",
          "cond": "result is approved",
          "then": "approved",
          "else": "declined"
        },
        {
          "op": "return",
          "label": "approved",
          "expr": "result.orderId"
        },
        {
          "op": "throw",
          "label": "declined",
          "tag": "CardDeclined",
          "message": "card was declined",
          "channel": "retry"
        }
      ]
    }
  },
