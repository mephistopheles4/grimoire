  "nodes": {
    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:5",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "an order id",
        "E": [
          "NoCart",
          "CardDeclined"
        ],
        "R": [
          "the Stripe client",
          "the cart table"
        ]
      },
      "touches": [
        "src/checkout.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "turn a cart into an order by loading, pricing, and charging"
        },
        {
          "op": "call",
          "target": "loadCart",
          "args": {
            "id": "cartId"
          },
          "bind": "cart",
          "aside": "throws NoCart on escape if the cart row is missing",
          "onError": [
            {
              "tag": "NoCart",
              "goto": "notFound"
            }
          ]
        },
        {
          "op": "call",
          "target": "priceCart",
          "args": {
            "cart": "cart"
          },
          "bind": "total",
          "aside": "loops through items to sum the total"
        },
        {
          "op": "if",
          "cond": "total is zero",
          "then": "empty",
          "else": "charge-card"
        },
        {
          "op": "let",
          "label": "empty",
          "name": "result",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "return",
          "expr": "result"
        },
        {
          "op": "call",
          "label": "charge-card",
          "target": "charge",
          "args": {
            "pence": "total"
          },
          "bind": "orderId",
          "aside": "stripe.charge can fail with CardDeclined",
          "onError": [
            {
              "tag": "CardDeclined",
              "goto": "declined",
              "bind": "reason"
            }
          ]
        },
        {
          "op": "return",
          "expr": "orderId"
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "notify the customer of the decline",
          "args": {
            "message": "reason"
          }
        },
        {
          "op": "return",
          "label": "notFound",
          "expr": "\"payment declined\""
        }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:8",
      "params": [
        "id"
      ],
      "channels": {
        "A": "a cart object",
        "E": [
          "NoCart"
        ],
        "R": [
          "the cart table"
        ]
      },
      "touches": [
        "src/cart-store.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "fetch the cart row",
          "args": {
            "id": "id"
          },
          "bind": "row"
        },
        {
          "op": "if",
          "cond": "row is missing",
          "then": "missing",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "row"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoCart",
          "message": "cart not found",
          "channel": "escape"
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:3",
      "params": [
        "cart"
      ],
      "channels": {
        "A": "total price in pence",
        "E": [],
        "R": []
      },
      "touches": [
        "src/pricing.ts"
      ],
      "enteredBy": [
        "src/pricing.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "index",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loop-check",
          "cond": "index < cart.items.length",
          "then": "loop-body",
          "else": "loop-end"
        },
        {
          "op": "let",
          "label": "loop-body",
          "name": "item",
          "expr": "cart.items[index]"
        },
        {
          "op": "let",
          "name": "total",
          "expr": "total + item.price"
        },
        {
          "op": "let",
          "name": "index",
          "expr": "index + 1"
        },
        {
          "op": "goto",
          "to": "loop-check"
        },
        {
          "op": "return",
          "label": "loop-end",
          "expr": "total"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:12",
      "params": [
        "pence"
      ],
      "channels": {
        "A": "an order id",
        "E": [
          "CardDeclined"
        ],
        "R": [
          "the Stripe client"
        ]
      },
      "touches": [
        "src/payments.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the card",
          "args": {
            "amount": "pence"
          },
          "bind": "result"
        },
        {
          "op": "return",
          "expr": "result.orderId"
        }
      ]
    }
  },
