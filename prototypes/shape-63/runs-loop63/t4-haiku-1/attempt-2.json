      },
      "touches": ["src/catalog/grid.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "note",
          "note": "return the HTML for the grid"
        },
        {
          "op": "return",
          "expr": "<div class='grid'>...</div>"
        }
      ]
    },
    "parseQuery": {
      "name": "parseQuery",
      "role": "pure",
      "loc": "src/filters/parse.ts:1",
      "params": ["query"],
      "channels": {
        "A": "filter object",
        "E": ["BadQuery"],
        "R": []
      },
      "touches": ["src/filters/parse.ts"],
      "enteredBy": ["src/filters/parse.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "parse the query string and return the filter object"
        },
        {
          "op": "if",
          "cond": "query is valid",
          "then": "valid",
          "else": "invalid"
        },
        {
          "op": "return",
          "label": "valid",
          "expr": "filters"
        },
        {
          "op": "throw",
          "label": "invalid",
          "tag": "BadQuery",
          "message": "the query will not parse",
          "channel": "die"
        }
      ]
    }
  },
