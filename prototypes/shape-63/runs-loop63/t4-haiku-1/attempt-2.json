  },
  "nodes": {
    "renderCatalog": {
      "name": "renderCatalog",
      "role": "handler",
      "loc": "src/catalog/render.ts:5",
      "params": ["pageId"],
      "channels": {
        "A": "HTML grid of products",
        "E": ["NoPage"],
        "R": ["the products table"]
      },
      "touches": ["src/catalog/render.ts"],
      "enteredBy": ["src/catalog/render.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "render a catalogue page by loading products and formatting prices"
        },
        {
          "op": "effect",
          "kind": "db.query",
          "desc": "load the page's products",
          "args": {
            "pageId": "pageId"
          },
          "bind": "products",
          "onError": [
            {
              "tag": "NoPage",
              "goto": "error"
            }
          ]
        },
        {
          "op": "let",
          "name": "rows",
          "expr": "[]"
        },
        {
          "op": "let",
          "name": "i",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loop",
          "cond": "i < products.length",
          "then": "loop-body",
          "else": "loop-end"
        },
        {
          "op": "call",
          "label": "loop-body",
          "target": "formatPrice",
          "args": {
            "pence": "products[i].price"
          },
          "bind": "formatted"
        },
        {
          "op": "let",
          "name": "i",
          "expr": "i + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "call",
          "label": "loop-end",
          "target": "renderGrid",
          "args": {
            "rows": "rows"
          },
          "bind": "html"
        },
        {
          "op": "return",
          "expr": "html"
        },
        {
          "op": "return",
          "label": "error",
          "expr": "null"
        }
      ]
    },
    "applyFilters": {
      "name": "applyFilters",
      "role": "handler",
      "loc": "src/filters/apply.ts:10",
      "params": ["query"],
      "channels": {
        "A": "number of rows written or stale message",
        "E": ["BadQuery", "Timeout"],
        "R": ["the search API"]
      },
      "touches": ["src/filters/apply.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "note",
          "note": "apply filters without a page reload by parsing the query and fetching matches"
        },
        {
          "op": "call",
          "target": "parseQuery",
          "args": {
            "query": "query"
          },
          "bind": "filters"
        },
        {
          "op": "effect",
          "kind": "api.get",
          "desc": "fetch the matching products",
          "args": {
            "filters": "filters"
          },
          "bind": "matches",
          "onError": [
            {
              "tag": "Timeout",
              "goto": "stale"
            }
          ]
        },
        {
          "op": "let",
          "name": "rows",
          "expr": "[]"
        },
        {
          "op": "let",
          "name": "i",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loop",
          "cond": "i < matches.length",
          "then": "loop-body",
          "else": "loop-end"
        },
        {
          "op": "call",
          "label": "loop-body",
          "target": "formatPrice",
          "args": {
            "pence": "matches[i].price"
          },
          "bind": "formatted"
        },
        {
          "op": "let",
          "name": "i",
          "expr": "i + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "effect",
          "label": "loop-end",
          "kind": "dom.patch",
          "desc": "write the rows into the page",
          "args": {
            "rows": "rows"
          }
        },
        {
          "op": "return",
          "expr": "rows.length"
        },
        {
          "op": "let",
          "label": "stale",
          "name": "msg",
          "expr": "\"kept the stale rows\""
        },
        {
          "op": "return",
          "expr": "msg"
        }
      ]
    },
    "formatPrice": {
      "name": "formatPrice",
      "role": "pure",
      "loc": "src/money/format.ts:3",
      "params": ["pence"],
      "channels": {
        "A": "price as a display string",
        "E": [],
        "R": []
      },
      "touches": ["src/money/format.ts"],
      "enteredBy": ["src/money/format.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "divide pence by 100 and return a string like £12.50"
        },
        {
          "op": "let",
          "name": "pounds",
          "expr": "pence / 100"
        },
        {
          "op": "return",
          "expr": "\"£\" + pounds.toFixed(2)"
        }
      ]
    },
    "renderGrid": {
      "name": "renderGrid",
      "role": "pure",
      "loc": "src/catalog/grid.ts:2",
      "params": ["rows"],
      "channels": {
        "A": "HTML grid markup",
        "E": [],
