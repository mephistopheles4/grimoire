          "name": "lines",
          "expr": "bytes.split('\\n')"
        },
        {
          "op": "let",
          "name": "header",
          "expr": "lines[0]"
        },
        {
          "op": "if",
          "cond": "header is not valid",
          "then": "bad",
          "else": "good"
        },
        {
          "op": "throw",
          "label": "bad",
          "tag": "BadCsv",
          "message": "invalid header line",
          "channel": "die"
        },
        {
          "op": "let",
          "label": "good",
          "name": "rows",
          "expr": "lines.slice(1).map(parseLine)"
        },
        {
          "op": "return",
          "expr": "rows"
        }
      ]
    },
