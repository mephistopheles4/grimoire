      ],
      "steps": [
        {
          "op": "note",
          "note": "load a CSV of contacts into the address book"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {
            "uploadId": "uploadId"
          },
          "bind": "bytes"
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {
            "bytes": "bytes"
          },
          "bind": "rows"
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "let",
          "label": "loop",
          "name": "row",
          "expr": "rows.shift()"
        },
        {
          "op": "if",
          "cond": "no rows remain",
          "then": "done",
          "else": "process"
        },
        {
          "op": "call",
          "label": "process",
          "target": "saveContact",
          "args": {
            "row": "row"
          },
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "continue"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "goto",
          "label": "continue",
          "to": "loop"
        },
        {
          "op": "effect",
          "label": "done",
          "kind": "metrics.write",
          "desc": "record import metrics",
          "args": {
            "saved": "saved",
            "skipped": "skipped"
          }
        },
        {
          "op": "return",
          "expr": "{ saved, skipped }"
        }
      ]
    },
