  "sheet": {
    "scopeRule": "one graph per entry point",
    "graphsNotDrawn": []
  },
  "nodes": {
    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:10",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "an order id or a decline message",
        "E": [
          "NoCart",
          "CardDeclined"
        ],
        "R": [
          "the cart table",
          "the Stripe client",
          "the mail service"
        ]
      },
      "touches": [
        "src/checkout.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "load a cart, price it, charge the card, and send a decline notice if needed"
        },
        {
          "op": "call",
          "target": "loadCart",
          "args": {
            "id": "cartId"
          },
          "bind": "cart",
          "onError": [
            {
              "tag": "NoCart",
              "goto": "notfound"
            }
          ]
        },
        {
          "op": "call",
          "target": "priceCart",
          "args": {
            "items": "cart.items"
          },
          "bind": "total"
        },
        {
          "op": "if",
          "cond": "total is zero",
          "then": "empty",
          "else": "proceed"
        },
        {
          "op": "call",
          "label": "proceed",
          "target": "charge",
          "args": {
            "amount": "total"
          },
          "bind": "orderId",
          "onError": [
            {
              "tag": "CardDeclined",
              "goto": "declined"
            }
          ]
        },
        {
          "op": "return",
          "expr": "orderId"
        },
        {
          "op": "let",
          "label": "empty",
          "name": "result",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "return",
          "expr": "result"
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "notify the customer of the declined card",
          "args": {
            "cartId": "cartId",
            "reason": "CardDeclined"
          }
        },
        {
          "op": "return",
          "expr": "\"payment declined\""
        },
        {
          "op": "note",
          "label": "notfound",
          "note": "cart was not found; error is already in flight"
        }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:5",
      "params": [
        "id"
      ],
      "channels": {
        "A": "a cart object with items",
        "E": [
          "NoCart"
        ],
        "R": [
          "the cart table"
        ]
      },
      "touches": [
        "src/cart-store.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the cart row",
          "args": {
            "id": "id"
          },
          "bind": "row"
        },
        {
          "op": "if",
          "cond": "row is missing",
          "then": "notfound",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "row"
        },
        {
          "op": "throw",
          "label": "notfound",
          "tag": "NoCart",
          "message": "no cart with that id",
          "channel": "escape"
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:3",
      "params": [
        "items"
      ],
      "channels": {
        "A": "the total price in pence",
        "E": [],
        "R": []
      },
      "touches": [
        "src/pricing.ts"
      ],
      "enteredBy": [
        "src/pricing.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "index",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loop",
          "cond": "index < items.length",
          "then": "add",
          "else": "done"
        },
        {
          "op": "let",
          "label": "add",
          "name": "item",
          "expr": "items[index]"
        },
        {
          "op": "let",
          "name": "total",
          "expr": "total + (item.price * item.qty)"
        },
        {
          "op": "let",
          "name": "index",
          "expr": "index + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "return",
          "label": "done",
          "expr": "total"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:8",
      "params": [
        "amount"
      ],
      "channels": {
        "A": "an order id",
        "E": [
          "CardDeclined"
        ],
        "R": [
          "the Stripe client"
        ]
      },
      "touches": [
        "src/payments.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the card for the order",
          "args": {
            "amount": "amount"
          },
          "bind": "charge"
        },
        {
          "op": "if",
          "cond": "charge.succeeded",
          "then": "success",
          "else": "failed"
        },
        {
          "op": "return",
          "label": "success",
          "expr": "charge.orderId"
        },
        {
          "op": "throw",
          "label": "failed",
          "tag": "CardDeclined",
          "message": "card was declined by the processor",
          "channel": "retry"
        }
      ]
    }
  },
