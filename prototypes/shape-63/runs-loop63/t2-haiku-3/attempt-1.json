      "path": "src/checkout.ts",
      "change": "edit",
      "why": "the checkout orchestration and error handlers",
      "adds": 62,
      "dels": 11
    },
    {
      "path": "src/pricing.ts",
      "change": "new",
      "why": "the pricing loop that totals the cart",
      "adds": 38,
      "dels": 0
    },
    {
      "path": "src/cart-store.ts",
      "change": "edit",
      "why": "the cart loader that queries the database",
      "adds": 9,
      "dels": 1
    },
    {
      "path": "src/payments.ts",
      "change": "edit",
      "why": "the payment effect using the Stripe API",
      "adds": 27,
      "dels": 4
    }
  ],
