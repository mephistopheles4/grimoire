{
  "id": "cart-total",
  "title": "Cart checkout and payment",
  "blurb": "Loads a cart, prices its items with a loop, handles payment, and notifies on decline. One entry point with error handling for both missing carts and payment failures.",
  "env": {
    "currency": "GBP"
  },
  "files": [
