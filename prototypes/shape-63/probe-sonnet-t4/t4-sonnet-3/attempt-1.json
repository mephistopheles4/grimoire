{
  "id": "price-panel-catalog",
  "title": "Price panel: catalog render and browser re-filter",
  "blurb": "Two entry points format a price the same way: the server-rendered catalogue page and the browser's re-filter action. Both loop over a list of products, call the shared formatPrice, and produce their own output.",
  "env": {},
  "files": [
    {
      "path": "src/catalog/render.ts",
      "change": "edit",
      "why": "adds the page-missing guard and the product loop that formats each price",
      "adds": 47,
      "dels": 8
    },
    {
      "path": "src/catalog/grid.ts",
      "change": "new",
      "why": "holds the grid renderer the catalogue page calls once prices are formatted",
      "adds": 31,
      "dels": 0
    },
    {
      "path": "src/filters/apply.ts",
      "change": "edit",
      "why": "re-applies filters in the browser and formats the returned prices",
      "adds": 52,
      "dels": 15
    },
    {
      "path": "src/filters/parse.ts",
      "change": "new",
      "why": "parses the filter query and throws when it will not parse",
      "adds": 24,
      "dels": 0
    },
    {
      "path": "src/money/format.ts",
      "change": "new",
      "why": "the shared price formatter both entry points call",
      "adds": 18,
      "dels": 0
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "nodes": {
        "renderCatalog": {
          "R": [
            "the products table -> a seeded fixture · render.test.ts:14"
          ]
        },
        "applyFilters": {
          "R": [
            "the search API -> a canned response · apply.test.ts:31"
          ]
        }
      }
    }
  },
  "sheet": {
    "scopeRule": "one graph per entry point",
    "graphsNotDrawn": []
  },
  "nodes": {
    "renderCatalog": {
      "name": "renderCatalog",
      "role": "handler",
      "loc": "src/catalog/render.ts:10",
      "params": ["pageId"],
      "channels": {
        "A": "the catalogue page's HTML",
        "E": ["NoPage"],
        "R": ["the products table"]
      },
      "touches": ["src/catalog/render.ts"],
      "enteredBy": ["src/catalog/render.test.ts"],
      "steps": [
        {
          "op": "effect",
          "kind": "db.query",
          "desc": "load the page's products",
          "args": { "pageId": "pageId" },
          "bind": "page"
        },
        {
          "op": "if",
          "cond": "the page is missing",
          "then": "pageMissing",
          "else": "loopTop"
        },
        {
          "op": "throw",
          "label": "pageMissing",
          "tag": "NoPage",
          "message": "no page with that id",
          "channel": "escape"
        },
        {
          "op": "if",
          "label": "loopTop",
          "cond": "no products remain",
          "then": "afterLoop",
          "else": "loopBody"
        },
        {
          "op": "call",
          "label": "loopBody",
          "target": "formatPrice",
          "args": { "pence": "currentProduct.pence" },
          "bind": "priceLine",
          "aside": "formats the price of the product at the front of the loop"
        },
        {
          "op": "goto",
          "to": "loopTop"
        },
        {
          "op": "call",
          "label": "afterLoop",
          "target": "renderGrid",
          "args": { "rows": "products" },
          "bind": "html"
        },
        {
          "op": "return",
          "expr": "html"
        }
      ]
    },
    "renderGrid": {
      "name": "renderGrid",
      "role": "pure",
      "loc": "src/catalog/grid.ts:5",
      "params": ["rows"],
      "channels": {
        "A": "the grid's HTML",
        "E": [],
        "R": []
      },
      "touches": ["src/catalog/grid.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "return",
          "expr": "the grid HTML built from rows"
        }
      ]
    },
    "formatPrice": {
      "name": "formatPrice",
      "role": "pure",
      "loc": "src/money/format.ts:4",
      "params": ["pence"],
      "channels": {
        "A": "a display price string",
        "E": [],
        "R": []
      },
      "touches": ["src/money/format.ts"],
      "enteredBy": ["src/money/format.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "value",
          "expr": "pence / 100"
        },
        {
          "op": "return",
          "expr": "\"£\" + value.toFixed(2)"
        }
      ]
    },
    "applyFilters": {
      "name": "applyFilters",
      "role": "handler",
      "loc": "src/filters/apply.ts:12",
      "params": ["query"],
      "channels": {
        "A": "the number of rows written, or a message that the stale rows were kept",
        "E": ["Timeout"],
        "R": ["the search API"]
      },
      "touches": ["src/filters/apply.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "parseQuery",
          "args": { "query": "query" },
          "bind": "filters",
          "aside": "BadQuery from here is not handled anywhere"
        },
        {
          "op": "effect",
          "kind": "api.get",
          "desc": "fetch the matching products",
          "args": { "filters": "filters" },
          "bind": "matches",
          "onError": [
            { "tag": "Timeout", "goto": "stale", "bind": "why" }
          ]
        },
        {
          "op": "if",
          "label": "loopTop",
          "cond": "no matches remain",
          "then": "afterLoop",
          "else": "loopBody"
        },
        {
          "op": "call",
          "label": "loopBody",
          "target": "formatPrice",
          "args": { "pence": "currentMatch.pence" },
          "bind": "priceLine"
        },
        {
          "op": "goto",
          "to": "loopTop"
        },
        {
          "op": "effect",
          "label": "afterLoop",
          "kind": "dom.patch",
          "desc": "write the rows into the page",
          "args": { "rows": "matches" },
          "bind": "patched"
        },
        {
          "op": "return",
          "expr": "matches.length"
        },
        {
          "op": "return",
          "label": "stale",
          "expr": "\"kept the stale rows\""
        }
      ]
    },
    "parseQuery": {
      "name": "parseQuery",
      "role": "pure",
      "loc": "src/filters/parse.ts:6",
      "params": ["query"],
      "channels": {
        "A": "the parsed filter object",
        "E": ["BadQuery"],
        "R": []
      },
      "touches": ["src/filters/parse.ts"],
      "enteredBy": ["src/filters/parse.test.ts"],
      "steps": [
        {
          "op": "if",
          "cond": "the query will not parse",
          "then": "bad",
          "else": "good"
        },
        {
          "op": "throw",
          "label": "bad",
          "tag": "BadQuery",
          "message": "the query will not parse",
          "channel": "die"
        },
        {
          "op": "return",
          "label": "good",
          "expr": "the parsed filter object"
        }
      ]
    }
  },
  "graphs": [
