              { "k": "goto", "at": 5, "next": 3 },
              { "k": "if", "at": 3, "next": 4 },
              { "k": "call", "at": 4, "to": "formatPrice", "next": 5 },
              { "k": "let", "at": 0, "next": 1 },
              { "k": "return", "at": 1, "value": "£25.00" },
