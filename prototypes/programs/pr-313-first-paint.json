        },
        {
          "op": "if",
          "cond": "species === null",
          "then": "off",
          "else": "on"
        },
        {
          "op": "note",
          "label": "off",
          "note": "refused in the report, never dropped at parse: a dropped value looks exactly like a value that was applied"
        },
        {
          "op": "return",
          "expr": "({ species: $env.default, sheet: $env.sheets[$env.default], lay: $env.sheets[$env.default], refused: 'woodwork sheet: \"' + requested + '\" is not a sheet anybody has rendered, so the woodwork is showing ' + $env.default + '. The roster is ' + $env.roster.join(', ') })"
        },
        {
          "op": "let",
          "label": "on",
          "name": "sheet",
          "expr": "$env.sheets[species] ?? null"
        },
