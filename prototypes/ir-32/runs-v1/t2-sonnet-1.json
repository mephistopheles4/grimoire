{
  "id": "checkout-cart-total",
  "title": "Checkout · the cart total",
  "blurb": "checkout turns a cart into an order. It prices the cart in a loop, skips charging an empty cart, and falls back to a decline message when the card is refused.",
  "entry": "checkout",
  "env": { "currency": "GBP" },
  "files": [
    { "path": "src/checkout.ts", "change": "edit", "why": "the handler gains the empty-cart shortcut and the decline path", "adds": 62, "dels": 11 },
    { "path": "src/pricing.ts", "change": "new", "why": "the pricing loop checkout calls", "adds": 38, "dels": 0 },
    { "path": "src/cart-store.ts", "change": "edit", "why": "the cart lookup checkout calls", "adds": 9, "dels": 1 },
    { "path": "src/payments.ts", "change": "edit", "why": "the charge call and its CardDeclined path", "adds": 27, "dels": 4 }
  ],
  "layers": {
    "production": { "nodes": {} },
    "tests": {
      "nodes": {
        "charge": { "R": ["a stub that always declines · checkout.test.ts:44"] },
        "loadCart": { "R": ["an in-memory map · checkout.test.ts:12"] }
      }
    },
    "smoke": { "entry": "checkout", "nodes": {} }
  },
  "nodes": {
    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:12",
      "params": ["cartId"],
      "channels": { "A": "the order id, or a fallback message", "E": ["NoCart", "CardDeclined"], "R": ["the cart table", "the Stripe client", "the mail sender"] },
      "touches": ["src/checkout.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        { "op": "note", "note": "turn a cart into an order" },
        { "op": "call", "target": "loadCart", "args": { "cartId": "cartId" }, "bind": "cart", "aside": "NoCart can escape here; checkout does not catch it" },
        { "op": "call", "target": "priceCart", "args": { "cart": "cart" }, "bind": "total" },
        { "op": "if", "cond": "total is zero", "then": "empty", "else": "charging" },
        { "op": "call", "label": "charging", "target": "charge", "args": { "total": "total" }, "bind": "orderId", "onError": [{ "tag": "CardDeclined", "goto": "declined", "bind": "why" }] },
        { "op": "return", "expr": "orderId" },
        { "op": "return", "label": "empty", "expr": "\"nothing to buy\"" },
        { "op": "effect", "label": "declined", "kind": "mail.send", "desc": "email the customer that the charge was declined", "args": { "to": "cart.email", "reason": "why" }, "bind": "notice" },
        { "op": "return", "expr": "\"payment declined\"" }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:5",
      "params": ["cartId"],
      "channels": { "A": "the cart", "E": ["NoCart"], "R": ["the cart table"] },
      "touches": ["src/cart-store.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        { "op": "effect", "kind": "db.get", "desc": "read the cart row", "args": { "id": "cartId" }, "bind": "row" },
        { "op": "if", "cond": "row is missing", "then": "missing", "else": "found" },
        { "op": "return", "label": "found", "expr": "row" },
        { "op": "throw", "label": "missing", "tag": "NoCart", "message": "no cart for that id", "channel": "escape" }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:4",
      "params": ["cart"],
      "channels": { "A": "the total in pence", "E": [], "R": [] },
      "touches": ["src/pricing.ts"],
      "enteredBy": ["src/pricing.test.ts"],
      "steps": [
        { "op": "let", "name": "total", "expr": "0" },
        { "op": "if", "label": "loopStart", "cond": "items remain", "then": "body", "else": "finish" },
        { "op": "let", "label": "body", "name": "total", "expr": "total + nextItem().price * nextItem().qty" },
        { "op": "goto", "to": "loopStart" },
        { "op": "return", "label": "finish", "expr": "total" }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:9",
      "params": ["total"],
      "channels": { "A": "the order id", "E": ["CardDeclined"], "R": ["the Stripe client"] },
      "touches": ["src/payments.ts"],
      "enteredBy": [],
      "steps": [
        { "op": "effect", "kind": "stripe.charge", "desc": "charge the card", "args": { "amount": "total" }, "bind": "result" },
        { "op": "if", "cond": "result was declined", "then": "declined", "else": "approved" },
        { "op": "return", "label": "approved", "expr": "result.orderId" },
        { "op": "throw", "label": "declined", "tag": "CardDeclined", "message": "the card was declined", "channel": "retry" }
      ]
    }
  },
  "presets": [
    {
      "name": "a paid order",
      "blurb": "The cart loads, prices at 4500 pence over two items, and the charge succeeds.",
      "input": { "cartId": "c-1" },
      "walk": {
