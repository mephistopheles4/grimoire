          { "k": "effect", "at": 0, "kind": "db.get", "desc": "read the cart row", "status": "ok", "result": { "id": "c-1", "items": [ { "sku": "widget", "price": 1500, "qty": 1 }, { "sku": "gadget", "price": 3000, "qty": 1 } ], "email": "ada@example.com" } },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "return", "at": 2, "value": { "id": "c-1", "items": [ { "sku": "widget", "price": 1500, "qty": 1 }, { "sku": "gadget", "price": 3000, "qty": 1 } ], "email": "ada@example.com" } },
          { "k": "call", "at": 2, "to": "priceCart" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "move", "at": 2, "next": 3 },
          { "k": "move", "at": 3, "next": 1 },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "move", "at": 2, "next": 3 },
          { "k": "move", "at": 3, "next": 1 },
          { "k": "move", "at": 1, "next": 4 },
          { "k": "return", "at": 4, "value": 4500 },
          { "k": "move", "at": 3, "next": 4 },
          { "k": "call", "at": 4, "to": "charge" },
          { "k": "effect", "at": 0, "kind": "stripe.charge", "desc": "charge the card", "status": "ok", "result": { "orderId": "ord-7001" } },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "return", "at": 2, "value": "ord-7001" },
          { "k": "return", "at": 5, "value": "ord-7001" },
          { "k": "done", "result": "ord-7001" }
        ]
      }
    },
    {
      "name": "the card declines",
      "blurb": "The cart prices the same as the paid order, but the charge fails, checkout catches CardDeclined, mails the customer, and returns the decline message.",
      "input": { "cartId": "c-2" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "checkout" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "call", "at": 1, "to": "loadCart" },
          { "k": "effect", "at": 0, "kind": "db.get", "desc": "read the cart row", "status": "ok", "result": { "id": "c-2", "items": [ { "sku": "widget", "price": 1500, "qty": 1 }, { "sku": "gadget", "price": 3000, "qty": 1 } ], "email": "grace@example.com" } },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "return", "at": 2, "value": { "id": "c-2", "items": [ { "sku": "widget", "price": 1500, "qty": 1 }, { "sku": "gadget", "price": 3000, "qty": 1 } ], "email": "grace@example.com" } },
          { "k": "call", "at": 2, "to": "priceCart" },
