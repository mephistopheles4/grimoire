    "smoke": { "nodes": {} }
  },
  "nodes": {
    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:1",
      "params": ["cartId"],
      "channels": { "A": "order id", "E": ["NoCart", "CardDeclined"], "R": ["cart store and payment processor"] },
      "touches": ["src/checkout.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        { "op": "note", "note": "turn a cart into an order" },
        { "op": "call", "target": "loadCart", "args": { "id": "cartId" }, "bind": "cart" },
        { "op": "call", "target": "priceCart", "args": { "cart": "cart" }, "bind": "total" },
        { "op": "if", "cond": "total is zero", "then": "empty", "else": "chargeit" },
        { "op": "call", "label": "chargeit", "target": "charge", "args": { "amount": "total" }, "bind": "orderId", "onError": [{ "tag": "CardDeclined", "goto": "declined" }] },
        { "op": "return", "expr": "orderId" },
        { "op": "let", "label": "empty", "name": "msg", "expr": "\"nothing to buy\"" },
        { "op": "return", "expr": "msg" },
        { "op": "effect", "label": "declined", "kind": "mail.send", "desc": "notify customer of declined card" },
        { "op": "return", "expr": "\"payment declined\"" }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:1",
      "params": ["id"],
      "channels": { "A": "cart object", "E": ["NoCart"], "R": ["the cart table"] },
      "touches": ["src/cart-store.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        { "op": "effect", "kind": "db.get", "desc": "read the cart row", "args": { "id": "id" }, "bind": "row" },
        { "op": "if", "cond": "row is missing", "then": "missing", "else": "found" },
        { "op": "return", "label": "found", "expr": "row" },
        { "op": "throw", "label": "missing", "tag": "NoCart", "message": "no cart for that id", "channel": "escape" }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:1",
      "params": ["cart"],
      "channels": { "A": "total in pence", "E": [], "R": [] },
      "touches": ["src/pricing.ts"],
      "enteredBy": ["src/pricing.test.ts"],
      "steps": [
        { "op": "let", "name": "total", "expr": "0" },
        { "op": "let", "name": "i", "expr": "0" },
        { "op": "if", "label": "loop", "cond": "i < cart.items.length", "then": "add", "else": "done" },
        { "op": "let", "label": "add", "name": "total", "expr": "total + cart.items[i].price" },
        { "op": "let", "name": "i", "expr": "i + 1" },
        { "op": "goto", "to": "loop" },
        { "op": "return", "label": "done", "expr": "total" }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:1",
      "params": ["amount"],
      "channels": { "A": "order id", "E": ["CardDeclined"], "R": ["the Stripe client"] },
      "touches": ["src/payments.ts"],
      "enteredBy": [],
      "steps": [
        { "op": "effect", "kind": "stripe.charge", "desc": "charge the card", "args": { "amount": "amount" }, "bind": "orderId", "onError": [{ "tag": "CardDeclined", "goto": "failed" }] },
        { "op": "return", "expr": "orderId" },
        { "op": "throw", "label": "failed", "tag": "CardDeclined", "message": "card declined by issuer", "channel": "retry" }
      ]
    }
  },
