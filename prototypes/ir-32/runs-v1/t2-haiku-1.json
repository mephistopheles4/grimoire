{
  "id": "cart-checkout",
  "title": "cart-checkout",
  "blurb": "The checkout flow loads a cart, prices it with a loop, and charges the customer, with a handler for declined cards that sends a notification.",
  "entry": "checkout",
  "env": {},
  "files": [
    { "path": "src/checkout.ts", "change": "edit", "why": "checkout function and card decline handler", "adds": 62, "dels": 11 },
    { "path": "src/pricing.ts", "change": "new", "why": "priceCart function with loop over items", "adds": 38, "dels": 0 },
    { "path": "src/cart-store.ts", "change": "edit", "why": "loadCart function", "adds": 9, "dels": 1 },
    { "path": "src/payments.ts", "change": "edit", "why": "charge function with stripe integration", "adds": 27, "dels": 4 }
  ],
  "layers": {
    "production": { "nodes": {} },
    "tests": {
      "entry": "checkout",
      "nodes": {
        "charge": { "R": ["a stub that always declines · checkout.test.ts:44"] },
