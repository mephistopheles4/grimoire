{
  "id": "publish-post-retry",
  "title": "Publish a post · retry on upload",
  "blurb": "publishPost reads a draft, renders its markdown, and uploads the html. A bad render falls back to plain text, and the upload retries once before it succeeds.",
  "entry": "publishPost",
  "env": {},
  "files": [
    { "path": "src/publish.ts", "change": "edit", "why": "holds publishPost, the entry that reads the draft, renders it, and uploads the html", "adds": 40, "dels": 6 },
    { "path": "src/render.ts", "change": "new", "why": "holds renderHtml, the pure markdown-to-html step", "adds": 55, "dels": 0 },
    { "path": "src/upload.ts", "change": "edit", "why": "holds uploadHtml, the s3.put effect that can retry", "adds": 18, "dels": 2 }
  ],
  "layers": {
    "production": { "nodes": {} },
    "tests": {
      "nodes": { "uploadHtml": { "R": ["a fake bucket · publish.test.ts:31"] } }
    }
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:12",
      "params": ["draftId"],
      "channels": { "A": "the published URL", "E": ["EmptyDraft"], "R": ["the draft store"] },
      "touches": ["src/publish.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        { "op": "note", "note": "publish a draft: fetch it, render its markdown, upload the html, and return the published url" },
        { "op": "effect", "kind": "db.get", "desc": "read the draft from the store", "args": { "id": "draftId" }, "bind": "draft" },
        { "op": "if", "cond": "draft is empty", "then": "empty", "else": "render" },
        { "op": "throw", "label": "empty", "tag": "EmptyDraft", "message": "no draft found for that id", "channel": "escape" },
        {
          "op": "call", "label": "render", "target": "renderHtml", "args": { "draft": "draft" }, "bind": "html",
          "aside": "the only call that can fail before the upload",
          "onError": [{ "tag": "BadMarkdown", "goto": "fallback", "bind": "reason" }]
        },
        { "op": "goto", "to": "upload" },
        { "op": "let", "label": "fallback", "name": "html", "expr": "a plain-text rendering of the draft" },
        { "op": "call", "label": "upload", "target": "uploadHtml", "args": { "html": "html" }, "bind": "url" },
        { "op": "return", "expr": "url" }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:6",
      "params": ["draft"],
      "channels": { "A": "the rendered html", "E": ["BadMarkdown"], "R": [] },
      "touches": ["src/render.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        { "op": "note", "note": "render the draft's markdown body to html; throws BadMarkdown when the body will not parse" },
        { "op": "if", "cond": "the draft body is empty", "then": "bad", "else": "ok" },
        { "op": "return", "label": "ok", "expr": "the rendered html" },
        { "op": "throw", "label": "bad", "tag": "BadMarkdown", "message": "an empty body will not parse as markdown", "channel": "die" }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:9",
      "params": ["html"],
      "channels": { "A": "the published URL", "E": [], "R": ["the S3 client"] },
      "touches": ["src/upload.ts"],
      "enteredBy": [],
      "steps": [
        { "op": "effect", "kind": "s3.put", "desc": "upload the html to the bucket", "args": { "body": "html" }, "bind": "url", "aside": "can fail and retry before it succeeds" },
        { "op": "return", "expr": "url" }
      ]
    }
  },
  "presets": [
    {
      "name": "the happy path",
      "blurb": "A real draft renders cleanly and the upload succeeds on its second attempt.",
      "input": { "draftId": "d-1" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft from the store", "status": "ok", "result": { "id": "d-1", "body": "# Hello World\n\nA real draft body." } },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "return", "at": 2, "value": "<h1>Hello World</h1><p>A real draft body.</p>" },
          { "k": "move", "at": 5, "next": 7 },
          { "k": "call", "at": 7, "to": "uploadHtml" },
          { "k": "effect", "at": 0, "kind": "s3.put", "desc": "upload the html to the bucket", "status": "failed", "error": "ETIMEDOUT", "attempt": 1 },
          { "k": "effect", "at": 0, "kind": "s3.put", "desc": "upload the html to the bucket", "status": "ok", "result": { "url": "https://cdn.example.com/posts/d-1.html" }, "attempt": 2 },
          { "k": "return", "at": 1, "value": "https://cdn.example.com/posts/d-1.html" },
          { "k": "return", "at": 8, "value": "https://cdn.example.com/posts/d-1.html" },
          { "k": "done", "result": "https://cdn.example.com/posts/d-1.html" }
        ]
      }
    },
    {
      "name": "bad markdown",
      "blurb": "The render throws BadMarkdown, publishPost catches it, and the plain-text fallback uploads.",
      "input": { "draftId": "d-2" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft from the store", "status": "ok", "result": { "id": "d-2", "body": "" } },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "move", "at": 1, "next": 3 },
          { "k": "raise", "at": 3, "tag": "BadMarkdown", "message": "an empty body will not parse as markdown", "channel": "die" },
          { "k": "unwind" },
          { "k": "handled", "at": 6, "goto": "fallback" },
          { "k": "move", "at": 6, "next": 7 },
          { "k": "call", "at": 7, "to": "uploadHtml" },
          { "k": "effect", "at": 0, "kind": "s3.put", "desc": "upload the html to the bucket", "status": "ok", "result": { "url": "https://cdn.example.com/posts/d-2.html" } },
          { "k": "return", "at": 1, "value": "https://cdn.example.com/posts/d-2.html" },
          { "k": "return", "at": 8, "value": "https://cdn.example.com/posts/d-2.html" },
          { "k": "done", "result": "https://cdn.example.com/posts/d-2.html" }
        ]
      }
    }
  ],
  "sheet": { "scopeRule": "one graph per entry point", "graphsNotDrawn": [] }
}
