{
  "id": "blog-publish",
  "title": "Blog · publish a post",
  "blurb": "Publish a blog post by rendering markdown to HTML and uploading to S3. The upload retries on failure, and markdown errors fall back to plain-text HTML.",
  "entry": "publishPost",
  "env": {},
  "files": [
    {
      "path": "src/publish.ts",
      "change": "edit",
      "why": "the publish logic and markdown error handler",
      "adds": 40,
      "dels": 6
    },
    {
      "path": "src/render.ts",
      "change": "new",
      "why": "the markdown to HTML converter",
      "adds": 55,
      "dels": 0
    },
    {
      "path": "src/upload.ts",
      "change": "edit",
      "why": "the S3 upload for published HTML",
      "adds": 18,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "nodes": {
        "uploadHtml": {
          "R": ["a fake bucket · publish.test.ts:31"]
        }
      }
    }
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "io",
      "loc": "src/publish.ts:10",
      "params": ["draftId"],
      "channels": {
        "A": "the published URL",
        "E": ["EmptyDraft"],
        "R": ["the draft store"]
      },
      "touches": ["src/publish.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "publish a blog post to the web"
        },
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft",
          "args": { "id": "draftId" },
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "draft is not empty",
          "then": "checkRender",
          "else": "empty"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "EmptyDraft",
          "message": "cannot publish an empty draft",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "checkRender",
          "target": "renderHtml",
          "args": { "draft": "draft" },
          "bind": "html",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback"
            }
          ]
        },
        {
          "op": "call",
          "label": "upload",
          "target": "uploadHtml",
          "args": { "html": "html" },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "<html><body><pre>Markdown failed to render</pre></body></html>"
        },
        {
          "op": "goto",
          "to": "upload"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:5",
      "params": ["draft"],
      "channels": {
        "A": "the rendered HTML",
        "E": ["BadMarkdown"],
        "R": []
      },
      "touches": ["src/render.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "convert markdown draft to HTML"
        },
        {
          "op": "if",
          "cond": "draft body is not empty",
          "then": "parse",
          "else": "emptyBody"
        },
        {
          "op": "return",
          "label": "emptyBody",
          "expr": "<html><body></body></html>"
        },
        {
          "op": "throw",
          "label": "parse",
          "tag": "BadMarkdown",
          "message": "markdown parsing failed",
          "channel": "die"
        }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:8",
      "params": ["html"],
      "channels": {
        "A": "the published URL",
        "E": [],
        "R": ["the S3 client"]
      },
      "touches": ["src/upload.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "note",
          "note": "upload the HTML to S3"
        },
        {
          "op": "effect",
          "kind": "s3.put",
          "desc": "upload HTML to S3",
          "args": { "body": "html" },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    }
  },
  "presets": [
    {
      "name": "happy path",
      "blurb": "The draft is valid, markdown renders successfully, and the upload succeeds on the second attempt.",
      "input": {
        "draftId": "draft-1"
      },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft", "status": "ok", "result": { "body": "# My Blog Post\n\nThis is content." } },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml" },
          { "k": "enter", "node": "renderHtml" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "move", "at": 1, "next": 3 },
          { "k": "return", "at": 3, "value": "<html><body><h1>My Blog Post</h1><p>This is content.</p></body></html>" },
          { "k": "move", "at": 4, "next": 5 },
          { "k": "call", "at": 5, "to": "uploadHtml" },
          { "k": "enter", "node": "uploadHtml" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "s3.put", "desc": "upload HTML to S3", "status": "failed", "error": "connection timeout", "attempt": 1 },
          { "k": "effect", "at": 1, "kind": "s3.put", "desc": "upload HTML to S3", "status": "ok", "result": { "url": "https://s3.example.com/published/xyz123" }, "attempt": 2 },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "return", "at": 2, "value": "https://s3.example.com/published/xyz123" },
          { "k": "move", "at": 5, "next": 6 },
          { "k": "return", "at": 6, "value": "https://s3.example.com/published/xyz123" },
          { "k": "done", "result": "https://s3.example.com/published/xyz123" }
        ]
      }
    },
    {
      "name": "bad markdown",
      "blurb": "The markdown fails to parse, the handler catches it, and plain-text HTML uploads successfully.",
      "input": {
        "draftId": "draft-2"
      },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft", "status": "ok", "result": { "body": "# Invalid [[[Markdown" } },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml" },
          { "k": "enter", "node": "renderHtml" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "move", "at": 1, "next": 3 },
          { "k": "raise", "at": 3, "tag": "BadMarkdown", "message": "markdown parsing failed", "channel": "die" },
          { "k": "unwind" },
          { "k": "handled", "at": 7, "goto": "fallback" },
          { "k": "move", "at": 7, "next": 8 },
          { "k": "move", "at": 8, "next": 5 },
          { "k": "call", "at": 5, "to": "uploadHtml" },
          { "k": "enter", "node": "uploadHtml" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "s3.put", "desc": "upload HTML to S3", "status": "ok", "result": { "url": "https://s3.example.com/published/fallback123" } },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "return", "at": 2, "value": "https://s3.example.com/published/fallback123" },
          { "k": "move", "at": 5, "next": 6 },
          { "k": "return", "at": 6, "value": "https://s3.example.com/published/fallback123" },
          { "k": "done", "result": "https://s3.example.com/published/fallback123" }
        ]
      }
    }
  ],
  "sheet": {
    "scopeRule": "one entry point per public API",
    "graphsNotDrawn": []
  }
}
