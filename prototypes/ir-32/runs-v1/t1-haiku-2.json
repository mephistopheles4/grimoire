{
  "id": "blog-publish",
  "title": "Publish a blog post",
  "blurb": "Publish a draft blog post by rendering markdown and uploading to S3. Handles empty drafts and markdown parse failures with a plain-text fallback.",
  "entry": "publishPost",
  "env": {},
  "files": [
    {
      "path": "src/publish.ts",
      "change": "edit",
      "why": "main publish logic with error handling for empty and malformed drafts",
      "adds": 40,
      "dels": 6
    },
    {
      "path": "src/render.ts",
      "change": "new",
      "why": "markdown rendering from draft body",
      "adds": 55,
      "dels": 0
    },
    {
      "path": "src/upload.ts",
      "change": "edit",
      "why": "S3 upload with retry logic",
      "adds": 18,
      "dels": 2
    }
  ],
  "layers": {
    "production": { "nodes": {} },
    "tests": {
      "nodes": {
        "uploadHtml": {
          "R": ["a fake bucket · publish.test.ts:31"]
        }
      }
    }
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:8",
      "params": ["draftId"],
      "channels": {
        "A": "the published URL",
        "E": ["EmptyDraft", "BadMarkdown"],
        "R": ["the draft store"]
      },
      "touches": ["src/publish.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "publish a blog post from a draft, with error handling for empty or malformed content"
        },
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft",
          "args": { "id": "draftId" },
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "draft is empty",
          "then": "throw-empty",
          "else": "render"
        },
        {
          "op": "throw",
          "label": "throw-empty",
          "tag": "EmptyDraft",
          "message": "no draft found",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "render",
          "target": "renderHtml",
          "args": { "draft": "draft" },
          "bind": "html",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback",
              "bind": "error"
            }
          ]
        },
        {
          "op": "call",
          "label": "upload",
          "target": "uploadHtml",
          "args": { "html": "html" },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "plain-text version of draft.body"
        },
        {
          "op": "goto",
          "to": "upload"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:3",
      "params": ["draft"],
      "channels": {
        "A": "rendered HTML string",
        "E": ["BadMarkdown"],
        "R": []
      },
      "touches": ["src/render.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "render draft markdown to HTML"
        },
        {
          "op": "if",
          "cond": "draft.body is empty",
          "then": "empty",
          "else": "success"
        },
        {
          "op": "return",
          "label": "success",
          "expr": "HTML rendered from draft.body"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "BadMarkdown",
          "message": "body is empty",
          "channel": "die"
        }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:12",
      "params": ["html"],
      "channels": {
        "A": "the published URL",
        "E": [],
        "R": ["the S3 client"]
      },
      "touches": ["src/upload.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "note",
          "note": "upload rendered HTML to S3 bucket"
        },
        {
          "op": "effect",
          "kind": "s3.put",
          "desc": "upload HTML to S3",
          "args": { "body": "html" },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    }
  },
  "presets": [
    {
      "name": "happy path",
      "blurb": "Draft exists, markdown renders cleanly, upload succeeds on the second attempt.",
      "input": { "draftId": "d-1" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft", "status": "ok", "result": { "body": "# Hello\n\nWelcome to my blog." } },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "return", "at": 2, "value": "<h1>Hello</h1>\n<p>Welcome to my blog.</p>" },
          { "k": "move", "at": 4, "next": 5 },
          { "k": "call", "at": 5, "to": "uploadHtml" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "s3.put", "desc": "upload HTML to S3", "status": "failed", "error": "network timeout", "attempt": 1 },
          { "k": "effect", "at": 1, "kind": "s3.put", "desc": "upload HTML to S3", "status": "ok", "result": "https://s3.amazonaws.com/blog/post-1", "attempt": 2 },
          { "k": "return", "at": 2, "value": "https://s3.amazonaws.com/blog/post-1" },
          { "k": "move", "at": 5, "next": 6 },
          { "k": "return", "at": 6, "value": "https://s3.amazonaws.com/blog/post-1" },
          { "k": "done", "result": "https://s3.amazonaws.com/blog/post-1" }
        ]
      }
    },
    {
      "name": "bad markdown",
      "blurb": "Markdown rendering fails, handler catches it, and the fallback plain-text HTML uploads.",
      "input": { "draftId": "d-2" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft", "status": "ok", "result": { "body": "### ]][ incomplete markdown" } },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "raise", "at": 3, "tag": "BadMarkdown", "message": "failed to parse markdown: unexpected end of input", "channel": "die" },
          { "k": "unwind" },
          { "k": "handled", "at": 7, "goto": "fallback" },
          { "k": "move", "at": 7, "next": 8 },
          { "k": "move", "at": 8, "next": 5 },
          { "k": "call", "at": 5, "to": "uploadHtml" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "s3.put", "desc": "upload HTML to S3", "status": "ok", "result": "https://s3.amazonaws.com/blog/post-2-fallback" },
          { "k": "return", "at": 2, "value": "https://s3.amazonaws.com/blog/post-2-fallback" },
          { "k": "move", "at": 5, "next": 6 },
          { "k": "return", "at": 6, "value": "https://s3.amazonaws.com/blog/post-2-fallback" },
          { "k": "done", "result": "https://s3.amazonaws.com/blog/post-2-fallback" }
        ]
      }
    }
  ],
  "sheet": {
    "scopeRule": "one graph per entry point",
    "graphsNotDrawn": []
  }
}
