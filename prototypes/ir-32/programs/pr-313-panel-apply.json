  "nodes": {
    "applySettings": {
      "name": "applySettings — woodwork slice",
      "loc": "packages/site/src/shelf/scene.ts:2225",
      "params": [
        "mountedWith",
        "current",
        "next",
        "built"
      ],
      "channels": {
        "A": "ApplyReport",
        "E": [],
        "R": [
          "THREE",
          "woodwork.ts"
        ]
      },
      "steps": [
        {
          "op": "note",
          "note": "Five report lists. applied / needsRebuild / needsReload / refused are transitions; resolved is a statement."
        },
        {
          "op": "let",
          "name": "applied",
          "expr": "[]"
        },
        {
          "op": "let",
          "name": "needsRebuild",
          "expr": "[]"
        },
        {
          "op": "let",
          "name": "refused",
          "expr": "[]"
        },
        {
          "op": "if",
          "cond": "current.materials.woodFibre !== next.materials.woodFibre",
          "then": "fibre",
          "else": "holdFibre"
        },
        {
          "op": "call",
          "label": "fibre",
          "target": "applyWoodFibre",
          "args": {
            "scale": "next.materials.woodFibre",
            "lay": "built.lay"
          },
          "bind": "fibreInForce",
          "aside": "laid by the sheet the shelf was BUILT with, not by the module's default constant"
        },
        {
          "op": "if",
          "cond": "fibreInForce === next.materials.woodFibre",
          "then": "fibreOk",
          "else": "fibreNo"
        },
        {
          "op": "let",
          "label": "fibreOk",
          "name": "applied",
          "expr": "applied.concat('wood fibre: ' + current.materials.woodFibre + ' → ' + fibreInForce)"
        },
        {
          "op": "goto",
          "to": "species"
        },
        {
          "op": "let",
          "label": "fibreNo",
          "name": "refused",
          "expr": "refused.concat('wood fibre: there is no canvas to draw it on, so the woodwork stays smooth')"
        },
        {
          "op": "goto",
          "to": "species"
        },
        {
          "op": "let",
          "label": "holdFibre",
          "name": "fibreInForce",
          "expr": "built.fibre",
          "aside": "not applied and not asked for — but still reported, so a fibre that never bound says so on every apply after the one that discovered it"
        },
        {
          "op": "call",
          "label": "species",
          "target": "speciesPending",
          "args": {
            "built": "mountedWith.materials.woodSpecies",
            "wanted": "next.materials.woodSpecies"
          },
          "bind": "pending"
        },
        {
          "op": "if",
          "cond": "pending",
          "then": "rebuild",
          "else": "readback"
        },
        {
          "op": "let",
          "label": "rebuild",
          "name": "needsRebuild",
          "expr": "needsRebuild.concat('woodwork sheet: ' + built.species + ' → ' + next.materials.woodSpecies)"
        },
        {
          "op": "call",
          "label": "readback",
          "target": "resolveWoodwork",
          "args": {
            "requested": "next.materials.woodSpecies"
          },
          "bind": "wanted",
          "aside": "resolved from `next`, NOT read off woodwork.resolved — the two differ exactly when a species change is waiting for a rebuild, and a typo has to reach the report when the value is set rather than one rebuild later"
        },
        {
          "op": "call",
          "target": "describeWoodwork",
          "args": {
            "wanted": "wanted",
            "built": "built.species",
            "fibreInForce": "fibreInForce",
            "fibreAsked": "next.materials.woodFibre"
          },
          "bind": "readBack"
        },
        {
          "op": "return",
          "expr": "({ applied, needsRebuild, refused: refused.concat(readBack.refused), resolved: readBack.resolved })"
        }
      ],
      "role": "handler",
      "enteredBy": [],
      "touches": []
    },
    "speciesPending": {
      "name": "speciesPending",
      "loc": "packages/site/src/shelf/woodwork.ts:482",
      "params": [
        "built",
        "wanted"
      ],
      "channels": {
        "A": "boolean",
        "E": [],
        "R": []
      },
      "steps": [
        {
          "op": "note",
          "note": "Compared AFTER resolution, never as raw strings: everything off-roster resolves to the default, so walnut and rosewood name one shelf. Comparing the requests would offer a rebuild for a change a rebuild cannot make."
        },
        {
          "op": "call",
          "target": "resolveWoodwork",
          "args": {
            "requested": "built"
          },
          "bind": "a"
        },
        {
          "op": "call",
          "target": "resolveWoodwork",
          "args": {
            "requested": "wanted"
          },
          "bind": "b"
        },
        {
          "op": "return",
          "expr": "a.species !== b.species"
        }
      ],
      "role": "pure",
      "enteredBy": [],
      "touches": []
    },
    "resolveWoodwork": {
      "name": "resolveWoodwork",
      "loc": "packages/site/src/shelf/woodwork.ts:432",
      "params": [
        "requested"
      ],
      "channels": {
        "A": "ResolvedWoodwork",
        "E": [],
        "R": []
      },
      "steps": [
        {
          "op": "let",
          "name": "species",
          "expr": "$env.roster.find((n) => n === requested) ?? null"
        },
        {
          "op": "if",
          "cond": "species === null",
          "then": "off",
          "else": "on"
        },
        {
          "op": "return",
          "label": "off",
          "expr": "({ species: $env.default, sheet: $env.sheets[$env.default], lay: $env.sheets[$env.default], refused: 'woodwork sheet: \"' + requested + '\" is not a sheet anybody has rendered, so the woodwork is showing ' + $env.default + '. The roster is ' + $env.roster.join(', ') })"
        },
        {
          "op": "let",
          "label": "on",
          "name": "sheet",
          "expr": "$env.sheets[species] ?? null"
        },
        {
          "op": "return",
          "expr": "({ species, sheet, lay: sheet ?? $env.sheets[$env.default], refused: null })"
        }
      ],
      "role": "pure",
      "enteredBy": [],
      "touches": []
    },
    "describeWoodwork": {
      "name": "describeWoodwork",
      "loc": "packages/site/src/shelf/woodwork.ts:539",
      "params": [
        "wanted",
        "built",
        "fibreInForce",
        "fibreAsked"
      ],
      "channels": {
        "A": "WoodworkReadBack",
        "E": [],
        "R": []
      },
      "steps": [
        {
          "op": "note",
          "note": "Pure, and in a module with no Three.js in it, so G54 can assert on it without a WebGL context."
        },
        {
          "op": "let",
          "name": "sheet",
          "expr": "wanted.sheet === null ? 'no map — the mean-matched flat twin' : wanted.sheet.url + ', laid at ' + wanted.lay.unitsPerTile + ' world units'"
        },
        {
          "op": "let",
          "name": "waiting",
          "expr": "wanted.species === built ? '' : ' — built with ' + built + ', rebuild to change it'"
        },
        {
          "op": "let",
          "name": "lines",
          "expr": "['woodwork sheet: ' + wanted.species + ' (' + sheet + ')' + waiting, 'wood fibre: ' + fibreInForce + (fibreInForce === fibreAsked ? '' : ' (asked for ' + fibreAsked + ')')]",
          "aside": "G54's first draft matched the species by bare substring and was green on a read-back naming no species at all — rosewood and sapele each appear inside their own URL. Anchoring to `woodwork sheet: <name> (` reddened six clauses."
        },
        {
          "op": "return",
          "expr": "({ resolved: lines, refused: wanted.refused === null ? [] : [wanted.refused] })",
          "aside": "refused AND reported, never silently defaulted"
        }
      ],
      "role": "pure",
      "enteredBy": [],
      "touches": []
    },
    "applyWoodFibre": {
      "name": "applyWoodFibre",
      "loc": "packages/site/src/shelf/woodwork.ts:1246",
      "params": [
        "scale",
        "lay"
      ],
      "channels": {
        "A": "number — the scale in force",
        "E": [],
        "R": [
          "CanvasTexture"
        ]
      },
      "steps": [
        {
          "op": "let",
          "name": "tiles",
          "expr": "lay.unitsPerTile / 0.5"
        },
        {
          "op": "effect",
          "kind": "canvas.bake",
          "desc": "bake the 256-square fibre",
          "args": "({ tiles })",
          "bind": "map"
        },
        {
          "op": "if",
          "cond": "map === null",
          "then": "nocanvas",
          "else": "ok"
        },
        {
          "op": "return",
          "label": "ok",
          "expr": "scale"
        },
        {
          "op": "note",
          "label": "nocanvas",
          "note": "no 2D context — the caller reports refused, never silently smooth"
        },
        {
          "op": "return",
          "expr": "0"
        }
      ],
      "role": "io",
      "enteredBy": [],
      "touches": []
    }
