    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "entry": "importContacts",
      "nodes": {
        "fetchUpload": {
          "R": ["a fixture directory · contacts.test.ts:9"]
        },
        "saveContact": {
          "R": ["an in-memory list · contacts.test.ts:22"]
        }
      }
    }
  },
  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:1",
      "params": ["uploadId"],
      "channels": {
        "A": "object with saved and skipped counts",
        "E": ["BadCsv", "NoUpload"],
        "R": ["the metrics service"]
      },
      "touches": ["src/import/contacts.ts"],
      "enteredBy": ["src/import/contacts.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "import a CSV of contacts"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {"id": "uploadId"},
          "bind": "bytes"
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {"csv": "bytes"},
          "bind": "rows"
        },
        {
          "op": "let",
          "label": "loop",
          "name": "processed",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "if",
          "cond": "processed < rows.length",
          "then": "continue",
          "else": "metrics"
        },
        {
          "op": "call",
          "label": "continue",
          "target": "saveContact",
          "args": {"row": "rows[processed]"},
          "bind": "contact",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip",
              "bind": "dupError"
            }
          ]
        },
        {
          "op": "let",
          "name": "processed",
          "expr": "processed + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "let",
          "name": "processed",
          "expr": "processed + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "effect",
          "label": "metrics",
          "kind": "metrics.write",
          "desc": "write import metrics",
          "args": {"saved": "processed - skipped", "skipped": "skipped"}
        },
        {
          "op": "return",
          "expr": "{saved: processed - skipped, skipped: skipped}"
        }
      ]
    },
    "fetchUpload": {
      "name": "fetchUpload",
      "role": "io",
      "loc": "src/import/fetch.ts:1",
      "params": ["uploadId"],
      "channels": {
        "A": "raw CSV bytes",
        "E": ["NoUpload"],
        "R": ["the S3 client"]
      },
      "touches": ["src/import/fetch.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.get",
          "desc": "fetch the upload",
          "args": {"id": "uploadId"},
          "bind": "data"
        },
        {
          "op": "if",
          "cond": "data exists",
          "then": "found",
          "else": "missing"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "data"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoUpload",
          "message": "upload not found",
          "channel": "escape"
        }
      ]
    },
    "parseRows": {
      "name": "parseRows",
      "role": "pure",
      "loc": "src/import/parse.ts:1",
      "params": ["csv"],
      "channels": {
        "A": "a list of row objects",
        "E": ["BadCsv"],
        "R": []
      },
      "touches": ["src/import/parse.ts"],
      "enteredBy": ["src/import/contacts.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "parse CSV into rows"
        },
        {
          "op": "let",
          "name": "lines",
          "expr": "csv.split('\\n')"
        },
        {
          "op": "if",
          "cond": "header line is valid",
          "then": "valid",
          "else": "bad"
        },
        {
          "op": "return",
          "label": "valid",
          "expr": "lines.slice(1).map(parseRow)"
        },
        {
          "op": "throw",
          "label": "bad",
          "tag": "BadCsv",
          "message": "invalid header",
          "channel": "die"
        }
      ]
    },
    "saveContact": {
      "name": "saveContact",
      "role": "io",
      "loc": "src/contacts/save.ts:1",
      "params": ["row"],
      "channels": {
        "A": "the inserted contact",
        "E": ["Duplicate"],
        "R": ["the contacts table"]
      },
      "touches": ["src/contacts/save.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "note",
          "note": "save a single contact"
        },
        {
          "op": "call",
          "target": "normalise",
          "args": {"row": "row"},
          "bind": "cleaned"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "insert the contact",
          "args": {"contact": "cleaned"},
          "bind": "contact"
        },
        {
          "op": "return",
          "expr": "contact"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
      "role": "pure",
      "loc": "src/contacts/normalise.ts:1",
      "params": ["row"],
      "channels": {
        "A": "the cleaned row object",
        "E": [],
        "R": []
      },
      "touches": ["src/contacts/normalise.ts"],
      "enteredBy": ["src/contacts/normalise.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "clean and normalize contact data"
        },
        {
          "op": "let",
          "name": "result",
          "expr": "{name: row.name.trim(), email: row.email.toLowerCase()}"
        },
        {
          "op": "return",
          "expr": "result"
        }
      ]
    }
  },
