    },
    {
      "path": "src/import/parse.ts",
      "change": "new",
      "why": "parse CSV rows from bytes",
      "adds": 41,
      "dels": 0
    },
    {
      "path": "src/import/fetch.ts",
      "change": "new",
      "why": "fetch the upload from S3",
      "adds": 19,
      "dels": 0
    },
    {
      "path": "src/contacts/save.ts",
      "change": "edit",
      "why": "save individual contacts",
      "adds": 33,
      "dels": 7
    },
    {
      "path": "src/contacts/normalise.ts",
      "change": "edit",
      "why": "clean contact data before saving",
      "adds": 14,
