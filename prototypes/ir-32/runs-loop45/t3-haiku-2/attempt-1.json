{
  "id": "csv-import",
  "title": "CSV import with loop and error handling",
  "blurb": "Load a CSV of contacts into the address book. The import fetches the file, parses its rows, loops to save each contact, handles duplicates by skipping, and reports counts.",
  "entry": "importContacts",
  "env": {},
  "files": [
