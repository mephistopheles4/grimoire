{
  "id": "csv-import-contacts",
  "title": "CSV import · load contacts into the address book",
  "blurb": "Loads a CSV file of contacts from S3, parses the rows, and saves each contact to the database. Handles duplicate contacts by skipping them, and raises uncaught errors for missing uploads or bad CSV headers.",
  "entry": "importContacts",
  "env": {
    "s3Client": "AWS S3 client",
    "contactsTable": "contacts database table",
    "metricsService": "metrics collection service"
  },
