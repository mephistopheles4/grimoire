      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.get",
          "desc": "fetch the CSV upload from S3",
          "args": {
            "id": "uploadId"
          },
          "bind": "bytes"
        },
        {
          "op": "if",
          "cond": "bytes is defined",
          "then": "found",
          "else": "missing"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "bytes"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoUpload",
          "message": "upload object not found",
          "channel": "escape"
        }
      ]
    },
    "parseRows": {
      "name": "parseRows",
      "role": "pure",
      "loc": "src/import/parse.ts:1",
      "params": [
        "bytes"
      ],
      "channels": {
        "A": "list of parsed rows",
        "E": [
          "BadCsv"
        ],
        "R": []
      },
      "touches": [
        "src/import/parse.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "lines",
          "expr": "bytes.split('\\n')"
        },
        {
          "op": "let",
          "name": "header",
          "expr": "lines[0].split(',')"
        },
        {
          "op": "if",
          "cond": "header includes required fields",
          "then": "valid",
          "else": "invalid"
        },
        {
          "op": "let",
          "label": "valid",
          "name": "rows",
          "expr": "parse remaining lines into row objects"
        },
        {
          "op": "return",
          "expr": "rows"
        },
        {
          "op": "throw",
          "label": "invalid",
          "tag": "BadCsv",
          "message": "CSV header is missing required fields",
          "channel": "die"
        }
      ]
    },
    "saveContact": {
      "name": "saveContact",
      "role": "io",
      "loc": "src/contacts/save.ts:1",
      "params": [
        "row"
      ],
      "channels": {
        "A": "the saved contact id",
        "E": [
          "Duplicate"
        ],
        "R": [
          "the contacts table"
        ]
      },
      "touches": [
        "src/contacts/save.ts",
        "src/contacts/normalise.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "normalise",
          "args": {
            "row": "row"
          },
          "bind": "cleaned"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "insert the contact row",
          "args": {
            "contact": "cleaned"
          },
          "bind": "contactId"
        },
        {
          "op": "if",
          "cond": "insert succeeded",
          "then": "saved",
          "else": "exists"
        },
        {
          "op": "return",
          "label": "saved",
          "expr": "contactId"
        },
        {
          "op": "throw",
          "label": "exists",
          "tag": "Duplicate",
          "message": "contact already exists",
          "channel": "retry"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
      "role": "pure",
      "loc": "src/contacts/normalise.ts:1",
      "params": [
        "row"
      ],
      "channels": {
        "A": "the cleaned contact row",
        "E": [],
        "R": []
      },
      "touches": [
        "src/contacts/normalise.ts"
      ],
      "enteredBy": [
        "src/contacts/normalise.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "cleaned",
          "expr": "trim whitespace and normalize fields"
        },
        {
          "op": "return",
          "expr": "cleaned"
        }
      ]
    }
  },
