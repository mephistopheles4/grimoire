  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:1",
      "params": [
        "uploadId"
      ],
      "channels": {
        "A": "an object with saved and skipped row counts",
        "E": [
          "BadCsv",
          "NoUpload"
        ],
        "R": [
          "the S3 client",
          "the contacts table",
          "metrics service"
        ]
      },
      "touches": [
        "src/import/contacts.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "load CSV of contacts from S3, parse and save each one"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {
            "uploadId": "uploadId"
          },
          "bind": "bytes",
          "onError": [
            {
              "tag": "NoUpload",
              "goto": "error_no_upload"
            }
          ]
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {
            "bytes": "bytes"
          },
          "bind": "rows",
          "onError": [
            {
              "tag": "BadCsv",
              "goto": "error_bad_csv"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "let",
          "label": "loop_start",
          "name": "remaining",
          "expr": "rows"
        },
        {
          "op": "if",
          "cond": "remaining.length > 0",
          "then": "process",
          "else": "write_metrics"
        },
        {
          "op": "let",
          "label": "process",
          "name": "row",
          "expr": "remaining[0]"
        },
        {
          "op": "call",
          "target": "saveContact",
          "args": {
            "row": "row"
          },
          "bind": "contactId",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip_row"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "let",
          "name": "remaining",
          "expr": "remaining.slice(1)"
        },
        {
          "op": "goto",
          "to": "loop_start"
        },
        {
          "op": "let",
          "label": "skip_row",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "let",
          "name": "remaining",
          "expr": "remaining.slice(1)"
        },
        {
          "op": "goto",
          "to": "loop_start"
        },
        {
          "op": "effect",
          "label": "write_metrics",
          "kind": "metrics.write",
          "desc": "record import completion metrics"
        },
        {
          "op": "return",
          "expr": "{ saved, skipped }"
        },
        {
          "op": "throw",
          "label": "error_no_upload",
          "tag": "NoUpload",
          "message": "upload not found in S3",
          "channel": "escape"
        },
        {
          "op": "throw",
          "label": "error_bad_csv",
          "tag": "BadCsv",
          "message": "CSV header line is invalid",
          "channel": "die"
        }
      ]
    },
    "fetchUpload": {
      "name": "fetchUpload",
      "role": "io",
      "loc": "src/import/fetch.ts:1",
      "params": [
        "uploadId"
      ],
      "channels": {
        "A": "raw bytes of the upload",
        "E": [
          "NoUpload"
        ],
        "R": [
