          "op": "if",
          "cond": "row exists",
          "then": "found",
          "else": "missing"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "row"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoCart",
          "message": "cart not found",
          "channel": "escape"
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:1",
      "params": ["cart"],
      "channels": {
        "A": "the total in pence",
        "E": [],
        "R": []
      },
      "touches": ["src/pricing.ts"],
      "enteredBy": ["src/pricing.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loop",
          "cond": "cart.items has remaining items",
          "then": "process",
          "else": "done"
        },
        {
          "op": "let",
          "label": "process",
          "name": "total",
          "expr": "total + currentItem.price"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "return",
          "label": "done",
          "expr": "total"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:1",
      "params": ["total"],
      "channels": {
        "A": "the order id",
        "E": ["CardDeclined"],
        "R": ["the Stripe client"]
      },
      "touches": ["src/payments.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the customer",
          "args": {"amount": "total"},
          "bind": "response"
        },
        {
          "op": "if",
          "cond": "response.success",
          "then": "ok",
          "else": "fail"
        },
        {
          "op": "return",
          "label": "ok",
          "expr": "response.orderId"
        },
        {
          "op": "throw",
          "label": "fail",
          "tag": "CardDeclined",
          "message": "card was declined",
          "channel": "retry"
        }
      ]
    }
