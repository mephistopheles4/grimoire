  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:5",
      "params": [
        "uploadId"
      ],
      "channels": {
        "A": "a count of saved and skipped rows",
        "E": [
          "NoUpload",
          "BadCsv"
        ],
        "R": []
      },
      "touches": [
        "src/import/contacts.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "import a CSV of contacts into the address book"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {
            "uploadId": "uploadId"
          },
          "bind": "bytes"
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {
            "bytes": "bytes"
          },
          "bind": "rows"
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "note",
          "label": "loopStart",
          "note": "process each row"
        },
        {
          "op": "if",
          "cond": "rows is empty",
          "then": "loopEnd",
          "else": "saveRow"
        },
        {
          "op": "call",
          "label": "saveRow",
          "target": "saveContact",
          "args": {
            "row": "rows[0]"
          },
          "bind": "contact",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "next"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "let",
          "label": "next",
          "name": "rows",
          "expr": "rows.slice(1)"
        },
        {
          "op": "goto",
          "to": "loopStart"
        },
        {
          "op": "effect",
          "label": "loopEnd",
          "kind": "metrics.write",
          "desc": "write the import metrics",
          "args": {
            "saved": "saved",
            "skipped": "skipped"
          }
        },
        {
          "op": "return",
          "expr": "{saved, skipped}"
        }
      ]
    },
    "fetchUpload": {
      "name": "fetchUpload",
      "role": "io",
      "loc": "src/import/fetch.ts:3",
      "params": [
        "uploadId"
      ],
      "channels": {
        "A": "the raw bytes",
        "E": [
          "NoUpload"
        ],
        "R": [
          "the S3 client"
        ]
      },
      "touches": [
        "src/import/fetch.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.get",
          "desc": "fetch the upload",
          "args": {
            "uploadId": "uploadId"
          },
          "bind": "obj"
        },
        {
          "op": "if",
          "cond": "obj is missing",
          "then": "missing",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "obj.bytes"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoUpload",
          "message": "upload not found",
          "channel": "escape"
        }
      ]
    },
    "parseRows": {
      "name": "parseRows",
      "role": "pure",
      "loc": "src/import/parse.ts:2",
      "params": [
        "bytes"
      ],
      "channels": {
        "A": "a list of rows",
        "E": [
          "BadCsv"
        ],
        "R": []
      },
      "touches": [
        "src/import/parse.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "lines",
          "expr": "bytes.split('\\n')"
        },
        {
          "op": "let",
          "name": "header",
          "expr": "lines[0].split(',')"
        },
        {
          "op": "if",
          "cond": "header is valid",
          "then": "parseData",
          "else": "badCsv"
        },
        {
          "op": "let",
          "label": "parseData",
          "name": "rows",
          "expr": "lines.slice(1).map(line => parse(line))"
        },
        {
          "op": "return",
          "expr": "rows"
        },
        {
          "op": "throw",
          "label": "badCsv",
          "tag": "BadCsv",
          "message": "invalid header",
          "channel": "die"
        }
      ]
    },
    "saveContact": {
      "name": "saveContact",
      "role": "io",
      "loc": "src/contacts/save.ts:8",
      "params": [
        "row"
      ],
      "channels": {
        "A": "the saved contact",
        "E": [
          "Duplicate"
        ],
        "R": [
          "the contacts table"
        ]
      },
      "touches": [
        "src/contacts/save.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "normalise",
          "args": {
            "row": "row"
          },
          "bind": "cleaned"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "insert the contact",
          "args": {
            "data": "cleaned"
          },
          "bind": "contact"
        },
        {
          "op": "return",
          "expr": "contact"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
      "role": "pure",
      "loc": "src/contacts/normalise.ts:1",
      "params": [
        "row"
      ],
      "channels": {
        "A": "the cleaned row",
        "E": [],
        "R": []
      },
      "touches": [
        "src/contacts/normalise.ts"
      ],
      "enteredBy": [
        "src/contacts/normalise.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "cleaned",
          "expr": "trim(row)"
        },
        {
          "op": "return",
          "expr": "cleaned"
        }
      ]
    }
  },
