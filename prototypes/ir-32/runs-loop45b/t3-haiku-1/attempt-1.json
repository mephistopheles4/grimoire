{
  "id": "csv-import",
  "title": "CSV import · load contacts into the address book",
  "blurb": "The importContacts function loads a CSV of contacts into the address book. It fetches the upload, parses the rows, loops over them to save each contact, handles duplicate key errors, and reports the count of saved and skipped rows.",
  "entry": "importContacts",
  "env": {},
  "files": [
    {
      "path": "src/import/contacts.ts",
      "change": "edit",
      "why": "holds importContacts and the main import loop logic",
      "adds": 88,
      "dels": 12
    },
    {
      "path": "src/import/parse.ts",
      "change": "new",
      "why": "holds parseRows to parse CSV header and rows",
      "adds": 41,
      "dels": 0
    },
    {
      "path": "src/import/fetch.ts",
      "change": "new",
      "why": "holds fetchUpload to retrieve the raw bytes from S3",
      "adds": 19,
      "dels": 0
    },
    {
      "path": "src/contacts/save.ts",
      "change": "edit",
      "why": "holds saveContact to insert contacts into the database",
      "adds": 33,
      "dels": 7
    },
    {
      "path": "src/contacts/normalise.ts",
      "change": "edit",
      "why": "holds normalise to clean contact data before saving",
      "adds": 14,
      "dels": 2
    }
  ],
