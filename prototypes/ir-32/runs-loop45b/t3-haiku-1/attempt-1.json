      }
    }
  },
  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:1",
      "params": [
        "uploadId"
      ],
      "channels": {
        "A": "an object with saved and skipped counts",
        "E": [
          "NoUpload",
          "BadCsv"
        ],
        "R": [
          "the contacts table"
        ]
      },
      "touches": [
        "src/import/contacts.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "import contacts from an uploaded CSV file"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {
            "uploadId": "uploadId"
          },
          "bind": "bytes",
          "onError": [
            {
              "tag": "NoUpload",
              "goto": "fail"
            }
          ]
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {
            "bytes": "bytes"
          },
          "bind": "rows"
        },
        {
          "op": "let",
          "label": "loopStart",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "idx",
          "expr": "0"
        },
        {
          "op": "if",
          "cond": "idx >= rows.length",
          "then": "loopEnd",
          "else": "loopBody"
        },
        {
          "op": "call",
          "label": "loopBody",
          "target": "saveContact",
          "args": {
            "row": "rows[idx]"
          },
          "bind": "saved_",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "increment"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "let",
          "label": "increment",
          "name": "idx",
          "expr": "idx + 1"
        },
        {
          "op": "goto",
          "to": "loopStart"
        },
        {
          "op": "effect",
          "label": "loopEnd",
          "kind": "metrics.write",
          "desc": "record import metrics",
          "args": {
            "saved": "saved",
            "skipped": "skipped"
          }
        },
        {
          "op": "return",
          "expr": "{saved, skipped}"
        },
        {
          "op": "throw",
          "label": "fail",
          "tag": "NoUpload",
          "message": "upload not found",
          "channel": "escape"
        }
      ]
    },
    "fetchUpload": {
      "name": "fetchUpload",
      "role": "io",
      "loc": "src/import/fetch.ts:1",
      "params": [
        "uploadId"
      ],
      "channels": {
        "A": "the raw CSV bytes",
        "E": [
          "NoUpload"
        ],
        "R": [
          "the S3 client"
        ]
      },
      "touches": [
        "src/import/fetch.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.get",
          "desc": "fetch the upload from S3",
          "args": {
            "uploadId": "uploadId"
          },
          "bind": "obj"
        },
        {
          "op": "if",
          "cond": "obj is null",
          "then": "notFound",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "obj.bytes"
        },
        {
          "op": "throw",
          "label": "notFound",
          "tag": "NoUpload",
          "message": "object not found in S3",
          "channel": "escape"
        }
      ]
    },
    "parseRows": {
      "name": "parseRows",
      "role": "pure",
      "loc": "src/import/parse.ts:1",
      "params": [
        "bytes"
      ],
      "channels": {
        "A": "a list of parsed rows",
        "E": [
          "BadCsv"
        ],
        "R": []
      },
      "touches": [
        "src/import/parse.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "lines",
          "expr": "bytes.split('\\n')"
        },
        {
          "op": "if",
          "cond": "lines[0] is not the expected header",
          "then": "badHeader",
          "else": "goodHeader"
        },
        {
          "op": "let",
          "label": "goodHeader",
          "name": "rows",
          "expr": "lines.slice(1).map(parseRow)"
        },
        {
          "op": "return",
          "expr": "rows"
        },
        {
          "op": "throw",
          "label": "badHeader",
          "tag": "BadCsv",
          "message": "header line is wrong",
          "channel": "die"
        }
      ]
    },
    "saveContact": {
      "name": "saveContact",
      "role": "io",
      "loc": "src/contacts/save.ts:1",
      "params": [
        "row"
      ],
      "channels": {
        "A": "the saved contact id",
        "E": [
          "Duplicate"
        ],
        "R": [
          "the contacts table"
        ]
      },
      "touches": [
        "src/contacts/save.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "normalise",
          "args": {
            "row": "row"
          },
          "bind": "cleaned"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "insert the contact into the database",
          "args": {
            "contact": "cleaned"
          },
          "bind": "id"
        },
        {
          "op": "return",
          "expr": "id"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
      "role": "pure",
      "loc": "src/contacts/normalise.ts:1",
      "params": [
        "row"
      ],
      "channels": {
        "A": "the cleaned contact object",
        "E": [],
        "R": []
      },
      "touches": [
        "src/contacts/normalise.ts"
      ],
      "enteredBy": [
        "src/contacts/normalise.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "clean and normalize contact data"
        },
        {
          "op": "let",
          "name": "cleaned",
          "expr": "{name: row.name.trim(), email: row.email.toLowerCase()}"
        },
        {
          "op": "return",
          "expr": "cleaned"
        }
      ]
    }
  },
