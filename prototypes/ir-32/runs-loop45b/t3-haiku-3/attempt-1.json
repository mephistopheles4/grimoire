          "the contacts table",
          "metrics"
        ]
      },
      "touches": [
        "src/import/contacts.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "load a CSV of contacts and insert each row, skipping duplicates"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {
            "uploadId": "uploadId"
          },
          "bind": "bytes"
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {
            "bytes": "bytes"
          },
          "bind": "rows"
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "let",
          "label": "loopStart",
          "name": "row",
          "expr": "rows.shift()"
        },
        {
          "op": "if",
          "cond": "row is null",
          "then": "loopEnd",
          "else": "process"
        },
        {
          "op": "call",
          "label": "process",
          "target": "saveContact",
          "args": {
            "row": "row"
          },
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "loopStart"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "goto",
          "to": "loopStart"
        },
        {
          "op": "effect",
          "label": "loopEnd",
          "kind": "metrics.write",
          "desc": "record import counts",
          "args": {
            "saved": "saved",
            "skipped": "skipped"
          }
        },
        {
          "op": "return",
          "expr": "{ saved, skipped }"
        }
      ]
    },
