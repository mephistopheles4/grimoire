{
  "id": "csv-import",
  "title": "CSV import to address book",
  "blurb": "The importContacts function loads a CSV file of contact rows into the address book, calling through to fetch the file, parse it, and save each row with duplicate handling.",
  "entry": "importContacts",
  "env": {
    "uploadId": "upload-123"
  },
  "files": [
    {
      "path": "src/import/contacts.ts",
      "change": "edit",
      "why": "holds importContacts, which orchestrates the load, parse, and save",
      "adds": 88,
      "dels": 12
    },
    {
      "path": "src/import/parse.ts",
      "change": "new",
      "why": "new file that holds parseRows",
      "adds": 41,
      "dels": 0
    },
    {
      "path": "src/import/fetch.ts",
      "change": "new",
      "why": "new file that holds fetchUpload",
      "adds": 19,
      "dels": 0
    },
    {
      "path": "src/contacts/save.ts",
      "change": "edit",
      "why": "holds saveContact with new duplicate detection",
      "adds": 33,
      "dels": 7
    },
    {
      "path": "src/contacts/normalise.ts",
      "change": "edit",
      "why": "adds contact normalisation called before save",
      "adds": 14,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "entry": "importContacts",
      "nodes": {
        "fetchUpload": {
          "R": [
            "a fixture directory · contacts.test.ts:9"
          ]
        },
        "saveContact": {
          "R": [
            "an in-memory list · contacts.test.ts:22"
          ]
        }
      }
    }
  },
  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:5",
      "params": ["uploadId"],
      "channels": {
        "A": "an object with saved and skipped counts",
        "E": ["NoUpload", "BadCsv"],
        "R": ["the logger"]
      },
      "touches": ["src/import/contacts.ts"],
      "enteredBy": ["src/import/contacts.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "load a CSV file of contacts and save each row"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {"id": "uploadId"},
          "bind": "bytes",
          "onError": [
            {
              "tag": "NoUpload",
              "goto": "end"
            }
          ]
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {"data": "bytes"},
          "bind": "rows",
          "onError": [
            {
              "tag": "BadCsv",
              "goto": "end"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "let",
          "label": "loop",
          "name": "row",
          "expr": "rows.shift()"
        },
        {
          "op": "if",
          "cond": "row is not null",
          "then": "save",
          "else": "done"
        },
        {
          "op": "call",
          "label": "save",
          "target": "saveContact",
          "args": {"row": "row"},
          "bind": "id",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "effect",
          "label": "done",
          "kind": "metrics.write",
          "desc": "record the import result",
          "args": {"saved": "saved", "skipped": "skipped"}
        },
        {
          "op": "return",
          "expr": "{saved, skipped}"
        },
        {
          "op": "throw",
          "label": "end",
          "tag": "ImportFailed",
          "message": "import failed",
          "channel": "escape"
        }
      ]
    },
    "fetchUpload": {
      "name": "fetchUpload",
      "role": "io",
      "loc": "src/import/fetch.ts:3",
      "params": ["id"],
      "channels": {
        "A": "raw file bytes",
        "E": ["NoUpload"],
        "R": ["the S3 client"]
      },
      "touches": ["src/import/fetch.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.get",
          "desc": "fetch the uploaded file",
          "args": {"key": "id"},
          "bind": "data",
          "onError": [
            {
              "tag": "NoUpload",
              "goto": "missing"
            }
          ]
        },
        {
          "op": "return",
          "expr": "data"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoUpload",
          "message": "upload not found",
          "channel": "escape"
        }
      ]
    },
    "parseRows": {
      "name": "parseRows",
      "role": "pure",
      "loc": "src/import/parse.ts:5",
      "params": ["data"],
      "channels": {
        "A": "array of row objects",
        "E": ["BadCsv"],
        "R": []
      },
      "touches": ["src/import/parse.ts"],
      "enteredBy": ["src/import/contacts.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "lines",
          "expr": "data.split('\\n')"
        },
        {
          "op": "if",
          "cond": "header is valid",
          "then": "valid",
          "else": "invalid"
        },
        {
          "op": "let",
          "label": "valid",
          "name": "rows",
          "expr": "lines.slice(1).map(parseRow)"
        },
        {
          "op": "return",
          "expr": "rows"
        },
        {
          "op": "throw",
          "label": "invalid",
          "tag": "BadCsv",
          "message": "header line is malformed",
          "channel": "die"
        }
      ]
    },
    "saveContact": {
      "name": "saveContact",
      "role": "io",
      "loc": "src/contacts/save.ts:2",
      "params": ["row"],
      "channels": {
        "A": "the contact id",
        "E": ["Duplicate"],
        "R": ["the contacts table"]
      },
      "touches": ["src/contacts/save.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "normalise",
          "args": {"row": "row"},
          "bind": "clean"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "insert the contact row",
          "args": {"contact": "clean"},
          "bind": "id",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "dup"
            }
          ]
        },
        {
          "op": "return",
          "expr": "id"
        },
        {
          "op": "throw",
          "label": "dup",
          "tag": "Duplicate",
          "message": "contact already exists",
          "channel": "retry"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
      "role": "pure",
      "loc": "src/contacts/normalise.ts:1",
      "params": ["row"],
      "channels": {
        "A": "a cleaned row object",
        "E": [],
        "R": []
      },
      "touches": ["src/contacts/normalise.ts"],
      "enteredBy": ["src/contacts/normalise.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "cleaned",
          "expr": "trim(row)"
        },
        {
          "op": "return",
          "expr": "cleaned"
        }
      ]
    }
  },
