{
  "id": "task-2-cart",
  "title": "Checkout · the cart total",
  "blurb": "checkout(cartId) loads a cart, prices it in a pure loop, and charges the total. A zero total short-circuits to a status message, and a declined card is caught, mailed to the customer, and turned into a status message too.",
  "entry": "checkout",
  "env": {},
  "files": [
