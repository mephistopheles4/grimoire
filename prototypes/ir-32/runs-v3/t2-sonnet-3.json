  "nodes": {
    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:14",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "the order id, or a status message",
        "E": [
          "NoCart",
          "CardDeclined"
        ],
        "R": [
          "the cart table",
          "the Stripe client"
        ]
      },
      "touches": [
        "src/checkout.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "turn a cart into an order, or a status message when there's nothing to charge"
        },
        {
          "op": "call",
          "target": "loadCart",
          "args": {
            "cartId": "cartId"
          },
          "bind": "cart",
          "aside": "NoCart escapes uncaught from here"
        },
        {
          "op": "call",
          "target": "priceCart",
          "args": {
            "cart": "cart"
          },
          "bind": "total"
        },
        {
          "op": "if",
          "cond": "total is zero",
          "then": "empty",
          "else": "pay"
        },
        {
          "op": "call",
          "label": "pay",
          "target": "charge",
          "args": {
            "amount": "total"
          },
          "bind": "orderId",
          "aside": "the only call that can be declined",
          "onError": [
            {
              "tag": "CardDeclined",
              "goto": "declined",
              "bind": "why"
            }
          ]
        },
        {
          "op": "return",
          "expr": "orderId"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "tell the customer the card was declined",
          "args": {
            "to": "cart.customerEmail",
            "reason": "why"
          }
        },
        {
          "op": "return",
          "expr": "\"payment declined\""
        }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:5",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "the cart",
        "E": [
          "NoCart"
        ],
        "R": [
          "the cart table"
        ]
      },
      "touches": [
        "src/cart-store.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the cart row",
          "args": {
            "id": "cartId"
          },
          "bind": "row"
        },
        {
          "op": "if",
          "cond": "row is missing",
          "then": "missing",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "row"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoCart",
          "message": "no row for that id",
          "channel": "escape"
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:3",
      "params": [
        "cart"
      ],
      "channels": {
        "A": "the total in pence",
        "E": [],
        "R": []
      },
      "touches": [
        "src/pricing.ts"
      ],
      "enteredBy": [
        "src/pricing.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "sum every item's price while items remain"
        },
        {
          "op": "let",
          "name": "remaining",
          "expr": "cart.items"
        },
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loopTop",
          "cond": "remaining is empty",
          "then": "done",
          "else": "add"
        },
        {
          "op": "let",
          "label": "add",
          "name": "total",
          "expr": "total + head(remaining).pricePence"
        },
        {
          "op": "let",
          "name": "remaining",
          "expr": "tail(remaining)"
        },
        {
          "op": "goto",
          "to": "loopTop"
        },
        {
          "op": "return",
          "label": "done",
          "expr": "total"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:9",
      "params": [
        "amount"
      ],
      "channels": {
        "A": "the order id",
        "E": [
          "CardDeclined"
        ],
        "R": [
          "the Stripe client"
        ]
      },
      "touches": [
        "src/payments.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the card",
          "args": {
            "amount": "amount"
          },
          "bind": "result"
        },
        {
          "op": "if",
          "cond": "result was declined",
          "then": "declined",
          "else": "approved"
        },
        {
          "op": "return",
          "label": "approved",
          "expr": "result.orderId"
        },
        {
          "op": "throw",
          "label": "declined",
          "tag": "CardDeclined",
          "message": "the card was declined",
          "channel": "retry"
        }
      ]
    }
  },
