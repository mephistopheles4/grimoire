    },
    {
      "path": "src/pricing.ts",
      "change": "new",
      "why": "the new pricing loop that totals a cart in pence",
      "adds": 38,
      "dels": 0
    },
    {
      "path": "src/cart-store.ts",
      "change": "edit",
      "why": "the cart lookup that loadCart performs",
      "adds": 9,
      "dels": 1
    },
