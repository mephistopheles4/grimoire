      "steps": [
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft",
          "args": {
            "id": "draftId"
          },
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "the draft is empty",
          "then": "empty",
          "else": "render"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "EmptyDraft",
          "message": "there is no draft to publish",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "render",
          "target": "renderHtml",
          "args": {
            "draft": "draft"
          },
          "bind": "html",
          "aside": "the call that can fail with BadMarkdown",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback",
              "bind": "reason"
            }
          ]
        },
        {
          "op": "goto",
          "to": "upload"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "a plain-text version of the draft"
        },
        {
          "op": "effect",
          "label": "upload",
          "kind": "s3.put",
          "desc": "PUT the HTML to the bucket",
          "args": {
            "body": "html"
          },
          "bind": "url",
          "aside": "the effect that retries on failure"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:5",
      "params": [
        "draft"
      ],
      "channels": {
