{
  "id": "publish-post-retry",
  "title": "publishPost · render, fall back, and retry the upload",
  "blurb": "publishPost reads a draft, renders it to HTML, and uploads the result. A bad-markdown render is caught and falls back to plain text, and the upload effect can fail once and succeed on retry.",
  "entry": "publishPost",
  "env": {},
  "files": [
    {
      "path": "src/publish.ts",
      "change": "edit",
      "why": "the handler gains the render call, the bad-markdown fallback, and the upload call",
      "adds": 40,
      "dels": 6
    },
    {
      "path": "src/render.ts",
      "change": "new",
      "why": "holds the new pure renderHtml node",
      "adds": 55,
      "dels": 0
    },
    {
      "path": "src/upload.ts",
      "change": "edit",
      "why": "holds uploadHtml, the effect that can fail and retry",
      "adds": 18,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "nodes": {
        "uploadHtml": {
          "R": [
            "a fake bucket · publish.test.ts:31"
          ]
        }
      }
    }
  },
  "nodes": {
