      ],
      "steps": [
        {
          "op": "if",
          "cond": "the draft body is empty or does not parse as markdown",
          "then": "bad",
          "else": "ok"
        },
        {
          "op": "return",
          "label": "ok",
          "expr": "the HTML rendered from draft.body"
        },
        {
          "op": "throw",
          "label": "bad",
