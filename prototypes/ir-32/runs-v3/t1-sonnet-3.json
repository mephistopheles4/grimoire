{
  "id": "publish-post-retry",
  "title": "Publish a post · the upload retries",
  "blurb": "publishPost reads a draft, renders it to HTML, and uploads it to S3. A missing draft or unparseable markdown are both caught before the upload; the S3 put itself can fail once and succeed on retry.",
  "entry": "publishPost",
  "env": {
    "s3Bucket": "posts-prod"
  },
  "files": [
    {
      "path": "src/publish.ts",
      "change": "edit",
      "why": "holds publishPost, the handler that drives render, fallback and upload",
      "adds": 40,
      "dels": 6
    },
    {
      "path": "src/render.ts",
      "change": "new",
      "why": "holds the new pure renderHtml",
      "adds": 55,
      "dels": 0
    },
    {
      "path": "src/upload.ts",
      "change": "edit",
      "why": "holds uploadHtml, changed to retry the S3 put",
      "adds": 18,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "nodes": {
        "uploadHtml": {
          "R": [
            "a fake bucket · publish.test.ts:31"
          ]
        }
      }
    }
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:12",
      "params": [
        "draftId"
      ],
      "channels": {
        "A": "the published URL",
        "E": [
          "EmptyDraft",
          "BadMarkdown"
        ],
        "R": [
          "the draft store"
        ]
      },
      "touches": [
        "src/publish.ts"
      ],
      "enteredBy": [
        "src/publish.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "publish a draft: read it, render it, fall back on bad markdown, upload it with retry, return the URL"
        },
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft from the store",
          "args": {
            "id": "draftId"
          },
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "the draft row is missing",
          "then": "empty",
          "else": "render"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "EmptyDraft",
          "message": "no draft row for that id",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "render",
          "target": "renderHtml",
          "args": {
            "draft": "draft"
          },
          "bind": "html",
          "aside": "the only call that can fail",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback",
              "bind": "why"
            }
          ]
        },
        {
          "op": "goto",
          "to": "upload"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "a plain-text version of draft"
        },
        {
          "op": "call",
          "label": "upload",
          "target": "uploadHtml",
          "args": {
            "html": "html"
          },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:5",
      "params": [
        "draft"
      ],
      "channels": {
        "A": "the rendered HTML",
        "E": [
          "BadMarkdown"
        ],
        "R": []
      },
      "touches": [
        "src/render.ts"
      ],
      "enteredBy": [
        "src/publish.test.ts"
      ],
      "steps": [
        {
          "op": "if",
          "cond": "the draft's markdown body is empty",
          "then": "bad",
          "else": "ok"
        },
        {
          "op": "throw",
          "label": "bad",
          "tag": "BadMarkdown",
          "message": "empty markdown will not parse",
          "channel": "die"
        },
        {
          "op": "return",
          "label": "ok",
          "expr": "the rendered HTML string"
        }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:9",
      "params": [
        "html"
      ],
      "channels": {
        "A": "the published URL",
        "E": [
          "UploadFailed"
        ],
        "R": [
          "the S3 client"
        ]
      },
      "touches": [
        "src/upload.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.put",
          "desc": "upload the rendered HTML",
          "args": {
            "body": "html"
          },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    }
  },
