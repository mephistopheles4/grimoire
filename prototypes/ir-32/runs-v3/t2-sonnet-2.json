    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:14",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "the order id, or a status message",
        "E": [
          "NoCart",
          "CardDeclined"
        ],
        "R": [
          "the cart table",
          "the Stripe client",
          "the mail service"
        ]
      },
      "touches": [
        "src/checkout.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "turn a cart into an order: load it, price it, then charge or decline"
        },
        {
          "op": "call",
          "target": "loadCart",
          "args": {
            "cartId": "cartId"
          },
          "bind": "cart",
          "aside": "can throw NoCart; nothing here catches it"
        },
        {
          "op": "call",
          "target": "priceCart",
          "args": {
            "cart": "cart"
          },
          "bind": "total"
        },
        {
          "op": "if",
          "cond": "total is zero",
          "then": "empty",
          "else": "chargeStep"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "call",
          "label": "chargeStep",
          "target": "charge",
          "args": {
            "amount": "total"
          },
          "bind": "orderId",
          "onError": [
            {
              "tag": "CardDeclined",
              "goto": "declined",
              "bind": "why"
            }
          ]
        },
        {
          "op": "return",
          "expr": "orderId"
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "email the customer that the payment was declined",
          "args": {
            "cartId": "cartId",
            "reason": "why"
          }
        },
        {
          "op": "return",
          "expr": "\"payment declined\""
        }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:5",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "the cart",
        "E": [
          "NoCart"
        ],
        "R": [
          "the cart table"
        ]
      },
      "touches": [
