      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the cart row",
          "args": {
            "cartId": "cartId"
          },
          "bind": "row"
        },
        {
          "op": "if",
          "cond": "row is missing",
          "then": "missing",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "row"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoCart",
          "message": "no cart row for that id",
          "channel": "escape"
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:3",
      "params": [
        "cart"
      ],
      "channels": {
        "A": "the total in pence",
        "E": [],
        "R": []
      },
      "touches": [
        "src/pricing.ts"
      ],
      "enteredBy": [
        "src/pricing.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loopTop",
          "cond": "items remain in cart.items",
          "then": "addItem",
          "else": "loopDone"
        },
        {
          "op": "let",
          "label": "addItem",
          "name": "total",
          "expr": "total + nextItem.price"
        },
        {
          "op": "goto",
          "to": "loopTop"
        },
        {
          "op": "return",
          "label": "loopDone",
          "expr": "total"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:9",
      "params": [
        "amount"
      ],
      "channels": {
        "A": "an order id",
        "E": [
          "CardDeclined"
        ],
        "R": [
          "the Stripe client"
        ]
      },
      "touches": [
        "src/payments.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the card for the total",
          "args": {
            "amount": "amount"
          },
          "bind": "orderId"
        },
        {
          "op": "return",
          "expr": "orderId"
        }
      ]
    }
  },
