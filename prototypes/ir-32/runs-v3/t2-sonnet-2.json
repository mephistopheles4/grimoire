{
  "id": "cart-checkout",
  "title": "Cart checkout · price, charge, or decline",
  "blurb": "checkout turns a cart into an order. It loads the cart, prices it in a pure loop, and then either reports an empty cart, charges the card and returns the order id, or catches a decline and mails the customer.",
  "entry": "checkout",
  "env": {},
  "files": [
    {
      "path": "src/checkout.ts",
      "change": "edit",
      "why": "holds the checkout handler that sequences load, price, and charge",
      "adds": 62,
      "dels": 11
    },
    {
      "path": "src/pricing.ts",
      "change": "new",
      "why": "holds the new priceCart loop that totals the cart",
      "adds": 38,
      "dels": 0
    },
    {
      "path": "src/cart-store.ts",
      "change": "edit",
      "why": "holds loadCart, which the handler now calls",
      "adds": 9,
      "dels": 1
    },
    {
      "path": "src/payments.ts",
      "change": "edit",
      "why": "holds charge, which the handler now calls and can catch",
      "adds": 27,
      "dels": 4
    }
  ],
