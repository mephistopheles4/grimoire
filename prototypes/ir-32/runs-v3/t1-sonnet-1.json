{
  "id": "publish-post-retry",
  "title": "publishPost · a retried upload",
  "blurb": "publishPost reads a draft, renders it to HTML, and uploads that HTML to S3, retrying once when the first upload attempt fails. When the markdown itself won't render, publishPost catches the failure and falls back to a plain-text version before uploading.",
  "entry": "publishPost",
  "env": {},
  "files": [
    {
      "path": "src/publish.ts",
      "change": "edit",
      "why": "holds publishPost, which now catches BadMarkdown and falls back before uploading",
      "adds": 40,
      "dels": 6
    },
    {
      "path": "src/render.ts",
      "change": "new",
      "why": "new file for the pure renderHtml function",
      "adds": 55,
      "dels": 0
    },
    {
      "path": "src/upload.ts",
      "change": "edit",
      "why": "holds uploadHtml, which now retries the S3 put once before giving up",
      "adds": 18,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "entry": "publishPost",
      "nodes": {
        "uploadHtml": {
          "R": [
            "a fake bucket · publish.test.ts:31"
          ]
        }
      }
    }
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:10",
      "params": [
        "draftId"
      ],
      "channels": {
        "A": "the published URL",
        "E": [
          "EmptyDraft",
          "BadMarkdown"
        ],
        "R": [
          "the draft store"
        ]
      },
      "touches": [
        "src/publish.ts"
      ],
      "enteredBy": [
        "src/publish.test.ts"
      ],
      "steps": [
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft",
          "args": {
            "id": "draftId"
          },
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "draft is empty",
          "then": "empty",
          "else": "render"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "EmptyDraft",
          "message": "no draft for that id",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "render",
          "target": "renderHtml",
          "args": {
            "draft": "draft"
          },
          "bind": "html",
          "aside": "the only call that can fail, with BadMarkdown",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback",
              "bind": "why"
            }
          ]
        },
        {
          "op": "goto",
          "to": "upload"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "plainTextVersion(draft)"
        },
        {
          "op": "call",
          "label": "upload",
          "target": "uploadHtml",
          "args": {
            "html": "html"
          },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:5",
      "params": [
        "draft"
      ],
      "channels": {
        "A": "the rendered HTML",
        "E": [
          "BadMarkdown"
        ],
        "R": []
      },
