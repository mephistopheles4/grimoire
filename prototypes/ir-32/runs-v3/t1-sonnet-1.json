      ],
      "enteredBy": [
        "src/publish.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "html",
          "expr": "renderMarkdown(draft.body)"
        },
        {
          "op": "if",
          "cond": "html is empty",
          "then": "bad",
          "else": "ok"
        },
        {
          "op": "return",
          "label": "ok",
          "expr": "html"
        },
        {
          "op": "throw",
          "label": "bad",
          "tag": "BadMarkdown",
          "message": "the markdown will not parse",
          "channel": "die"
        }
      ]
    },
