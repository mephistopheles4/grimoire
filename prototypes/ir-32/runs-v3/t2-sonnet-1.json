  "nodes": {
    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:14",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "the order id, or a status message when the cart is empty or the card is declined",
        "E": [
          "NoCart",
          "CardDeclined"
        ],
        "R": []
      },
      "touches": [
        "src/checkout.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "turn a cart into an order: load it, price it, and charge the customer unless the cart is empty"
        },
        {
          "op": "call",
          "target": "loadCart",
          "args": {
            "cartId": "cartId"
          },
          "bind": "cart",
          "aside": "uncaught here — a missing cart is not this handler's problem to solve"
        },
        {
          "op": "call",
          "target": "priceCart",
          "args": {
            "cart": "cart"
          },
          "bind": "total"
        },
        {
          "op": "if",
          "cond": "total is zero",
          "then": "empty",
          "else": "pay"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "call",
          "label": "pay",
          "target": "charge",
          "args": {
            "total": "total"
          },
          "bind": "orderId",
          "aside": "the only call this handler itself catches",
          "onError": [
            {
              "tag": "CardDeclined",
              "goto": "declined",
              "bind": "why"
            }
          ]
        },
        {
          "op": "return",
          "expr": "orderId"
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "tell the customer the card was declined",
          "args": {
            "cartId": "cartId"
          }
        },
        {
          "op": "return",
          "expr": "\"payment declined\""
        }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:9",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "the cart matching the id",
        "E": [
          "NoCart"
        ],
        "R": [
          "the cart table"
        ]
      },
      "touches": [
        "src/cart-store.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the cart row",
          "args": {
            "id": "cartId"
          },
          "bind": "row"
        },
        {
          "op": "if",
          "cond": "row is missing",
          "then": "missing",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "row"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoCart",
          "message": "no cart row for that id",
          "channel": "escape"
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:6",
      "params": [
        "cart"
      ],
      "channels": {
        "A": "the cart's total in pence",
        "E": [],
        "R": []
      },
      "touches": [
        "src/pricing.ts"
      ],
      "enteredBy": [
        "src/pricing.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "walk the cart's line items, accumulating price times quantity into a running total"
        },
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "index",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loopTop",
          "cond": "index < cart.items.length",
          "then": "body",
          "else": "finish"
        },
        {
          "op": "let",
          "label": "body",
          "name": "total",
          "expr": "total + (cart.items[index].price * cart.items[index].qty)"
        },
        {
          "op": "let",
          "name": "index",
          "expr": "index + 1"
        },
        {
          "op": "goto",
          "to": "loopTop"
        },
        {
          "op": "return",
          "label": "finish",
          "expr": "total"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:11",
      "params": [
        "total"
      ],
      "channels": {
        "A": "the order id from the successful charge",
        "E": [
          "CardDeclined"
        ],
        "R": [
          "the Stripe client"
        ]
      },
      "touches": [
        "src/payments.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the card for the total",
          "args": {
            "amount": "total"
          },
          "bind": "chargeResult"
        },
        {
          "op": "return",
          "expr": "chargeResult.orderId"
        }
      ]
    }
  },
