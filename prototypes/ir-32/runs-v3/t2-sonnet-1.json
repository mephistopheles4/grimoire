{
  "id": "cart-checkout",
  "title": "Cart checkout · price and charge",
  "blurb": "checkout turns a cart into an order: it loads the cart, prices it with a looping pure function, and charges the customer unless the cart is empty.",
  "entry": "checkout",
  "env": {
    "currency": "GBP"
  },
  "files": [
    {
      "path": "src/checkout.ts",
      "change": "edit",
      "why": "the handler that loads, prices, and charges the cart",
      "adds": 62,
      "dels": 11
    },
    {
      "path": "src/pricing.ts",
      "change": "new",
      "why": "the pure pricing loop the handler calls",
      "adds": 38,
      "dels": 0
    },
    {
      "path": "src/cart-store.ts",
      "change": "edit",
      "why": "the cart lookup the handler calls",
      "adds": 9,
      "dels": 1
    },
    {
      "path": "src/payments.ts",
      "change": "edit",
      "why": "the charge call the handler makes",
      "adds": 27,
      "dels": 4
    }
  ],
