        "src/publish.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "render markdown to HTML, or throw if syntax is invalid"
        },
        {
          "op": "if",
          "cond": "draft.body is empty",
          "then": "empty",
          "else": "parse"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "\"\""
        },
        {
          "op": "let",
          "label": "parse",
          "name": "html",
          "expr": "markdown.parse(draft.body)"
        },
        {
          "op": "if",
          "cond": "parse succeeded",
          "then": "success",
          "else": "bad"
        },
        {
          "op": "return",
          "label": "success",
          "expr": "html"
        },
        {
          "op": "throw",
          "label": "bad",
          "tag": "BadMarkdown",
          "message": "invalid markdown syntax",
          "channel": "die"
        }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
