      "touches": [
        "src/publish.ts"
      ],
      "enteredBy": [
        "src/publish.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "read a draft, render it to HTML, and upload to S3"
        },
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft",
          "args": {
            "id": "draftId"
          },
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "draft is empty",
          "then": "empty",
          "else": "render"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "EmptyDraft",
          "message": "the draft is empty",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "render",
          "target": "renderHtml",
          "args": {
            "draft": "draft"
          },
          "bind": "html",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback"
            }
          ]
        },
        {
          "op": "goto",
          "to": "upload"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "\"<p>\" + draft.title + \"</p>\""
        },
        {
          "op": "call",
          "label": "upload",
          "target": "uploadHtml",
          "args": {
            "html": "html"
          },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:3",
      "params": [
        "draft"
      ],
      "channels": {
        "A": "the rendered HTML",
        "E": [
