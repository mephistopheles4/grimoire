  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:5",
      "params": ["uploadId"],
      "channels": {
        "A": "{saved, skipped}",
        "E": ["NoUpload", "BadCsv", "Duplicate"],
        "R": ["the S3 client", "the contacts table"]
      },
      "touches": ["src/import/contacts.ts"],
      "enteredBy": ["src/import/contacts.test.ts"],
      "steps": [
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {"uploadId": "uploadId"},
          "bind": "bytes"
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {"bytes": "bytes"},
          "bind": "rows"
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loop",
          "cond": "rows.length > 0",
          "then": "process",
          "else": "report"
        },
        {
          "op": "let",
          "label": "process",
          "name": "row",
          "expr": "rows[0]"
        },
        {
          "op": "call",
          "target": "saveContact",
          "args": {"row": "row"},
          "bind": "contact",
          "onError": [
            {"tag": "Duplicate", "goto": "skip"}
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "continue"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "let",
          "label": "continue",
          "name": "rows",
          "expr": "rows.slice(1)"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "effect",
          "label": "report",
          "kind": "metrics.write",
          "desc": "record import metrics",
          "args": {"saved": "saved", "skipped": "skipped"}
        },
        {
          "op": "return",
          "expr": "{saved: saved, skipped: skipped}"
        }
      ]
    },
    "fetchUpload": {
      "name": "fetchUpload",
      "role": "io",
      "loc": "src/import/fetch.ts:1",
      "params": ["uploadId"],
      "channels": {
        "A": "raw bytes",
        "E": ["NoUpload"],
        "R": ["the S3 client"]
      },
      "touches": ["src/import/fetch.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.get",
          "desc": "fetch the upload from S3",
          "args": {"uploadId": "uploadId"},
          "bind": "bytes",
          "onError": [
            {"tag": "NoUpload", "goto": "missing"}
          ]
        },
        {
          "op": "return",
          "expr": "bytes"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoUpload",
          "message": "object not found in S3",
          "channel": "escape"
        }
      ]
    },
    "parseRows": {
      "name": "parseRows",
      "role": "pure",
      "loc": "src/import/parse.ts:1",
      "params": ["bytes"],
      "channels": {
        "A": "array of rows",
        "E": ["BadCsv"],
        "R": []
      },
      "touches": ["src/import/parse.ts"],
      "enteredBy": ["src/import/contacts.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "rows",
          "expr": "split bytes by line and parse header"
        },
        {
          "op": "if",
          "cond": "header is incorrect",
          "then": "bad",
          "else": "good"
        },
        {
          "op": "throw",
          "label": "bad",
          "tag": "BadCsv",
          "message": "unexpected header line",
          "channel": "die"
        },
        {
          "op": "return",
          "label": "good",
          "expr": "rows"
        }
      ]
    },
    "saveContact": {
      "name": "saveContact",
      "role": "io",
      "loc": "src/contacts/save.ts:10",
      "params": ["row"],
      "channels": {
        "A": "the inserted contact",
        "E": ["Duplicate"],
        "R": ["the contacts table"]
      },
      "touches": ["src/contacts/save.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "normalise",
          "args": {"row": "row"},
          "bind": "cleaned"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "insert the contact",
          "args": {"contact": "cleaned"},
          "onError": [
            {"tag": "Duplicate", "goto": "dup"}
          ]
        },
        {
          "op": "return",
          "expr": "cleaned"
        },
        {
          "op": "throw",
          "label": "dup",
          "tag": "Duplicate",
          "message": "contact already exists",
          "channel": "retry"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
      "role": "pure",
      "loc": "src/contacts/normalise.ts:1",
      "params": ["row"],
      "channels": {
        "A": "cleaned row",
        "E": [],
        "R": []
      },
      "touches": ["src/contacts/normalise.ts"],
      "enteredBy": ["src/contacts/normalise.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "cleaned",
          "expr": "trim and normalize row fields"
        },
        {
          "op": "return",
          "expr": "cleaned"
        }
      ]
    }
  },
