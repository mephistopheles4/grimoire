{
  "id": "csv-import",
  "title": "CSV import · contacts",
  "blurb": "importContacts fetches an uploaded CSV from S3, parses it, and loops over the rows calling saveContact, which normalises each row before inserting it. A duplicate row is skipped rather than failing the whole import, but a missing upload or a malformed header aborts uncaught.",
  "entry": "importContacts",
  "env": {},
  "files": [
