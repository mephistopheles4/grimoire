      "name": "parseRows",
      "role": "pure",
      "loc": "src/import/parse.ts:3",
      "params": [
        "bytes"
      ],
      "channels": {
        "A": "a list of rows",
        "E": [
          "BadCsv"
        ],
        "R": []
      },
      "touches": [
        "src/import/parse.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "if",
          "cond": "the header line is wrong",
          "then": "bad",
          "else": "ok"
        },
        {
          "op": "return",
          "label": "ok",
          "expr": "the parsed rows"
        },
        {
          "op": "throw",
          "label": "bad",
          "tag": "BadCsv",
          "message": "the header line is wrong",
          "channel": "die"
        }
      ]
    },
    "saveContact": {
      "name": "saveContact",
      "role": "io",
      "loc": "src/contacts/save.ts:12",
      "params": [
        "row"
      ],
      "channels": {
        "A": "the saved contact row",
        "E": [
          "Duplicate"
        ],
        "R": [
          "the contacts table"
        ]
      },
      "touches": [
        "src/contacts/save.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "normalise",
          "args": {
            "row": "row"
          },
          "bind": "clean"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "insert the contact row",
          "args": {
            "row": "clean"
          },
          "bind": "inserted",
          "aside": "raises Duplicate on the retry channel; importContacts catches it"
        },
        {
          "op": "return",
          "expr": "clean"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
      "role": "pure",
      "loc": "src/contacts/normalise.ts:5",
      "params": [
        "row"
      ],
      "channels": {
        "A": "the cleaned row",
        "E": [],
        "R": []
      },
      "touches": [
        "src/contacts/normalise.ts"
      ],
      "enteredBy": [
        "src/contacts/normalise.test.ts"
      ],
      "steps": [
        {
          "op": "let",
          "name": "cleaned",
          "expr": "row with whitespace trimmed and fields normalised"
        },
        {
          "op": "return",
          "expr": "cleaned"
        }
      ]
    }
  },
