      "change": "edit",
      "why": "adds the importContacts handler that loops over parsed rows and calls saveContact",
      "adds": 88,
      "dels": 12
    },
    {
      "path": "src/import/parse.ts",
      "change": "new",
      "why": "adds parseRows, the pure CSV parser importContacts calls",
      "adds": 41,
      "dels": 0
    },
    {
      "path": "src/import/fetch.ts",
      "change": "new",
      "why": "adds fetchUpload, the S3 read importContacts calls first",
      "adds": 19,
      "dels": 0
    },
    {
      "path": "src/contacts/save.ts",
      "change": "edit",
      "why": "adds saveContact's duplicate handling that importContacts now relies on",
      "adds": 33,
      "dels": 7
    },
    {
      "path": "src/contacts/normalise.ts",
      "change": "edit",
      "why": "adds the row cleanup saveContact now calls before inserting",
      "adds": 14,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "entry": "importContacts",
      "nodes": {
        "fetchUpload": {
          "R": [
            "a fixture directory · contacts.test.ts:9"
          ]
        },
        "saveContact": {
          "R": [
            "an in-memory list · contacts.test.ts:22"
          ]
        }
      }
    }
  },
  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:10",
      "params": [
        "uploadId"
      ],
      "channels": {
        "A": "a count of saved and skipped rows",
        "E": [
          "NoUpload",
          "BadCsv",
          "Duplicate"
        ],
        "R": [
          "the S3 client",
          "the contacts table",
          "the metrics sink"
        ]
      },
      "touches": [
        "src/import/contacts.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "import the uploaded CSV of contacts into the address book"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {
            "uploadId": "uploadId"
          },
          "bind": "bytes",
          "aside": "NoUpload escapes uncaught; nothing here catches it"
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {
            "bytes": "bytes"
          },
          "bind": "rows",
          "aside": "BadCsv escapes uncaught; nothing here catches it"
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loopTop",
          "cond": "no rows remain",
          "then": "afterLoop",
          "else": "loopBody"
        },
        {
          "op": "call",
          "label": "loopBody",
          "target": "saveContact",
          "args": {
            "row": "the next row"
          },
          "bind": "result",
          "aside": "the only call inside the loop that can fail",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip",
              "bind": "why"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "loopTop"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "goto",
          "to": "loopTop"
        },
        {
          "op": "effect",
          "label": "afterLoop",
          "kind": "metrics.write",
          "desc": "record saved and skipped counts",
          "args": {
            "saved": "saved",
            "skipped": "skipped"
          }
        },
        {
          "op": "return",
          "expr": "a summary of saved and skipped counts"
        }
      ]
    },
