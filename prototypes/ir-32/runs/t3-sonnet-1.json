{
  "id": "csv-import",
  "title": "CSV import · contacts",
  "blurb": "importContacts reads an uploaded CSV, parses it, and saves each row to the address book. A duplicate row is skipped rather than failing the whole import; a bad upload or a bad header aborts it.",
  "entry": "importContacts",
  "env": {},
  "files": [
    {
      "path": "src/import/contacts.ts",
      "change": "edit",
      "why": "adds the importContacts handler that drives the CSV import loop",
      "adds": 88,
      "dels": 12
    },
    {
      "path": "src/import/parse.ts",
      "change": "new",
      "why": "adds parseRows, the pure CSV parser importContacts calls",
      "adds": 41,
      "dels": 0
    },
    {
      "path": "src/import/fetch.ts",
      "change": "new",
      "why": "adds fetchUpload, the S3 read importContacts calls first",
      "adds": 19,
      "dels": 0
    },
    {
      "path": "src/contacts/save.ts",
      "change": "edit",
      "why": "adds saveContact, the per-row insert importContacts calls in its loop",
      "adds": 33,
      "dels": 7
    },
    {
      "path": "src/contacts/normalise.ts",
      "change": "edit",
      "why": "extends normalise, the cleanup saveContact calls before inserting",
      "adds": 14,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
