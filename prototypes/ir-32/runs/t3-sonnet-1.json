          "R": [
            "an in-memory list · contacts.test.ts:22"
          ]
        }
      }
    }
  },
  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:14",
      "params": [
        "uploadId"
      ],
      "channels": {
        "A": "a count of saved and skipped rows",
        "E": [
          "NoUpload",
          "BadCsv",
          "Duplicate"
        ],
        "R": []
      },
      "touches": [
        "src/import/contacts.ts"
      ],
      "enteredBy": [
        "src/import/contacts.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "import each row from the upload, skipping any that already exist"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {
            "uploadId": "uploadId"
          },
          "bind": "bytes"
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {
            "bytes": "bytes"
          },
          "bind": "rows"
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loopTop",
          "cond": "rows remain",
          "then": "loopBody",
          "else": "afterLoop"
        },
        {
          "op": "call",
          "label": "loopBody",
          "target": "saveContact",
          "args": {
            "row": "the current row"
          },
          "bind": "_",
          "aside": "the only call in the loop that can fail",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip",
              "bind": "why"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "loopTop"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "goto",
          "to": "loopTop"
        },
        {
          "op": "effect",
          "label": "afterLoop",
          "kind": "metrics.write",
          "desc": "write the import metrics",
          "args": {
            "saved": "saved",
            "skipped": "skipped"
          }
        },
        {
          "op": "return",
          "expr": "{ saved: saved, skipped: skipped }"
        }
      ]
    },
