      "loc": "src/contacts/save.ts:9",
      "params": [
        "row"
      ],
      "channels": {
        "A": "confirmation the row was saved",
        "E": [
          "Duplicate"
        ],
        "R": [
          "the contacts table"
        ]
      },
      "touches": [
        "src/contacts/save.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "normalise",
          "args": {
            "row": "row"
          },
          "bind": "clean"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "insert the cleaned row into the contacts table",
          "args": {
            "row": "clean"
          },
          "bind": "result"
        },
        {
          "op": "return",
          "expr": "result"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
