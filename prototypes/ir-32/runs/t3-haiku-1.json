  "nodes": {
    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:5",
      "params": ["uploadId"],
      "channels": {
        "A": "an object with saved and skipped counts",
        "E": ["BadCsv", "NoUpload"],
        "R": ["the S3 client", "the contacts table"]
      },
      "touches": ["src/import/contacts.ts"],
      "enteredBy": ["src/import/contacts.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "load a CSV of contacts into the address book"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {"id": "uploadId"},
          "bind": "bytes"
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {"csv": "bytes"},
          "bind": "rows"
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "remaining",
          "expr": "rows"
        },
        {
          "op": "if",
          "label": "loopStart",
          "cond": "remaining is empty",
          "then": "done",
          "else": "processRow"
        },
        {
          "op": "call",
          "label": "processRow",
          "target": "saveContact",
          "args": {"row": "remaining[0]"},
          "bind": "contact",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "skip"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "let",
          "label": "advance",
          "name": "remaining",
          "expr": "remaining.slice(1)"
        },
        {
          "op": "goto",
          "to": "loopStart"
        },
        {
          "op": "effect",
          "label": "done",
          "kind": "metrics.write",
          "desc": "record the import results",
          "args": {"saved": "saved", "skipped": "skipped"}
        },
        {
          "op": "return",
          "expr": "{saved: saved, skipped: skipped}"
        }
      ]
    },
    "fetchUpload": {
      "name": "fetchUpload",
      "role": "io",
      "loc": "src/import/fetch.ts:3",
      "params": ["id"],
      "channels": {
        "A": "raw bytes of the CSV",
        "E": ["NoUpload"],
        "R": ["the S3 client"]
      },
      "touches": ["src/import/fetch.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.get",
          "desc": "fetch the CSV from S3",
          "args": {"id": "id"},
          "bind": "data"
        },
        {
          "op": "if",
          "cond": "data is null",
          "then": "missing",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "data"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoUpload",
          "message": "upload not found",
          "channel": "escape"
        }
      ]
    },
    "parseRows": {
      "name": "parseRows",
      "role": "pure",
      "loc": "src/import/parse.ts:1",
      "params": ["csv"],
      "channels": {
        "A": "an array of row objects",
        "E": ["BadCsv"],
        "R": []
      },
      "touches": ["src/import/parse.ts"],
      "enteredBy": ["src/import/contacts.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "parse CSV text into rows"
        },
        {
          "op": "let",
          "name": "lines",
          "expr": "csv.split('\\n')"
        },
        {
          "op": "if",
          "cond": "first line is the correct header",
          "then": "parseBody",
          "else": "badHeader"
        },
        {
          "op": "let",
          "label": "parseBody",
          "name": "rows",
          "expr": "parse the remaining lines"
        },
        {
          "op": "return",
          "expr": "rows"
        },
        {
          "op": "throw",
          "label": "badHeader",
          "tag": "BadCsv",
          "message": "header line does not match",
          "channel": "die"
        }
      ]
    },
    "saveContact": {
      "name": "saveContact",
      "role": "io",
      "loc": "src/contacts/save.ts:8",
      "params": ["row"],
      "channels": {
        "A": "the saved contact",
        "E": ["Duplicate"],
        "R": ["the contacts table"]
      },
      "touches": ["src/contacts/save.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "call",
          "target": "normalise",
          "args": {"row": "row"},
          "bind": "cleaned"
        },
        {
          "op": "effect",
          "kind": "db.insert",
          "desc": "insert the contact",
          "args": {"contact": "cleaned"},
          "bind": "result"
        },
        {
          "op": "return",
          "expr": "result"
        }
      ]
    },
    "normalise": {
      "name": "normalise",
      "role": "pure",
      "loc": "src/contacts/normalise.ts:1",
      "params": ["row"],
      "channels": {
        "A": "the cleaned row",
        "E": [],
        "R": []
      },
      "touches": ["src/contacts/normalise.ts"],
      "enteredBy": ["src/contacts/normalise.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "cleaned",
          "expr": "trim and normalize the row fields"
        },
        {
          "op": "return",
          "expr": "cleaned"
        }
      ]
    }
  },
