  "nodes": {
    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:5",
      "params": ["cartId"],
      "channels": {"A": "an order id or a message", "E": ["CardDeclined"], "R": ["the Stripe client"]},
      "touches": ["src/checkout.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        {"op": "note", "note": "turn a cart into an order, or return a message if it fails"},
        {"op": "call", "target": "loadCart", "args": {"id": "cartId"}, "bind": "cart", "onError": [{"tag": "NoCart", "goto": "noCart"}]},
        {"op": "call", "target": "priceCart", "args": {"cart": "cart"}, "bind": "total"},
        {"op": "if", "cond": "total == 0", "then": "empty", "else": "charge_it"},
        {"op": "return", "expr": "\"nothing to buy\"", "label": "empty"},
        {"op": "call", "target": "charge", "args": {"amount": "total"}, "bind": "chargeId", "label": "charge_it", "onError": [{"tag": "CardDeclined", "goto": "declined"}]},
        {"op": "return", "expr": "chargeId"},
        {"op": "effect", "kind": "mail.send", "desc": "notify customer of declined payment", "args": {"message": "payment declined"}, "label": "declined"},
        {"op": "return", "expr": "\"payment declined\""},
        {"op": "return", "expr": "\"no such cart\"", "label": "noCart"}
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:3",
      "params": ["id"],
      "channels": {"A": "a cart object", "E": ["NoCart"], "R": ["the cart table"]},
      "touches": ["src/cart-store.ts"],
      "enteredBy": [],
      "steps": [
        {"op": "effect", "kind": "db.get", "desc": "read the cart row", "args": {"id": "id"}, "bind": "row"},
        {"op": "if", "cond": "row is missing", "then": "missing", "else": "found"},
        {"op": "return", "expr": "row", "label": "found"},
        {"op": "throw", "tag": "NoCart", "message": "cart not found", "channel": "escape", "label": "missing"}
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:8",
      "params": ["cart"],
      "channels": {"A": "the total in pence", "E": [], "R": []},
      "touches": ["src/pricing.ts"],
      "enteredBy": ["src/pricing.test.ts"],
      "steps": [
        {"op": "note", "note": "sum the price of each item in the cart"},
        {"op": "let", "label": "loop", "name": "items", "expr": "cart.items"},
        {"op": "let", "name": "index", "expr": "0"},
        {"op": "let", "name": "total", "expr": "0"},
        {"op": "if", "cond": "index < items.length", "then": "process", "else": "return"},
        {"op": "let", "label": "process", "name": "price", "expr": "items[index].price"},
        {"op": "let", "name": "total", "expr": "total + price"},
        {"op": "let", "name": "index", "expr": "index + 1"},
        {"op": "goto", "to": "loop"},
        {"op": "return", "expr": "total", "label": "return"}
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:11",
      "params": ["amount"],
      "channels": {"A": "the charge id", "E": ["CardDeclined"], "R": ["the Stripe client"]},
      "touches": ["src/payments.ts"],
      "enteredBy": [],
      "steps": [
        {"op": "effect", "kind": "stripe.charge", "desc": "charge the card", "args": {"amount": "amount"}, "bind": "chargeId"},
        {"op": "return", "expr": "chargeId"}
      ]
    }
  },
