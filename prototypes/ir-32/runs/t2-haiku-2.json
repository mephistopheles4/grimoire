              "goto": "declined"
            }
          ]
        },
        {
          "op": "return",
          "expr": "orderId"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "tell the customer the card declined",
          "args": {
            "message": "payment declined"
          }
        },
        {
          "op": "return",
          "expr": "\"payment declined\""
        }
      ]
