{
  "id": "publish-post-retry",
  "title": "Publish a post · retry on upload",
  "blurb": "publishPost reads a draft, renders it to HTML, and uploads it, retrying the upload once on failure. A draft with unparseable markdown falls back to a plain-text render before the upload.",
  "entry": "publishPost",
  "env": {},
  "files": [
    { "path": "src/publish.ts", "change": "edit", "why": "holds the retry-aware publishPost handler", "adds": 40, "dels": 6 },
    { "path": "src/render.ts", "change": "new", "why": "holds the pure renderHtml node", "adds": 55, "dels": 0 },
    { "path": "src/upload.ts", "change": "edit", "why": "holds uploadHtml and its s3.put effect", "adds": 18, "dels": 2 }
  ],
  "layers": {
    "production": { "nodes": {} },
    "tests": {
      "entry": "publishPost",
      "nodes": { "uploadHtml": { "R": ["a fake bucket · publish.test.ts:31"] } }
    }
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:12",
      "params": ["draftId"],
      "channels": { "A": "the published URL", "E": ["EmptyDraft", "BadMarkdown"], "R": ["the draft store", "the S3 client"] },
      "touches": ["src/publish.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        { "op": "note", "note": "read the draft, render it, upload it (retrying on failure), and return the URL" },
        { "op": "effect", "kind": "db.get", "desc": "read the draft from the store", "args": { "id": "draftId" }, "bind": "draft" },
        { "op": "if", "cond": "the draft is empty", "then": "empty", "else": "render" },
        { "op": "throw", "label": "empty", "tag": "EmptyDraft", "message": "the draft is empty", "channel": "escape" },
        {
          "op": "call", "label": "render", "target": "renderHtml", "args": { "draft": "draft" }, "bind": "html",
          "aside": "the only step here that can fail",
          "onError": [{ "tag": "BadMarkdown", "goto": "fallback", "bind": "why" }]
        },
        { "op": "goto", "to": "upload" },
        { "op": "let", "label": "fallback", "name": "html", "expr": "a plain-text rendering of draft", "aside": "used when the markdown will not parse" },
        { "op": "call", "label": "upload", "target": "uploadHtml", "args": { "html": "html" }, "bind": "url" },
        { "op": "return", "expr": "url" }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:5",
      "params": ["draft"],
      "channels": { "A": "the rendered HTML string", "E": ["BadMarkdown"], "R": [] },
      "touches": ["src/render.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        { "op": "if", "cond": "the draft body is empty", "then": "bad", "else": "ok" },
        { "op": "throw", "label": "bad", "tag": "BadMarkdown", "message": "the markdown will not parse", "channel": "die" },
        { "op": "return", "label": "ok", "expr": "the rendered HTML" }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:9",
      "params": ["html"],
      "channels": { "A": "the upload URL", "E": [], "R": ["the S3 client"] },
      "touches": ["src/upload.ts"],
      "enteredBy": [],
      "steps": [
        { "op": "effect", "kind": "s3.put", "desc": "upload the html to the bucket", "args": { "body": "html" }, "bind": "url" },
        { "op": "return", "expr": "url" }
      ]
    }
  },
  "presets": [
    {
      "name": "the happy path",
      "blurb": "A real draft renders cleanly and the upload succeeds on the second attempt.",
      "input": { "draftId": "d-1" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft from the store", "status": "ok", "result": { "body": "# Hello World" } },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml" },
          { "k": "move", "at": 0, "next": 2 },
          { "k": "return", "at": 2, "value": "<h1>Hello World</h1>" },
          { "k": "move", "at": 5, "next": 7 },
          { "k": "call", "at": 7, "to": "uploadHtml" },
          { "k": "effect", "at": 0, "kind": "s3.put", "desc": "upload the html to the bucket", "status": "failed", "attempt": 1, "error": "S3 request timed out" },
          { "k": "effect", "at": 0, "kind": "s3.put", "desc": "upload the html to the bucket", "status": "ok", "attempt": 2, "result": { "url": "https://cdn.example.com/posts/d-1.html" } },
          { "k": "return", "at": 1, "value": "https://cdn.example.com/posts/d-1.html" },
          { "k": "return", "at": 8, "value": "https://cdn.example.com/posts/d-1.html" },
          { "k": "done", "result": "https://cdn.example.com/posts/d-1.html" }
        ]
      }
    },
    {
      "name": "bad markdown",
      "blurb": "The render throws BadMarkdown, publishPost catches it, and the fallback HTML uploads.",
      "input": { "draftId": "d-2" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft from the store", "status": "ok", "result": { "body": "" } },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "raise", "at": 1, "tag": "BadMarkdown", "message": "the markdown will not parse", "channel": "die" },
          { "k": "unwind" },
          { "k": "handled", "at": 6, "goto": "fallback" },
          { "k": "move", "at": 6, "next": 7 },
          { "k": "call", "at": 7, "to": "uploadHtml" },
          { "k": "effect", "at": 0, "kind": "s3.put", "desc": "upload the html to the bucket", "status": "ok", "attempt": 1, "result": { "url": "https://cdn.example.com/posts/d-2-fallback.html" } },
          { "k": "return", "at": 1, "value": "https://cdn.example.com/posts/d-2-fallback.html" },
          { "k": "return", "at": 8, "value": "https://cdn.example.com/posts/d-2-fallback.html" },
          { "k": "done", "result": "https://cdn.example.com/posts/d-2-fallback.html" }
        ]
      }
    }
  ],
  "sheet": { "scopeRule": "one graph per entry point", "graphsNotDrawn": [] }
}
