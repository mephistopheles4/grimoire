    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:5",
      "params": ["cartId"],
      "channels": {
        "A": "the order id",
        "E": ["CardDeclined"],
        "R": ["the Stripe client"]
      },
      "touches": ["src/checkout.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "turn a cart into an order"
        },
        {
          "op": "call",
          "target": "loadCart",
          "args": {"id": "cartId"},
          "bind": "cart"
        },
        {
          "op": "call",
          "target": "priceCart",
          "args": {"cart": "cart"},
          "bind": "total"
        },
        {
          "op": "if",
          "cond": "total == 0",
          "then": "empty",
          "else": "pay"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "call",
          "label": "pay",
          "target": "charge",
          "args": {"amount": "total"},
          "bind": "orderId",
          "onError": [
            {
              "tag": "CardDeclined",
              "goto": "declined"
            }
          ]
        },
        {
          "op": "return",
          "expr": "orderId"
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "tell the customer their card was declined"
        },
        {
          "op": "return",
          "expr": "\"payment declined\""
        }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:8",
      "params": ["id"],
      "channels": {
        "A": "the cart object",
        "E": ["NoCart"],
        "R": ["the cart table"]
      },
      "touches": ["src/cart-store.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the cart row",
          "args": {"id": "id"},
          "bind": "row"
        },
        {
          "op": "if",
          "cond": "row exists",
          "then": "found",
          "else": "missing"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "row"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoCart",
          "message": "no cart for that id",
          "channel": "escape"
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:3",
      "params": ["cart"],
      "channels": {
        "A": "the total in pence",
        "E": [],
        "R": []
      },
      "touches": ["src/pricing.ts"],
      "enteredBy": ["src/pricing.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "let",
          "label": "loop",
          "name": "index",
          "expr": "0"
        },
        {
          "op": "if",
          "cond": "index < cart.items.length",
          "then": "process",
          "else": "done"
        },
        {
          "op": "let",
          "label": "process",
          "name": "item",
          "expr": "cart.items[index]"
        },
        {
          "op": "let",
          "name": "total",
          "expr": "total + item.price"
        },
        {
          "op": "let",
          "name": "index",
          "expr": "index + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "return",
          "label": "done",
          "expr": "total"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:12",
      "params": ["amount"],
      "channels": {
        "A": "the order id",
        "E": ["CardDeclined"],
        "R": ["the Stripe client"]
      },
      "touches": ["src/payments.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the card",
          "args": {"amount": "amount"},
          "bind": "orderId"
        },
        {
          "op": "return",
          "expr": "orderId"
        }
      ]
    }
