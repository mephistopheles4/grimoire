        {
          "op": "note",
          "note": "upload HTML to S3"
        },
        {
          "op": "effect",
          "kind": "s3.put",
          "desc": "upload HTML to S3",
          "args": {"html": "html"},
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    }
  },
