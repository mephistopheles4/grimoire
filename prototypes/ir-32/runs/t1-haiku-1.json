      "touches": ["src/publish.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "publish a blog post from a draft"
        },
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft",
          "args": {"id": "draftId"},
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "draft is empty",
          "then": "empty",
          "else": "render"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "EmptyDraft",
          "message": "no draft content",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "render",
          "target": "renderHtml",
          "args": {"draft": "draft"},
          "bind": "html",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback"
            }
          ]
        },
        {
          "op": "goto",
          "to": "upload"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "<p>This post could not be rendered.</p>"
        },
        {
          "op": "call",
          "label": "upload",
          "target": "uploadHtml",
          "args": {"html": "html"},
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:1",
      "params": ["draft"],
      "channels": {
        "A": "the rendered HTML",
        "E": ["BadMarkdown"],
        "R": []
      },
      "touches": ["src/render.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "render markdown to HTML"
        },
        {
          "op": "if",
          "cond": "draft body is empty",
          "then": "empty",
          "else": "parse"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "\"\""
        },
        {
          "op": "let",
          "label": "parse",
          "name": "html",
          "expr": "markdown.parse(draft)"
        },
        {
          "op": "if",
          "cond": "markdown is valid",
          "then": "success",
          "else": "error"
        },
        {
          "op": "return",
          "label": "success",
          "expr": "html"
        },
        {
          "op": "throw",
          "label": "error",
          "tag": "BadMarkdown",
          "message": "invalid markdown syntax",
          "channel": "die"
        }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:1",
      "params": ["html"],
      "channels": {
