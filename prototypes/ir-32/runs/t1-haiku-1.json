{
  "id": "blog-publish",
  "title": "Blog post publication",
  "blurb": "Publish a blog post from a draft. The process reads the draft, renders markdown to HTML, uploads to S3 with retry, and handles markdown errors by using a plain text fallback.",
  "entry": "publishPost",
  "env": {},
  "files": [
    {
      "path": "src/publish.ts",
      "change": "edit",
      "why": "the main publication handler and error recovery logic",
      "adds": 40,
      "dels": 6
    },
    {
      "path": "src/render.ts",
      "change": "new",
      "why": "the markdown to HTML renderer",
      "adds": 55,
      "dels": 0
    },
    {
      "path": "src/upload.ts",
      "change": "edit",
      "why": "the S3 uploader",
      "adds": 18,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "entry": "publishPost",
      "nodes": {
        "uploadHtml": {
          "R": ["a fake bucket · publish.test.ts:31"]
        }
      }
    }
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:8",
      "params": ["draftId"],
      "channels": {
        "A": "the published URL",
        "E": ["EmptyDraft"],
        "R": ["the draft store"]
      },
      "touches": ["src/publish.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "publish a blog post from a draft"
        },
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft",
          "args": {"id": "draftId"},
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "draft is empty",
          "then": "throw_empty",
          "else": "call_render"
        },
        {
          "op": "throw",
          "label": "throw_empty",
          "tag": "EmptyDraft",
          "message": "draft is empty",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "call_render",
          "target": "renderHtml",
          "args": {"draft": "draft"},
          "bind": "html",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback"
            }
          ]
        },
        {
          "op": "call",
          "label": "upload_html",
          "target": "uploadHtml",
          "args": {"html": "html"},
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "plainTextVersion(draft)"
        },
        {
          "op": "goto",
          "to": "upload_html"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:3",
      "params": ["draft"],
      "channels": {
        "A": "HTML string",
        "E": ["BadMarkdown"],
        "R": []
      },
      "touches": ["src/render.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "render markdown draft to HTML, or throw if markdown is invalid"
        },
        {
          "op": "if",
          "cond": "draft body is empty",
          "then": "return_empty",
          "else": "parse"
        },
        {
          "op": "return",
          "label": "return_empty",
          "expr": "\"\""
        },
        {
          "op": "if",
          "label": "parse",
          "cond": "markdown parses",
          "then": "return_html",
          "else": "throw_bad"
        },
        {
          "op": "return",
          "label": "return_html",
          "expr": "html"
        },
        {
          "op": "throw",
          "label": "throw_bad",
          "tag": "BadMarkdown",
          "message": "markdown syntax error",
          "channel": "die"
        }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:1",
      "params": ["html"],
      "channels": {
        "A": "the published URL",
        "E": [],
        "R": ["the S3 client"]
      },
      "touches": ["src/upload.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.put",
          "desc": "upload HTML to S3",
          "args": {"body": "html"},
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    }
  },
  "presets": [
