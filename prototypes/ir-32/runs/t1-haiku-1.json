  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:1",
      "params": ["draftId"],
      "channels": {
        "A": "the published URL",
        "E": ["EmptyDraft", "BadMarkdown"],
