      "steps": [
        {
          "op": "if",
          "cond": "the markdown will not parse",
          "then": "bad",
          "else": "ok"
        },
        {
          "op": "throw",
          "label": "bad",
          "tag": "BadMarkdown",
          "message": "the markdown will not parse",
          "channel": "die"
        },
        {
          "op": "return",
          "label": "ok",
          "expr": "the rendered HTML string"
        }
      ]
    },
