      "enteredBy": [
        "src/publish.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "publish a post: read the draft, render it to HTML, upload it, and fall back to plain text if the markdown will not parse"
        },
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft",
          "args": {
            "id": "draftId"
          },
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "the draft is empty",
          "then": "empty",
          "else": "hasDraft"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "EmptyDraft",
          "message": "the draft is empty",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "hasDraft",
          "target": "renderHtml",
          "args": {
            "draft": "draft"
          },
          "bind": "html",
          "aside": "the render can fail on bad markdown",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback",
              "bind": "why"
            }
          ]
        },
        {
          "op": "goto",
          "to": "upload"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "a plain-text version of draft"
        },
        {
          "op": "call",
          "label": "upload",
          "target": "uploadHtml",
          "args": {
            "html": "html"
          },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:3",
      "params": [
        "draft"
      ],
      "channels": {
