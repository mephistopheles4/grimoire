    },
    {
      "path": "src/render.ts",
      "change": "new",
      "why": "holds renderHtml, the pure markdown renderer",
      "adds": 55,
      "dels": 0
    },
    {
      "path": "src/upload.ts",
      "change": "edit",
      "why": "holds uploadHtml, the S3 upload effect",
      "adds": 18,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
