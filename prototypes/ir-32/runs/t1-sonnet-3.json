      "adds": 40,
      "dels": 6
    },
    {
      "path": "src/render.ts",
      "change": "new",
      "why": "holds the new pure renderHtml, which turns a draft into HTML or throws BadMarkdown",
      "adds": 55,
      "dels": 0
    },
    {
      "path": "src/upload.ts",
      "change": "edit",
      "why": "holds uploadHtml, which performs the S3 put that the retry wraps",
      "adds": 18,
      "dels": 2
    }
  ],
