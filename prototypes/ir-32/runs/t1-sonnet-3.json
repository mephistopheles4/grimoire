        {
          "op": "if",
          "cond": "the draft is empty",
          "then": "empty",
          "else": "hasDraft"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "EmptyDraft",
          "message": "the draft is empty",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "hasDraft",
          "target": "renderHtml",
          "args": {
            "draft": "draft"
          },
          "bind": "html",
          "aside": "the only call that can fail",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback",
              "bind": "why"
            }
          ]
        },
        {
          "op": "goto",
          "to": "upload"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "a plain-text version of the draft"
        },
        {
          "op": "call",
          "label": "upload",
          "target": "uploadHtml",
          "args": {
            "html": "html"
          },
          "bind": "url",
          "aside": "retries once on failure"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    },
