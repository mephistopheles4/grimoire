      "steps": [
        {
          "op": "note",
          "note": "publish a draft blog post by rendering markdown and uploading to S3"
        },
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft",
          "args": {"id": "draftId"},
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "draft is empty",
          "then": "error",
          "else": "render"
        },
        {
          "op": "throw",
          "label": "error",
          "tag": "EmptyDraft",
          "message": "no content to publish",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "render",
          "target": "renderHtml",
          "args": {"draft": "draft"},
          "bind": "html",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback"
            }
          ]
        },
        {
          "op": "call",
          "target": "uploadHtml",
          "args": {"html": "html"},
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "plain text version of the draft"
        },
        {
          "op": "call",
          "target": "uploadHtml",
          "args": {"html": "html"},
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    },
