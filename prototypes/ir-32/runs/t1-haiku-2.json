      "steps": [
        {
          "op": "note",
          "note": "parse markdown and return HTML"
        },
        {
          "op": "if",
          "cond": "draft body is empty",
          "then": "error",
          "else": "parse"
        },
        {
          "op": "throw",
          "label": "error",
          "tag": "BadMarkdown",
          "message": "empty body cannot be rendered",
          "channel": "die"
        },
        {
          "op": "return",
          "label": "parse",
          "expr": "markdown to HTML"
        }
