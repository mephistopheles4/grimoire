{
  "id": "publish-post",
  "title": "Publish Post · with retry and error handling",
  "blurb": "Publishing a blog post reads a draft, renders it to HTML (handling markdown errors), and uploads via S3 where the upload may retry. The handler catches rendering errors and falls back to plain text.",
  "entry": "publishPost",
  "env": {},
  "files": [
    {
      "path": "src/publish.ts",
      "change": "edit",
      "why": "the main publication handler and error handlers",
      "adds": 40,
      "dels": 6
    },
    {
      "path": "src/render.ts",
      "change": "new",
      "why": "conversion of markdown to HTML",
      "adds": 55,
      "dels": 0
    },
    {
      "path": "src/upload.ts",
      "change": "edit",
      "why": "upload to S3 storage",
      "adds": 18,
      "dels": 2
    }
  ],
  "layers": {
    "production": {
      "nodes": {}
    },
    "tests": {
      "entry": "publishPost",
      "nodes": {
        "uploadHtml": {
          "R": [
            "a fake bucket · publish.test.ts:31"
          ]
        }
      }
    }
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:10",
      "params": [
        "draftId"
      ],
      "channels": {
        "A": "the published URL",
        "E": [
          "EmptyDraft",
          "BadMarkdown"
        ],
        "R": [
          "the draft store"
        ]
      },
      "touches": [
        "src/publish.ts"
      ],
      "enteredBy": [
        "src/publish.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "publish a blog post from a draft"
        },
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the draft from storage",
          "args": {
            "id": "draftId"
          },
          "bind": "draft"
        },
        {
          "op": "if",
          "cond": "draft is empty",
          "then": "empty",
          "else": "render"
        },
        {
          "op": "throw",
          "label": "empty",
          "tag": "EmptyDraft",
          "message": "draft has no content",
          "channel": "escape"
        },
        {
          "op": "call",
          "label": "render",
          "target": "renderHtml",
          "args": {
            "draft": "draft"
          },
          "bind": "html",
          "onError": [
            {
              "tag": "BadMarkdown",
              "goto": "fallback"
            }
          ]
        },
        {
          "op": "call",
          "label": "upload",
          "target": "uploadHtml",
          "args": {
            "html": "html"
          },
          "bind": "url"
        },
        {
          "op": "let",
          "label": "fallback",
          "name": "html",
          "expr": "a plain-text version of the draft content"
        },
        {
          "op": "goto",
          "to": "upload"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:3",
      "params": [
        "draft"
      ],
      "channels": {
        "A": "the rendered HTML string",
        "E": [
          "BadMarkdown"
        ],
        "R": []
      },
      "touches": [
        "src/render.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "if",
          "cond": "draft body is empty",
          "then": "empty",
          "else": "ok"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "empty HTML string"
        },
        {
          "op": "throw",
          "label": "ok",
          "tag": "BadMarkdown",
          "message": "markdown syntax is invalid",
          "channel": "die"
        },
        {
          "op": "return",
          "expr": "the rendered HTML"
        }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:5",
      "params": [
        "html"
      ],
      "channels": {
        "A": "the published URL",
        "E": [],
        "R": [
          "the S3 client"
        ]
      },
      "touches": [
        "src/upload.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "s3.put",
          "desc": "write HTML to S3 bucket",
          "args": {
            "body": "html"
          },
          "bind": "url"
        },
        {
          "op": "return",
          "expr": "url"
        }
      ]
    }
  },
