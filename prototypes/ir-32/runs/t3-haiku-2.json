    "importContacts": {
      "name": "importContacts",
      "role": "handler",
      "loc": "src/import/contacts.ts:1",
      "params": ["uploadId"],
      "channels": {
        "A": "import result with saved and skipped counts",
        "E": ["BadCsv", "NoUpload"],
        "R": []
      },
      "touches": ["src/import/contacts.ts"],
      "enteredBy": ["src/import/contacts.test.ts"],
      "steps": [
        {
          "op": "note",
          "note": "import contacts from CSV in S3"
        },
        {
          "op": "call",
          "target": "fetchUpload",
          "args": {"id": "uploadId"},
          "bind": "bytes"
        },
        {
          "op": "call",
          "target": "parseRows",
          "args": {"data": "bytes"},
          "bind": "rows"
        },
        {
          "op": "let",
          "label": "loop",
          "name": "saved",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "skipped",
          "expr": "0"
        },
        {
          "op": "let",
          "name": "i",
          "expr": "0"
        },
        {
          "op": "if",
          "cond": "i >= rows.length",
          "then": "done",
          "else": "next"
        },
        {
          "op": "let",
          "label": "next",
          "name": "row",
          "expr": "rows[i]"
        },
        {
          "op": "call",
          "target": "saveContact",
          "args": {"item": "row"},
          "bind": "id",
          "onError": [
            {
              "tag": "Duplicate",
              "goto": "skip"
            }
          ]
        },
        {
          "op": "let",
          "name": "saved",
          "expr": "saved + 1"
        },
        {
          "op": "goto",
          "to": "advance"
        },
        {
          "op": "let",
          "label": "skip",
          "name": "skipped",
          "expr": "skipped + 1"
        },
        {
          "op": "let",
          "label": "advance",
          "name": "i",
          "expr": "i + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "effect",
          "label": "done",
          "kind": "metrics.write",
          "desc": "record import metrics",
          "args": {"saved": "saved", "skipped": "skipped"}
        },
        {
          "op": "return",
          "expr": "{saved, skipped}"
        }
      ]
    },
