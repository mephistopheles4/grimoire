{
  "id": "checkout-cart-total",
  "title": "Checkout · the cart total",
  "blurb": "checkout turns a cart into an order: it loads the cart, prices it in a loop, and charges the total. A zero total short-circuits to a message, and a declined card is caught and mailed to the customer.",
  "entry": "checkout",
  "env": {
    "currency": "GBP"
  },
  "files": [
    {
      "path": "src/checkout.ts",
      "change": "edit",
      "why": "holds the checkout handler that ties pricing and payment together",
      "adds": 62,
      "dels": 11
    },
    {
      "path": "src/pricing.ts",
      "change": "new",
      "why": "holds the new priceCart pure pricing loop",
      "adds": 38,
      "dels": 0
    },
    {
      "path": "src/cart-store.ts",
      "change": "edit",
      "why": "holds the loadCart lookup checkout calls",
      "adds": 9,
      "dels": 1
    },
    {
      "path": "src/payments.ts",
      "change": "edit",
      "why": "holds the charge effect checkout calls",
      "adds": 27,
      "dels": 4
    }
  ],
