      "steps": [
        {
          "op": "let",
          "name": "sum",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loop",
          "cond": "no items remain",
          "then": "done",
          "else": "add"
        },
        {
          "op": "let",
          "label": "add",
          "name": "sum",
          "expr": "sum + the next item's price"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "return",
          "label": "done",
          "expr": "sum"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:6",
      "params": [
        "total"
      ],
      "channels": {
        "A": "the order id",
        "E": [
          "CardDeclined"
        ],
        "R": [
          "the Stripe client"
        ]
      },
      "touches": [
        "src/payments.ts"
      ],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the card for the total",
          "args": {
            "total": "total"
          },
          "bind": "orderId"
        },
        {
          "op": "return",
          "expr": "orderId"
        }
      ]
    }
