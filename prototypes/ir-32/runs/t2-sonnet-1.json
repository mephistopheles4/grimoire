  "nodes": {
    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:10",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "an order id, or a status message when there's nothing to buy or the card is declined",
        "E": [
          "NoCart",
          "CardDeclined"
        ],
        "R": [
          "the cart table",
          "the Stripe client"
        ]
      },
      "touches": [
        "src/checkout.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "turn a cart into an order"
        },
        {
          "op": "call",
          "target": "loadCart",
          "args": {
            "cartId": "cartId"
          },
          "bind": "cart",
          "aside": "no onError here — NoCart is not caught, it escapes"
        },
        {
          "op": "call",
          "target": "priceCart",
          "args": {
            "cart": "cart"
          },
          "bind": "total"
        },
        {
          "op": "if",
          "cond": "total is zero",
          "then": "empty",
          "else": "pay"
        },
        {
          "op": "call",
          "label": "pay",
          "target": "charge",
          "args": {
            "total": "total"
          },
          "bind": "orderId",
          "aside": "the only call that can fail here",
          "onError": [
            {
              "tag": "CardDeclined",
              "goto": "declined",
              "bind": "why"
            }
          ]
        },
        {
          "op": "return",
          "expr": "orderId"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "email the customer that the charge was declined",
          "args": {
            "to": "the customer",
            "reason": "why"
          }
        },
        {
          "op": "return",
          "expr": "\"payment declined\""
        }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:5",
      "params": [
