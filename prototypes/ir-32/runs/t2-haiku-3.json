        {
          "op": "if",
          "cond": "total is zero",
          "then": "empty",
          "else": "proceed"
        },
        {
          "op": "call",
          "label": "proceed",
          "target": "charge",
          "args": {"amount": "total"},
          "bind": "orderId",
          "onError": [
