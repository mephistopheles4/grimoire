      "steps": [
        {
          "op": "effect",
          "kind": "db.get",
          "desc": "read the cart row",
          "args": {"id": "id"},
          "bind": "row"
        },
        {
          "op": "if",
          "cond": "row is missing",
          "then": "missing",
          "else": "found"
        },
        {
          "op": "return",
          "label": "found",
          "expr": "row"
        },
        {
          "op": "throw",
          "label": "missing",
          "tag": "NoCart",
          "message": "no cart for that id",
          "channel": "escape"
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:3",
      "params": ["cart"],
      "channels": {
        "A": "the total in pence",
        "E": [],
        "R": []
      },
      "touches": ["src/pricing.ts"],
      "enteredBy": ["src/pricing.test.ts"],
      "steps": [
        {
          "op": "let",
          "name": "i",
          "expr": "0",
          "label": "loop"
        },
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "if",
          "cond": "i < cart.items.length",
          "then": "add",
          "else": "return"
        },
        {
          "op": "let",
          "label": "add",
          "name": "total",
          "expr": "total + cart.items[i].price"
        },
        {
          "op": "let",
          "name": "i",
          "expr": "i + 1"
        },
        {
          "op": "goto",
          "to": "loop"
        },
        {
          "op": "return",
          "label": "return",
          "expr": "total"
        }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:2",
      "params": ["amount"],
      "channels": {
        "A": "an order id",
        "E": ["CardDeclined"],
