      },
      "touches": ["src/payments.ts"],
      "enteredBy": [],
      "steps": [
        {
          "op": "effect",
          "kind": "stripe.charge",
          "desc": "charge the customer's card",
          "args": {"amount": "amount"},
          "bind": "result"
        },
        {
          "op": "if",
          "cond": "charge succeeded",
          "then": "success",
          "else": "failed"
        },
        {
          "op": "return",
          "label": "success",
          "expr": "result.orderId"
        },
        {
          "op": "throw",
          "label": "failed",
          "tag": "CardDeclined",
          "message": "card declined",
          "channel": "retry"
        }
      ]
    }
