      ],
      "enteredBy": [
        "src/pricing.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "sum each item's price times quantity, in pence"
        },
        {
          "op": "let",
          "name": "total",
          "expr": "0"
        },
        {
          "op": "if",
          "label": "loopTop",
          "cond": "items remain",
          "then": "addItem",
          "else": "doneLoop"
        },
        {
          "op": "let",
          "label": "addItem",
          "name": "total",
          "expr": "total + nextItem.price * nextItem.qty"
        },
        {
          "op": "goto",
          "to": "loopTop"
        },
        {
          "op": "return",
          "label": "doneLoop",
          "expr": "total"
        }
      ]
    },
