    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:14",
      "params": [
        "cartId"
      ],
      "channels": {
        "A": "the order id",
        "E": [
          "NoCart",
          "CardDeclined"
        ],
        "R": []
      },
      "touches": [
        "src/checkout.ts"
      ],
      "enteredBy": [
        "src/checkout.test.ts"
      ],
      "steps": [
        {
          "op": "note",
          "note": "turn a cart into an order, or bail out early when there is nothing to charge"
        },
        {
          "op": "call",
          "target": "loadCart",
          "args": {
            "cartId": "cartId"
          },
          "bind": "cart"
        },
        {
          "op": "call",
          "target": "priceCart",
          "args": {
            "cart": "cart"
          },
          "bind": "total"
        },
        {
          "op": "if",
          "cond": "total is zero",
          "then": "empty",
          "else": "pay"
        },
        {
          "op": "return",
          "label": "empty",
          "expr": "\"nothing to buy\""
        },
        {
          "op": "call",
          "label": "pay",
          "target": "charge",
          "args": {
            "total": "total"
          },
          "bind": "orderId",
          "aside": "the only call that can fail",
          "onError": [
            {
              "tag": "CardDeclined",
              "goto": "declined",
              "bind": "why"
            }
          ]
        },
        {
          "op": "return",
          "expr": "orderId"
        },
        {
          "op": "effect",
          "label": "declined",
          "kind": "mail.send",
          "desc": "email the customer that the card was declined",
          "args": {
            "to": "cart.customerEmail",
            "reason": "why"
          }
        },
        {
          "op": "return",
          "expr": "\"payment declined\""
        }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:5",
      "params": [
        "cart"
      ],
      "channels": {
        "A": "the total in pence",
        "E": [],
        "R": []
