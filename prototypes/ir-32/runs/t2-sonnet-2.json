          { "k": "move", "at": 3, "next": 5 },
          { "k": "call", "at": 5, "to": "charge", "next": 6 },
          { "k": "effect", "at": 0, "kind": "stripe.charge", "desc": "charge the card via Stripe", "next": 1, "result": "order-8841" },
