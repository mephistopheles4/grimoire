{
  "id": "cart-checkout",
  "title": "Cart checkout and payment",
  "blurb": "Complete checkout flow: load cart from database, price items through a loop, charge the card via Stripe, handle card decline with email notification.",
  "entry": "checkout",
  "env": { "locale": "en-GB" },
  "files": [
    { "path": "src/checkout.ts", "change": "edit", "why": "main checkout handler with charge call and decline handler", "adds": 62, "dels": 11 },
    { "path": "src/pricing.ts", "change": "new", "why": "pricing loop that calculates cart total", "adds": 38, "dels": 0 },
    { "path": "src/cart-store.ts", "change": "edit", "why": "cart loader that queries the database", "adds": 9, "dels": 1 },
    { "path": "src/payments.ts", "change": "edit", "why": "payment charge handler for Stripe", "adds": 27, "dels": 4 }
  ],
  "layers": {
    "production": { "nodes": {} },
    "tests": {
      "entry": "checkout",
      "nodes": {
        "charge": { "R": ["a stub that always declines · checkout.test.ts:44"] },
        "loadCart": { "R": ["an in-memory map · checkout.test.ts:12"] }
      }
    },
    "smoke": {
      "entry": "checkout",
      "nodes": {}
    }
  },
  "nodes": {
    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:8",
      "params": ["cartId"],
      "channels": {
        "A": "order id or decline message",
        "E": ["CardDeclined"],
        "R": ["the Stripe client"]
      },
      "touches": ["src/checkout.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        { "op": "note", "note": "load cart, price items, charge card, handle decline" },
        { "op": "call", "target": "loadCart", "args": { "cartId": "cartId" }, "bind": "cart" },
        { "op": "call", "target": "priceCart", "args": { "cart": "cart" }, "bind": "total" },
        { "op": "if", "cond": "total is zero", "then": "empty", "else": "charge_step" },
        { "op": "call", "label": "charge_step", "target": "charge", "args": { "total": "total" }, "bind": "orderId", "onError": [{ "tag": "CardDeclined", "goto": "declined", "bind": "reason" }] },
        { "op": "return", "expr": "orderId" },
        { "op": "return", "label": "empty", "expr": "\"nothing to buy\"" },
        { "op": "effect", "label": "declined", "kind": "mail.send", "desc": "notify customer of declined payment", "args": { "message": "Your payment was declined" } },
        { "op": "return", "expr": "\"payment declined\"" }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:3",
      "params": ["cartId"],
      "channels": {
        "A": "the cart object",
        "E": ["NoCart"],
        "R": ["the cart table"]
      },
      "touches": ["src/cart-store.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        { "op": "effect", "kind": "db.get", "desc": "read the cart row", "args": { "cartId": "cartId" }, "bind": "row" },
        { "op": "if", "cond": "row is missing", "then": "missing", "else": "found" },
        { "op": "return", "label": "found", "expr": "row" },
        { "op": "throw", "label": "missing", "tag": "NoCart", "message": "no cart for that id", "channel": "escape" }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:5",
      "params": ["cart"],
      "channels": {
        "A": "total price in pence",
        "E": [],
        "R": []
      },
      "touches": ["src/pricing.ts"],
      "enteredBy": ["src/pricing.test.ts"],
      "steps": [
        { "op": "let", "name": "total", "expr": "0" },
        { "op": "let", "label": "loop", "name": "item", "expr": "next item in cart.items" },
        { "op": "if", "cond": "item exists", "then": "process", "else": "done" },
        { "op": "let", "label": "process", "name": "total", "expr": "total + item.price" },
        { "op": "goto", "to": "loop" },
        { "op": "return", "label": "done", "expr": "total" }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:12",
      "params": ["total"],
      "channels": {
        "A": "order id",
        "E": ["CardDeclined"],
        "R": ["the Stripe client"]
      },
      "touches": ["src/payments.ts"],
      "enteredBy": [],
      "steps": [
        { "op": "effect", "kind": "stripe.charge", "desc": "charge the card", "args": { "amount": "total" }, "bind": "result" },
        { "op": "if", "cond": "charge succeeded", "then": "success", "else": "failed" },
        { "op": "return", "label": "success", "expr": "result.orderId" },
        { "op": "throw", "label": "failed", "tag": "CardDeclined", "message": "card was declined", "channel": "retry" }
      ]
    }
  },
