{
  "id": "checkout-order",
  "title": "Checkout · process cart to order",
  "blurb": "An ecommerce checkout orchestration that loads a cart, calculates its total through a pricing loop, and charges a payment card. Handles empty carts and declined cards.",
  "entry": "checkout",
  "env": {},
  "files": [
    { "path": "src/checkout.ts", "change": "edit", "why": "the main checkout handler that orchestrates the flow", "adds": 62, "dels": 11 },
    { "path": "src/pricing.ts", "change": "new", "why": "the loop that calculates cart total by summing item prices", "adds": 38, "dels": 0 },
    { "path": "src/cart-store.ts", "change": "edit", "why": "the cart lookup that retrieves cart data", "adds": 9, "dels": 1 },
    { "path": "src/payments.ts", "change": "edit", "why": "the charge effect that bills the payment method", "adds": 27, "dels": 4 }
  ],
  "layers": {
    "production": { "nodes": {} },
    "tests": {
      "entry": "checkout",
      "nodes": {
        "loadCart": { "R": ["an in-memory map · checkout.test.ts:12"] },
        "charge": { "R": ["a stub that always declines · checkout.test.ts:44"] }
      }
    },
    "smoke": { "nodes": {} }
  },
  "nodes": {
    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:1",
      "params": ["cartId"],
      "channels": { "A": "order id", "E": ["CardDeclined"], "R": ["payment system"] },
      "touches": ["src/checkout.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        { "op": "note", "note": "turn a cart into an order by pricing and charging" },
        { "op": "call", "target": "loadCart", "args": { "id": "cartId" }, "bind": "cart" },
        { "op": "call", "target": "priceCart", "args": { "items": "cart.items" }, "bind": "total" },
        { "op": "if", "cond": "total is zero", "then": "empty", "else": "proceed" },
        { "op": "call", "label": "proceed", "target": "charge", "args": { "amount": "total" }, "bind": "orderId", "onError": [{ "tag": "CardDeclined", "goto": "declined" }] },
        { "op": "return", "expr": "orderId" },
        { "op": "return", "label": "empty", "expr": "\"nothing to buy\"" },
        { "op": "effect", "label": "declined", "kind": "mail.send", "desc": "notify customer of declined card", "args": { "cartId": "cartId" } },
        { "op": "return", "expr": "\"payment declined\"" }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:1",
      "params": ["id"],
      "channels": { "A": "cart object", "E": ["NoCart"], "R": ["the cart table"] },
      "touches": ["src/cart-store.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        { "op": "effect", "kind": "db.get", "desc": "read the cart row", "args": { "id": "id" }, "bind": "row" },
        { "op": "if", "cond": "row exists", "then": "found", "else": "missing" },
        { "op": "return", "label": "found", "expr": "row" },
        { "op": "throw", "label": "missing", "tag": "NoCart", "message": "cart not found", "channel": "escape" }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:1",
      "params": ["items"],
      "channels": { "A": "total in pence", "E": [], "R": [] },
      "touches": ["src/pricing.ts"],
      "enteredBy": ["src/pricing.test.ts"],
      "steps": [
        { "op": "let", "name": "total", "expr": "0" },
        { "op": "let", "label": "loop", "name": "item", "expr": "next item from items" },
        { "op": "if", "cond": "item exists", "then": "add", "else": "done" },
        { "op": "let", "label": "add", "name": "total", "expr": "total + item.price" },
        { "op": "goto", "to": "loop" },
        { "op": "return", "label": "done", "expr": "total" }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:1",
      "params": ["amount"],
      "channels": { "A": "order id", "E": ["CardDeclined"], "R": ["the Stripe client"] },
      "touches": ["src/payments.ts"],
      "enteredBy": [],
      "steps": [
        { "op": "effect", "kind": "stripe.charge", "desc": "charge the card", "args": { "amount": "amount" }, "bind": "result" },
        { "op": "if", "cond": "result.success", "then": "ok", "else": "failed" },
        { "op": "return", "label": "ok", "expr": "result.orderId" },
        { "op": "throw", "label": "failed", "tag": "CardDeclined", "message": "card was declined", "channel": "retry" }
      ]
    }
  },
  "presets": [
    {
      "name": "a paid order",
      "blurb": "The cart loads, prices at 4500 pence across three items, and the charge succeeds.",
      "input": { "cartId": "c-paid-1" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "checkout" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "call", "at": 1, "to": "loadCart", "next": 2 },
          { "k": "effect", "at": 0, "kind": "db.get", "desc": "read the cart row", "next": 1, "result": { "id": "c-paid-1", "items": [{ "price": 2000 }, { "price": 1500 }, { "price": 1000 }] } },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "return", "at": 2, "value": { "id": "c-paid-1", "items": [{ "price": 2000 }, { "price": 1500 }, { "price": 1000 }] } },
          { "k": "move", "at": 2, "next": 3 },
          { "k": "call", "at": 3, "to": "priceCart", "next": 4 },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "move", "at": 2, "next": 3 },
          { "k": "move", "at": 3, "next": 4 },
          { "k": "move", "at": 4, "next": 1 },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "move", "at": 2, "next": 3 },
          { "k": "move", "at": 3, "next": 4 },
          { "k": "move", "at": 4, "next": 1 },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "move", "at": 2, "next": 5 },
          { "k": "return", "at": 5, "value": 4500 },
          { "k": "move", "at": 4, "next": 5 },
          { "k": "move", "at": 5, "next": 6 },
          { "k": "call", "at": 6, "to": "charge", "next": 7 },
          { "k": "effect", "at": 0, "kind": "stripe.charge", "desc": "charge the card", "next": 1, "result": { "success": true, "orderId": "o-paid-1" } },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "return", "at": 2, "value": "o-paid-1" },
          { "k": "return", "at": 7, "value": "o-paid-1" },
          { "k": "done", "result": "o-paid-1" }
        ]
      }
    },
    {
      "name": "the card declines",
      "blurb": "The cart loads and prices at 3000 pence, the charge fails and is caught by the handler, mail is sent, and it returns payment declined.",
      "input": { "cartId": "c-declined-1" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "checkout" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "call", "at": 1, "to": "loadCart", "next": 2 },
          { "k": "effect", "at": 0, "kind": "db.get", "desc": "read the cart row", "next": 1, "result": { "id": "c-declined-1", "items": [{ "price": 1200 }, { "price": 1800 }] } },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "return", "at": 2, "value": { "id": "c-declined-1", "items": [{ "price": 1200 }, { "price": 1800 }] } },
          { "k": "move", "at": 2, "next": 3 },
          { "k": "call", "at": 3, "to": "priceCart", "next": 4 },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "move", "at": 2, "next": 3 },
          { "k": "move", "at": 3, "next": 4 },
          { "k": "move", "at": 4, "next": 1 },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "move", "at": 2, "next": 5 },
          { "k": "return", "at": 5, "value": 3000 },
          { "k": "move", "at": 4, "next": 5 },
          { "k": "move", "at": 5, "next": 6 },
          { "k": "call", "at": 6, "to": "charge", "next": 7 },
          { "k": "effect", "at": 0, "kind": "stripe.charge", "desc": "charge the card" },
          { "k": "raise", "at": 0, "tag": "CardDeclined", "message": "card was declined", "channel": "retry" },
          { "k": "unwind" },
          { "k": "handled", "at": 6, "goto": "declined", "next": 8 },
          { "k": "effect", "at": 8, "kind": "mail.send", "desc": "notify customer of declined card", "next": 9 },
          { "k": "return", "at": 9, "value": "payment declined" },
          { "k": "done", "result": "payment declined" }
        ]
      }
    }
  ],
  "sheet": { "scopeRule": "one graph per entry point", "graphsNotDrawn": [] }
}
