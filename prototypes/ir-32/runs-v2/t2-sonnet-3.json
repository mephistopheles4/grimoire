{
  "id": "checkout-cart-total",
  "title": "Checkout · the cart total",
  "blurb": "checkout turns a cart into an order: it loads the cart, prices it in a loop, and either reports an empty cart, charges the card, or reports a decline. This graph covers the paid path and the declined-card path.",
  "entry": "checkout",
  "env": {},
  "files": [
    { "path": "src/checkout.ts", "change": "edit", "why": "adds the checkout handler that turns a cart into an order", "adds": 62, "dels": 11 },
    { "path": "src/pricing.ts", "change": "new", "why": "adds priceCart, the pure pricing loop", "adds": 38, "dels": 0 },
    { "path": "src/cart-store.ts", "change": "edit", "why": "adds loadCart, the cart lookup", "adds": 9, "dels": 1 },
    { "path": "src/payments.ts", "change": "edit", "why": "adds charge, the Stripe charge call", "adds": 27, "dels": 4 }
  ],
  "layers": {
    "production": { "nodes": {} },
    "tests": {
      "nodes": {
        "charge": { "R": ["a stub that always declines · checkout.test.ts:44"] },
        "loadCart": { "R": ["an in-memory map · checkout.test.ts:12"] }
      }
    },
    "smoke": { "entry": "checkout", "nodes": {} }
  },
  "nodes": {
    "checkout": {
      "name": "checkout",
      "role": "handler",
      "loc": "src/checkout.ts:10",
      "params": ["cartId"],
      "channels": {
        "A": "the order id, or a message when the cart is empty or the card is declined",
        "E": ["NoCart", "CardDeclined"],
        "R": ["a mail sender"]
      },
      "touches": ["src/checkout.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        { "op": "note", "note": "turn a cart into an order, or a plain message when there's nothing to buy or the card is declined" },
        { "op": "call", "target": "loadCart", "args": { "cartId": "cartId" }, "bind": "cart", "aside": "raises NoCart on the escape channel when the row is missing; checkout does not catch it" },
        { "op": "call", "target": "priceCart", "args": { "cart": "cart" }, "bind": "total" },
        { "op": "if", "cond": "total is zero", "then": "empty", "else": "chargeStep" },
        {
          "op": "call", "label": "chargeStep", "target": "charge", "args": { "total": "total" }, "bind": "orderId",
          "aside": "the only call that can fail",
          "onError": [{ "tag": "CardDeclined", "goto": "declined", "bind": "why" }]
        },
        { "op": "return", "expr": "orderId" },
        { "op": "return", "label": "empty", "expr": "\"nothing to buy\"" },
        { "op": "effect", "label": "declined", "kind": "mail.send", "desc": "email the customer that the card was declined", "args": { "to": "cart.customerEmail", "reason": "why" } },
        { "op": "return", "expr": "\"payment declined\"" }
      ]
    },
    "priceCart": {
      "name": "priceCart",
      "role": "pure",
      "loc": "src/pricing.ts:3",
      "params": ["cart"],
      "channels": { "A": "the total in pence", "E": [], "R": [] },
      "touches": ["src/pricing.ts"],
      "enteredBy": ["src/pricing.test.ts"],
      "steps": [
        { "op": "note", "note": "sum each item's price into a running total, one item at a time" },
        { "op": "let", "name": "total", "expr": "0" },
        { "op": "let", "name": "remaining", "expr": "cart.items" },
        { "op": "if", "label": "loopTop", "cond": "remaining is empty", "then": "finish", "else": "loopBody" },
        { "op": "let", "label": "loopBody", "name": "total", "expr": "total + remaining[0].price * remaining[0].qty" },
        { "op": "let", "name": "remaining", "expr": "remaining.slice(1)" },
        { "op": "goto", "to": "loopTop" },
        { "op": "return", "label": "finish", "expr": "total" }
      ]
    },
    "loadCart": {
      "name": "loadCart",
      "role": "io",
      "loc": "src/cart-store.ts:4",
      "params": ["cartId"],
      "channels": { "A": "the cart", "E": ["NoCart"], "R": ["the cart table"] },
      "touches": ["src/cart-store.ts"],
      "enteredBy": ["src/checkout.test.ts"],
      "steps": [
        { "op": "effect", "kind": "db.get", "desc": "read the cart row", "args": { "cartId": "cartId" }, "bind": "row" },
        { "op": "if", "cond": "row is missing", "then": "missing", "else": "found" },
        { "op": "return", "label": "found", "expr": "row" },
        { "op": "throw", "label": "missing", "tag": "NoCart", "message": "no cart row for that id", "channel": "escape" }
      ]
    },
    "charge": {
      "name": "charge",
      "role": "io",
      "loc": "src/payments.ts:6",
      "params": ["total"],
      "channels": { "A": "an order id", "E": ["CardDeclined"], "R": ["the Stripe client"] },
      "touches": ["src/payments.ts"],
      "enteredBy": [],
      "steps": [
        { "op": "effect", "kind": "stripe.charge", "desc": "charge the card for the total", "args": { "amount": "total" }, "bind": "result" },
        { "op": "return", "expr": "result.orderId" }
      ]
    }
  },
  "presets": [
