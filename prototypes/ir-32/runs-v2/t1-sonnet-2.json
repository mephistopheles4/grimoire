{
  "id": "publish-post-retry",
  "title": "Publish a post · the upload retries",
  "blurb": "publishPost reads a draft, renders it to html, and uploads the result. A bad-markdown throw from the renderer is caught and falls back to a plain-text version, and the upload to S3 retries once before it succeeds.",
  "entry": "publishPost",
  "env": {},
  "files": [
    { "path": "src/publish.ts", "change": "edit", "why": "holds publishPost, which reads the draft, renders it, catches bad markdown, and uploads the result", "adds": 40, "dels": 6 },
    { "path": "src/render.ts", "change": "new", "why": "holds renderHtml, the pure markdown-to-html conversion", "adds": 55, "dels": 0 },
    { "path": "src/upload.ts", "change": "edit", "why": "holds uploadHtml, which uploads the rendered html to S3", "adds": 18, "dels": 2 }
  ],
  "layers": {
    "production": { "nodes": {} },
    "tests": {
      "entry": "publishPost",
      "nodes": { "uploadHtml": { "R": ["a fake bucket · publish.test.ts:31"] } }
    }
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:12",
      "params": ["draftId"],
      "channels": { "A": "the published URL", "E": ["EmptyDraft", "BadMarkdown"], "R": ["the draft store", "the S3 client"] },
      "touches": ["src/publish.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        { "op": "note", "note": "publish a post: read the draft, render it, catch bad markdown with a plain-text fallback, then upload and return the URL" },
        { "op": "effect", "kind": "db.get", "desc": "read the draft", "args": { "id": "draftId" }, "bind": "draft" },
        { "op": "if", "cond": "draft is empty", "then": "empty", "else": "render" },
        { "op": "throw", "label": "empty", "tag": "EmptyDraft", "message": "the draft is empty", "channel": "escape" },
        {
          "op": "call", "label": "render", "target": "renderHtml", "args": { "draft": "draft" }, "bind": "html",
          "aside": "the render can fail on unparseable markdown",
          "onError": [{ "tag": "BadMarkdown", "goto": "fallback", "bind": "why" }]
        },
        { "op": "goto", "to": "upload" },
        { "op": "let", "label": "fallback", "name": "html", "expr": "a plain-text version of the draft" },
        { "op": "call", "label": "upload", "target": "uploadHtml", "args": { "html": "html" }, "bind": "url" },
        { "op": "return", "expr": "url" }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:5",
      "params": ["draft"],
      "channels": { "A": "the rendered html", "E": ["BadMarkdown"], "R": [] },
      "touches": ["src/render.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        { "op": "if", "cond": "the markdown will not parse", "then": "bad", "else": "ok" },
        { "op": "return", "label": "ok", "expr": "the rendered html" },
        { "op": "throw", "label": "bad", "tag": "BadMarkdown", "message": "the markdown will not parse", "channel": "die" }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:9",
      "params": ["html"],
      "channels": { "A": "the published URL", "E": [], "R": ["the S3 client"] },
      "touches": ["src/upload.ts"],
      "enteredBy": [],
      "steps": [
        { "op": "effect", "kind": "s3.put", "desc": "upload the html to the bucket", "args": { "html": "html" }, "bind": "url" },
        { "op": "return", "expr": "url" }
      ]
    }
  },
  "presets": [
    {
      "name": "the happy path",
      "blurb": "A real draft renders cleanly and the upload succeeds on its second attempt.",
      "input": { "draftId": "d-1" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft", "next": 2, "result": { "title": "Hello World", "body": "# Hello World\n\nBody text." } },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml", "next": 5 },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "return", "at": 1, "value": "<h1>Hello World</h1><p>Body text.</p>" },
          { "k": "move", "at": 5, "next": 7 },
          { "k": "call", "at": 7, "to": "uploadHtml", "next": 8 },
          { "k": "effect", "at": 0, "kind": "s3.put", "desc": "upload the html to the bucket", "next": 1, "result": { "url": "https://cdn.example.com/posts/d-1.html" }, "attempt": 2 },
          { "k": "return", "at": 1, "value": "https://cdn.example.com/posts/d-1.html" },
          { "k": "return", "at": 8, "value": "https://cdn.example.com/posts/d-1.html" },
          { "k": "done", "result": "https://cdn.example.com/posts/d-1.html" }
        ]
      }
    },
    {
      "name": "bad markdown",
      "blurb": "The render throws BadMarkdown, publishPost catches it and falls back to a plain-text version, and that fallback html uploads.",
      "input": { "draftId": "d-2" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft", "next": 2, "result": { "title": "Broken Draft", "body": "<<<not markdown>>>" } },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml", "next": 5 },
          { "k": "move", "at": 0, "next": 2 },
          { "k": "raise", "at": 2, "tag": "BadMarkdown", "message": "the markdown will not parse", "channel": "die" },
          { "k": "unwind" },
          { "k": "handled", "at": 4, "goto": "fallback", "next": 6 },
          { "k": "move", "at": 6, "next": 7 },
          { "k": "call", "at": 7, "to": "uploadHtml", "next": 8 },
          { "k": "effect", "at": 0, "kind": "s3.put", "desc": "upload the html to the bucket", "next": 1, "result": { "url": "https://cdn.example.com/posts/d-2.html" }, "attempt": 2 },
          { "k": "return", "at": 1, "value": "https://cdn.example.com/posts/d-2.html" },
          { "k": "return", "at": 8, "value": "https://cdn.example.com/posts/d-2.html" },
          { "k": "done", "result": "https://cdn.example.com/posts/d-2.html" }
        ]
      }
    }
  ],
  "sheet": { "scopeRule": "one graph per entry point", "graphsNotDrawn": [] }
}
