{
  "id": "publish-post-retry",
  "title": "publishPost · render, then upload with a retry",
  "blurb": "publishPost reads a draft, renders it to HTML, and uploads it. A bad-markdown failure from the render is caught and falls back to plain text; the upload itself performs an effect that can need a second attempt before it succeeds.",
  "entry": "publishPost",
  "env": {},
  "files": [
    { "path": "src/publish.ts", "change": "edit", "why": "holds the publishPost handler that reads, renders and uploads the draft", "adds": 40, "dels": 6 },
    { "path": "src/render.ts", "change": "new", "why": "holds the pure renderHtml node the handler calls", "adds": 55, "dels": 0 },
    { "path": "src/upload.ts", "change": "edit", "why": "holds the uploadHtml node that performs the s3.put effect", "adds": 18, "dels": 2 }
  ],
  "layers": {
    "production": { "nodes": {} },
    "tests": {
      "entry": "publishPost",
      "nodes": { "uploadHtml": { "R": ["a fake bucket · publish.test.ts:31"] } }
    }
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:10",
      "params": ["draftId"],
      "channels": { "A": "the published URL", "E": ["EmptyDraft", "BadMarkdown"], "R": ["the draft store", "the S3 client"] },
      "touches": ["src/publish.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        { "op": "note", "note": "publish a post: read the draft, render it to HTML, upload it, and return the URL" },
        { "op": "effect", "kind": "db.get", "desc": "read the draft from the store", "args": { "id": "draftId" }, "bind": "draft" },
        { "op": "if", "cond": "draft is empty", "then": "empty", "else": "haveDraft" },
        { "op": "throw", "label": "empty", "tag": "EmptyDraft", "message": "no draft found for that id", "channel": "escape" },
        {
          "op": "call", "label": "haveDraft", "target": "renderHtml", "args": { "draft": "draft" }, "bind": "html",
          "aside": "the only call this node catches",
          "onError": [{ "tag": "BadMarkdown", "goto": "fallback", "bind": "why" }]
        },
        { "op": "goto", "to": "upload" },
        { "op": "let", "label": "fallback", "name": "html", "expr": "plainTextVersion(draft)" },
        { "op": "call", "label": "upload", "target": "uploadHtml", "args": { "html": "html" }, "bind": "url", "aside": "the s3 put inside retries on its own before this call fails" },
        { "op": "return", "expr": "url" }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:5",
      "params": ["draft"],
      "channels": { "A": "the rendered HTML string", "E": ["BadMarkdown"], "R": [] },
      "touches": ["src/render.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        { "op": "if", "cond": "the markdown body is empty", "then": "bad", "else": "ok" },
        { "op": "return", "label": "ok", "expr": "renderMarkdown(draft.body)" },
        { "op": "throw", "label": "bad", "tag": "BadMarkdown", "message": "the markdown has no parseable body", "channel": "die" }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:12",
      "params": ["html"],
      "channels": { "A": "the published URL", "E": ["UploadFailed"], "R": ["the S3 client"] },
      "touches": ["src/upload.ts"],
      "enteredBy": [],
      "steps": [
        { "op": "effect", "kind": "s3.put", "desc": "PUT the html to the bucket", "args": { "body": "html" }, "bind": "url" },
        { "op": "return", "expr": "url" }
      ]
    }
  },
  "presets": [
    {
      "name": "the happy path",
      "blurb": "A real draft renders cleanly and the upload succeeds on its second attempt.",
      "input": { "draftId": "d-1" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft from the store", "next": 2, "result": { "id": "d-1", "body": "# Hello\n\nSome great content." } },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml", "next": 5 },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "return", "at": 1, "value": "<h1>Hello</h1><p>Some great content.</p>" },
          { "k": "move", "at": 5, "next": 7 },
          { "k": "call", "at": 7, "to": "uploadHtml", "next": 8 },
          { "k": "effect", "at": 0, "kind": "s3.put", "desc": "PUT the html to the bucket", "next": 1, "attempt": 2, "result": { "url": "https://cdn.example.com/posts/d-1.html" } },
          { "k": "return", "at": 1, "value": "https://cdn.example.com/posts/d-1.html" },
          { "k": "return", "at": 8, "value": "https://cdn.example.com/posts/d-1.html" },
          { "k": "done", "result": "https://cdn.example.com/posts/d-1.html" }
        ]
      }
    },
    {
      "name": "bad markdown",
      "blurb": "The render throws BadMarkdown, publishPost catches it, and the fallback HTML uploads.",
      "input": { "draftId": "d-2" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft from the store", "next": 2, "result": { "id": "d-2", "body": "" } },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml", "next": 5 },
          { "k": "move", "at": 0, "next": 2 },
          { "k": "raise", "at": 2, "tag": "BadMarkdown", "message": "the markdown has no parseable body", "channel": "die" },
          { "k": "unwind" },
          { "k": "handled", "at": 4, "goto": "fallback", "next": 6 },
          { "k": "move", "at": 6, "next": 7 },
          { "k": "call", "at": 7, "to": "uploadHtml", "next": 8 },
          { "k": "effect", "at": 0, "kind": "s3.put", "desc": "PUT the html to the bucket", "next": 1, "attempt": 1, "result": { "url": "https://cdn.example.com/posts/d-2.html" } },
          { "k": "return", "at": 1, "value": "https://cdn.example.com/posts/d-2.html" },
          { "k": "return", "at": 8, "value": "https://cdn.example.com/posts/d-2.html" },
          { "k": "done", "result": "https://cdn.example.com/posts/d-2.html" }
        ]
      }
    }
  ],
  "sheet": { "scopeRule": "one graph per entry point", "graphsNotDrawn": [] }
}
