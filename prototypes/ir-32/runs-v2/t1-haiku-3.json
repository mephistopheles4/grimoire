{
  "id": "publish-post",
  "title": "Publish a blog post",
  "blurb": "A handler publishes a draft blog post by rendering it to HTML and uploading it to S3. The render can fail with bad markdown, and the upload is retried on first failure.",
  "entry": "publishPost",
  "env": { "draftId": "d-123" },
  "files": [
    { "path": "src/publish.ts", "change": "edit", "why": "holds publishPost", "adds": 40, "dels": 6 },
    { "path": "src/render.ts", "change": "new", "why": "holds renderHtml", "adds": 55, "dels": 0 },
    { "path": "src/upload.ts", "change": "edit", "why": "holds uploadHtml", "adds": 18, "dels": 2 }
  ],
  "layers": {
    "production": { "nodes": {} },
    "tests": {
      "nodes": {
        "uploadHtml": { "R": ["a fake bucket · publish.test.ts:31"] }
      }
    }
  },
  "nodes": {
    "publishPost": {
      "name": "publishPost",
      "role": "handler",
      "loc": "src/publish.ts:5",
      "params": ["draftId"],
      "channels": {
        "A": "the published URL",
        "E": ["EmptyDraft", "BadMarkdown"],
        "R": ["the draft store"]
      },
      "touches": ["src/publish.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        { "op": "note", "note": "publish a blog post from a draft" },
        { "op": "effect", "kind": "db.get", "desc": "read the draft", "args": { "id": "draftId" }, "bind": "draft" },
        { "op": "if", "cond": "draft is empty", "then": "empty", "else": "render" },
        { "op": "throw", "label": "empty", "tag": "EmptyDraft", "message": "draft has no content", "channel": "escape" },
        { "op": "call", "label": "render", "target": "renderHtml", "args": { "draft": "draft" }, "bind": "html", "onError": [{ "tag": "BadMarkdown", "goto": "fallback" }] },
        { "op": "call", "target": "uploadHtml", "args": { "html": "html" }, "bind": "url" },
        { "op": "return", "expr": "url" },
        { "op": "let", "label": "fallback", "name": "html", "expr": "plain-text version of draft" },
        { "op": "call", "target": "uploadHtml", "args": { "html": "html" }, "bind": "url" },
        { "op": "return", "expr": "url" }
      ]
    },
    "renderHtml": {
      "name": "renderHtml",
      "role": "pure",
      "loc": "src/render.ts:3",
      "params": ["draft"],
      "channels": {
        "A": "the rendered HTML",
        "E": ["BadMarkdown"],
        "R": []
      },
      "touches": ["src/render.ts"],
      "enteredBy": ["src/publish.test.ts"],
      "steps": [
        { "op": "if", "cond": "draft.body is empty", "then": "bad", "else": "parse" },
        { "op": "throw", "label": "bad", "tag": "BadMarkdown", "message": "body cannot be empty", "channel": "die" },
        { "op": "if", "label": "parse", "cond": "markdown is valid", "then": "ok", "else": "failed" },
        { "op": "throw", "label": "failed", "tag": "BadMarkdown", "message": "markdown parsing failed", "channel": "die" },
        { "op": "return", "label": "ok", "expr": "rendered HTML" }
      ]
    },
    "uploadHtml": {
      "name": "uploadHtml",
      "role": "io",
      "loc": "src/upload.ts:2",
      "params": ["html"],
      "channels": {
        "A": "the S3 URL",
        "E": [],
        "R": ["the S3 client"]
      },
      "touches": ["src/upload.ts"],
      "enteredBy": [],
      "steps": [
        { "op": "effect", "kind": "s3.put", "desc": "upload the HTML", "args": { "body": "html" }, "bind": "url" },
        { "op": "return", "expr": "url" }
      ]
    }
  },
  "presets": [
    {
      "name": "the happy path",
      "blurb": "The draft has content, the markdown renders, and the upload succeeds on the second attempt.",
      "input": { "draftId": "d-123" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft", "next": 2, "result": { "title": "Hello", "body": "# World" } },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml", "next": 5 },
          { "k": "move", "at": 0, "next": 2 },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "return", "at": 4, "value": "<h1>World</h1>" },
          { "k": "move", "at": 5, "next": 6 },
          { "k": "call", "at": 6, "to": "uploadHtml", "next": 7 },
          { "k": "effect", "at": 0, "kind": "s3.put", "desc": "upload the HTML", "attempt": 1 },
          { "k": "effect", "at": 0, "kind": "s3.put", "desc": "upload the HTML", "attempt": 2, "next": 1, "result": "https://s3.example.com/post-123" },
          { "k": "return", "at": 1, "value": "https://s3.example.com/post-123" },
          { "k": "return", "at": 7, "value": "https://s3.example.com/post-123" },
          { "k": "done", "result": "https://s3.example.com/post-123" }
        ]
      }
    },
    {
      "name": "bad markdown",
      "blurb": "The render throws BadMarkdown, publishPost catches it, and the fallback plain-text HTML uploads successfully.",
      "input": { "draftId": "d-456" },
      "walk": {
        "provenance": "authored",
        "steps": [
          { "k": "enter", "node": "publishPost" },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "effect", "at": 1, "kind": "db.get", "desc": "read the draft", "next": 2, "result": { "title": "Hello", "body": "[[[ invalid" } },
          { "k": "move", "at": 2, "next": 4 },
          { "k": "call", "at": 4, "to": "renderHtml", "next": 5 },
          { "k": "move", "at": 0, "next": 2 },
