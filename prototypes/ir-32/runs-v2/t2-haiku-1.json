          { "k": "call", "at": 1, "to": "loadCart", "next": 2 },
          { "k": "effect", "at": 0, "kind": "db.get", "desc": "fetch the cart row", "next": 1, "result": { "id": "c-2", "items": [{ "price": 1500 }, { "price": 3000 }] } },
          { "k": "move", "at": 1, "next": 2 },
