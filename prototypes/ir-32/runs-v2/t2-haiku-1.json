    {
      "name": "the card declines",
      "blurb": "The charge fails, checkout catches the CardDeclined error, sends a notification mail, and returns the decline message.",
      "input": { "cartId": "c-2" },
      "walk": {
        "provenance": "authored",
        "steps": [
