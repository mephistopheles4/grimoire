          { "k": "move", "at": 1, "next": 2 },
          { "k": "return", "at": 2, "value": { "id": "c-1", "items": [{ "price": 2250 }, { "price": 2250 }] } },
          { "k": "move", "at": 2, "next": 3 },
          { "k": "call", "at": 3, "to": "priceCart", "next": 4 },
          { "k": "move", "at": 0, "next": 1 },
          { "k": "move", "at": 1, "next": 2 },
          { "k": "move", "at": 2, "next": 3 },
          { "k": "move", "at": 3, "next": 4 },
          { "k": "move", "at": 4, "next": 5 },
          { "k": "move", "at": 5, "next": 2 },
